<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        xmlns:core="using:PKHeX.Core"
        x:Class="PKHeX.Mac.Views.AddPokemonWindow"
        x:DataType="vm:AddPokemonViewModel"
        Title="Add Pokémon from Encounter Database"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackdropBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Text="Species" FontSize="11" Opacity="0.55"/>
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SpeciesChoices}"
                      SelectedValue="{Binding SpeciesValue, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                      DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
            <CheckBox IsChecked="{Binding MakeShiny, Mode=TwoWay}" Content="Make Shiny ★ (if possible)"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClicked"/>
                <Button Content="Generate" Command="{Binding GenerateCommand}"/>
                <Button Content="Add to Box" Classes="accent" Click="OnAddClicked"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,4">
            <TextBlock Text="Legal encounters" FontSize="11" Opacity="0.55"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding EncounterDescriptions}"
                 SelectedIndex="{Binding SelectedEncounterIndex, Mode=TwoWay}"/>
    </DockPanel>
</Window>
