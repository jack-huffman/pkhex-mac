<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        x:Class="PKHeX.Mac.Views.GiftsWindow"
        x:DataType="vm:GiftsViewModel"
        Title="Mystery Gift Database"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackdropBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Search" FontSize="11" Opacity="0.55"/>
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Filter by species or event name…"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClicked"/>
                <Button Content="Add to Box" Classes="accent" Click="OnAddClicked"/>
            </StackPanel>
        </StackPanel>

        <ListBox Margin="0,10,0,0" ItemsSource="{Binding GiftTitles}"
                 SelectedIndex="{Binding SelectedGiftIndex, Mode=TwoWay}"/>
    </DockPanel>
</Window>
