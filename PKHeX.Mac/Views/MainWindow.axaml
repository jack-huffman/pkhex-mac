<Window x:Name="RootWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        xmlns:core="using:PKHeX.Core"
        xmlns:ctrl="using:PKHeX.Mac.Controls"
        xmlns:panels="using:PKHeX.Mac.Views.Panels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PKHeX.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Title="{Binding WindowTitle}"
        Width="1360" Height="860"
        MinWidth="1120" MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="46"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent, None"
        Background="Transparent"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="Go to…" Gesture="Cmd+K" Click="OnPaletteOpenClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Open Save File…" Gesture="Cmd+O" Click="OnOpenClicked"/>
                    <NativeMenuItem Header="Open Recent">
                        <NativeMenu/>
                    </NativeMenuItem>
                    <NativeMenuItem Header="Export Save As…" Gesture="Cmd+S" Click="OnExportClicked"/>
                    <NativeMenuItem Header="Close Save" Gesture="Cmd+W" Click="OnCloseTabClicked"/>
                    <NativeMenuItem Header="Revert to Saved File…" Click="OnRevertAllMenuClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Import Showdown Set from Clipboard" Gesture="Cmd+Shift+I" Click="OnShowdownImportClicked"/>
                    <NativeMenuItem Header="Copy Showdown Set to Clipboard" Gesture="Cmd+Shift+E" Click="OnShowdownExportClicked"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Trainer">
                <NativeMenu>
                    <NativeMenuItem Header="Trainer Info…" Gesture="Cmd+T" Click="OnTrainerClicked"/>
                    <NativeMenuItem Header="Bag / Items…" Gesture="Cmd+B" Click="OnBagClicked"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Tools">
                <NativeMenu>
                    <NativeMenuItem Header="Add Pokémon from Database…" Gesture="Cmd+D" Click="OnAddPokemonClicked"/>
                    <NativeMenuItem Header="Mystery Gift Database…" Gesture="Cmd+G" Click="OnGiftsClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Export Box to Folder…" Click="OnDumpBoxClicked"/>
                    <NativeMenuItem Header="Import Folder into Box…" Click="OnLoadFolderClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Sort Current Box by Species" Click="OnSortBoxClicked"/>
                    <NativeMenuItem Header="Clear Current Box…" Click="OnClearBoxClicked"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="Cmd+OemOpenBrackets" Command="{Binding PreviousBoxCommand}"/>
        <KeyBinding Gesture="Cmd+OemCloseBrackets" Command="{Binding NextBoxCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <!-- Type-matrix column width. The header, cells and totals are separate
             strips with no shared layout, so they must all use this. -->
        <x:Double x:Key="MatrixCellWidth">40</x:Double>
        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:SlotViewModel">
            <Border Classes="slot" Classes.selected="{Binding IsSelected}"
                    Classes.dragover="{Binding IsDragOver}"
                    Width="94" Height="82"
                    PointerPressed="OnSlotPressed"
                    PointerMoved="OnSlotPointerMoved"
                    PointerReleased="OnSlotPointerReleased"
                    DragDrop.AllowDrop="True"
                    ToolTip.Tip="{Binding ToolTipText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="OnSlotCopyClicked"/>
                        <MenuItem Header="Paste" Click="OnSlotPasteClicked"/>
                        <MenuItem Header="Delete" Click="OnSlotDeleteClicked"/>
                        <MenuItem Header="Revert to Saved" Click="OnSlotRevertClicked"/>
                        <Separator/>
                        <MenuItem Header="Import from File…" Click="OnSlotImportClicked"/>
                        <MenuItem Header="Export to File…" Click="OnSlotExportClicked"/>
                        <Separator/>
                        <MenuItem Header="Copy Showdown Set" Click="OnSlotShowdownClicked"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Panel>
                    <!-- 68x56 is the native size of the pixel art, so it draws 1:1. -->
                    <Image Source="{Binding Sprite}" Width="68" Height="56" Margin="0,2,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <Image Source="{Binding ShinyOverlay}" Width="20" Height="20" Margin="13,4,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0.8"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <Image Source="{Binding BallSprite}" Width="18" Height="18"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                    <TextBlock Text="{Binding LevelText}" FontSize="{StaticResource FontMicro}" Classes="secondary"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5"/>
                </Panel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Frosted backdrop -->
    <Panel Background="{DynamicResource WindowBackdropBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
                <!-- Collapses to 0 for the full-width views -->
                <ColumnDefinition Width="{Binding InspectorWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ SIDEBAR (full height, translucent) ═══════════ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Keeps content clear of the traffic lights. Dragging is handled
                         window-wide, so this needs no handler of its own. -->
                    <Border DockPanel.Dock="Top" Height="46" Background="Transparent"/>

                    <StackPanel DockPanel.Dock="Top" Margin="14,2,14,10" Spacing="12">
                        <!-- Trainer profile card -->
                        <Border Classes="card" Padding="14,12" IsVisible="{Binding HasSave}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding TrainerName}" FontSize="{StaticResource FontTitle}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GameName}" FontSize="{StaticResource FontBody}" Classes="secondary"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding GenerationText}" FontSize="{StaticResource FontMicro}" Classes="secondary"/>
                                    </Border>
                                    <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding PlayTime}" FontSize="{StaticResource FontMicro}" Classes="secondary"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding TrainerIds}" FontSize="{StaticResource FontMicro}" Classes="secondary" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Unsaved-changes state. Always visible while dirty, so the
                             reminder lives here instead of in every status message. -->
                        <Border Classes="card" Padding="12,10"
                                IsVisible="{Binding SaveState.HasUnsavedChanges}"
                                Background="{DynamicResource IllegalBgBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding SaveState.CountText}"
                                           FontSize="{StaticResource FontBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource IllegalFgBrush}"/>
                                <TextBlock Text="{Binding SaveState.LastChange}"
                                           FontSize="{StaticResource FontMicro}" Classes="secondary"
                                           TextWrapping="Wrap"/>
                                <!-- Wraps, because four buttons do not fit the sidebar's
                                     fixed width on one line and a StackPanel would spill
                                     them over the card edge. -->
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                    <Button Content="Export…" Classes="accent"
                                            FontSize="{StaticResource FontMicro}" Padding="8,3"
                                            Click="OnExportButtonClicked"/>
                                    <Button Content="Review" FontSize="{StaticResource FontMicro}" Padding="8,3"
                                            Command="{Binding Review.OpenCommand}"/>
                                    <Button Content="History" FontSize="{StaticResource FontMicro}" Padding="8,3"
                                            Command="{Binding SaveState.ToggleLogCommand}"/>
                                    <Button Content="Revert All" FontSize="{StaticResource FontMicro}" Padding="8,3"
                                            ToolTip.Tip="Throw away every edit and reload the file from disk"
                                            Command="{Binding RequestRevertCommand}"/>
                                </WrapPanel>

                                <!-- Session log: what changed, newest first -->
                                <Border IsVisible="{Binding SaveState.IsLogOpen}" CornerRadius="6"
                                        Padding="8,6" Background="{DynamicResource SurfaceMutedBrush}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding SaveState.Log}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChangeLogEntry">
                                                    <Grid ColumnDefinitions="52,*" ColumnSpacing="6" Margin="0,0,0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                                                   FontSize="{StaticResource FontMicro}"
                                                                   Classes="secondary"
                                                                   FontFamily="{StaticResource MonoFont}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                                   FontSize="{StaticResource FontMicro}"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Navigation -->
                        <StackPanel Spacing="2" IsVisible="{Binding HasSave}">
                            <TextBlock Classes="sectionTitle" Text="SAVE" Margin="6,4,0,4"/>
                            <Button Classes="nav" Classes.selected="{Binding IsSearchView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="search"
                                    Content="Search"/>
                            <Button Classes="nav" Classes.selected="{Binding IsSaveView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="save"
                                    Content="Trainer &amp; Bag"/>
                            <Button Classes="nav" Classes.selected="{Binding IsDexView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="dex"
                                    Content="Pokédex"/>
                            <Button Classes="nav" Classes.selected="{Binding IsRaidsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="raids"
                                    Content="Raids"/>
                            <Button Classes="nav" Classes.selected="{Binding IsGameDataView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="gamedata"
                                    Content="Game Data"/>
                            <Button Classes="nav" Classes.selected="{Binding IsToolsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="tools"
                                    Content="Tools"/>
                            <Button Classes="nav" Classes.selected="{Binding IsFlagsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="flags"
                                    Content="Raw Save Blocks"/>

                        </StackPanel>

                        <TextBlock Classes="sectionTitle" Text="BOXES" IsVisible="{Binding HasSave}" Margin="6,6,0,0"/>
                    </StackPanel>

                    <!-- Box list. Tapped (not SelectionChanged) drives the view switch so
                         clicking the already-selected box still returns to the grid. -->
                    <ListBox Margin="10,0,10,10"
                             Opacity="{Binding BoxListOpacity}"
                             ItemsSource="{Binding BoxNames}"
                             SelectedIndex="{Binding CurrentBox, Mode=TwoWay}"
                             Tapped="OnBoxListTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Drop a dragged Pokémon here to move it to this box -->
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" Background="Transparent"
                                           PointerEntered="OnBoxNamePointerEntered"
                                           PointerExited="OnBoxNamePointerExited"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══════════ MAIN AREA ═══════════ -->
            <DockPanel Grid.Column="1">


                <!-- Update banner -->
                <Border DockPanel.Dock="Top" Margin="18,0,18,10" Padding="14,8" CornerRadius="10"
                        IsVisible="{Binding ShowUpdateBanner}"
                        Background="{DynamicResource BannerBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" FontSize="{StaticResource FontBody}"
                                Background="Transparent" Foreground="White"
                                Command="{Binding DismissUpdateBannerCommand}"/>
                        <TextBlock Text="{Binding UpdateBannerText}" FontSize="{StaticResource FontBody}" Foreground="White"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Open saves. Hidden until there is more than one, so nothing
                     changes for the usual case of editing a single file. -->
                <Border DockPanel.Dock="Top" Classes="tabstrip"
                        IsVisible="{Binding #RootWindow.Workspace.ShowTabStrip}">
                    <ItemsControl ItemsSource="{Binding #RootWindow.Workspace.Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- No gaps: tabs meet, as they do in a browser. -->
                                <StackPanel Orientation="Horizontal" Spacing="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SaveTabViewModel">
                                <Border Classes="tab" Classes.selected="{Binding IsActive}"
                                        PointerPressed="OnTabClicked">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Classes="tabtitle" Text="{Binding Title}"
                                                           FontSize="{StaticResource FontBody}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="•" IsVisible="{Binding IsDirty}"
                                                           FontSize="{StaticResource FontBody}"
                                                           Foreground="{DynamicResource IllegalFgBrush}"
                                                           ToolTip.Tip="Unsaved changes"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="{StaticResource FontMicro}"
                                                       Classes="secondary"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="tabclose" Content="✕"
                                                FontSize="{StaticResource FontMicro}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Close this save"
                                                Command="{Binding CloseCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Status line: quiet, out of the way, but edits still report here -->
                <Border DockPanel.Dock="Bottom" Padding="18,5" Background="Transparent">
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontBody}" Classes="secondary"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Grid>
                    <!-- ══════ CENTER: switched by sidebar navigation ══════ -->
                    <Panel>

                    <!-- Boxes view -->
                    <ScrollViewer x:Name="BoxesView" IsVisible="{Binding ShowBoxes}" Padding="18,14,10,14"
                                  SizeChanged="OnBoxesViewSizeChanged">
                        <StackPanel>
                            <!-- Empty state -->
                            <StackPanel IsVisible="{Binding !HasSave}" HorizontalAlignment="Center"
                                        Spacing="12" Margin="0,170,0,0">
                                <ctrl:PokeBallIcon Width="58" Height="58" HorizontalAlignment="Center"
                                                   IconBrush="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="PKHeX for Mac" FontSize="{StaticResource FontHero}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open a decrypted save file (⌘O) or drop one anywhere in this window"
                                           FontSize="{StaticResource FontBody}" Classes="secondary" HorizontalAlignment="Center"/>
                                <Button Content="Open Save File…" Classes="accent" HorizontalAlignment="Center"
                                        Margin="0,12,0,0" Click="OnOpenButtonClicked"/>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasSave}" Spacing="16">
                                <!-- Party -->
                                <!-- Party sits in a card with the same padding and a 6-column grid,
                                     so its slots line up with the box grid below. -->
                                <StackPanel IsVisible="{Binding HasParty}" Spacing="6">
                                    <TextBlock Classes="sectionTitle" Text="PARTY" Margin="4,0,0,0"/>
                                    <Border Classes="card" Padding="12">
                                        <ItemsControl ItemsSource="{Binding PartySlots}" HorizontalAlignment="Center"
                                                      ItemTemplate="{StaticResource SlotTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <!-- Box card -->
                                <Border Classes="card" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Grid.Column="0" Content="‹" FontSize="{StaticResource FontHeading}" Padding="10,2"
                                                    Command="{Binding PreviousBoxCommand}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentBoxName}"
                                                       FontSize="{StaticResource FontHeading}" FontWeight="SemiBold"
                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="›" FontSize="{StaticResource FontHeading}" Padding="10,2"
                                                    Command="{Binding NextBoxCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding BoxSlots}" HorizontalAlignment="Center"
                                                      ItemTemplate="{StaticResource SlotTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>


                                <!-- The ride legendary. Universal to Scarlet and Violet
                                     and kept in a box the game will not open, so it
                                     lives here rather than behind a tab. It behaves like
                                     any other slot: click it to edit in the inspector. -->
                                <StackPanel Spacing="6" IsVisible="{Binding HasRideSlot}">
                                    <TextBlock Classes="sectionTitle" Text="{Binding RideLabel}" Margin="4,0,0,0"/>
                                    <Border Classes="card" Padding="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding RideSlots}"
                                                          ItemTemplate="{StaticResource SlotTemplate}"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                       TextWrapping="Wrap"
                                                       Text="Your ride, stored in a box the game keeps hidden. Select it to edit it like any other Pokémon; its traversal abilities live under Trainer &amp; Bag → Ride."/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- What this box holds. All of it is otherwise only
                                     knowable by opening thirty slots one at a time. -->
                                <StackPanel Spacing="6" IsVisible="{Binding BoxInsights.IsVisible}">
                                    <TextBlock Classes="sectionTitle" Text="THIS BOX" Margin="4,0,0,0"/>
                                    <Border Classes="card" Padding="14"
                                            DataContext="{Binding BoxInsights}"
                                            x:DataType="vm:BoxInsightsViewModel">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{Binding FillText}"
                                                           FontSize="{StaticResource FontBody}" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding HasShiny}">
                                                    <TextBlock Text="✦" FontSize="{StaticResource FontBody}"
                                                               Foreground="{DynamicResource MeterEvBrush}"/>
                                                    <TextBlock Text="{Binding ShinyCount, StringFormat='{}{0} shiny'}"
                                                               FontSize="{StaticResource FontBody}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LevelText}"
                                                           FontSize="{StaticResource FontBody}" Classes="secondary"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding OriginText}"
                                                       FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Separator/>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Checking legality…"
                                                           FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                           IsVisible="{Binding IsChecking}"/>
                                                <TextBlock Text="{Binding Verdict}"
                                                           FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                           IsVisible="{Binding !IsChecking}"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Problems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BoxProblemViewModel">
                                                        <Button Classes="plain" Padding="6,4" Margin="0,0,0,2"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding SelectCommand}"
                                                                ToolTip.Tip="{Binding Issue}">
                                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                                <Image Grid.Column="0" Source="{Binding Sprite}"
                                                                       Width="34" Height="28"
                                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Species}"
                                                                           FontSize="{StaticResource FontBody}"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding SlotText}"
                                                                           FontSize="{StaticResource FontMicro}"
                                                                           Classes="secondary"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════ FLAGS & BLOCKS view ══════ -->
                    <!-- Event flags and the raw SCBlock save-structure editor.
                         See Views/Panels/FlagsPanel.axaml -->
                    <Panel IsVisible="{Binding IsFlagsView}">
                        <panels:FlagsPanel/>
                    </Panel>

                    <!-- ══════ SEARCH view: this save, or a folder of Pokémon files ══════ -->
                    <!-- Multi-criteria search over save storage or a folder.
                         See Views/Panels/SearchPanel.axaml -->
                    <Panel IsVisible="{Binding IsSearchView}">
                        <panels:SearchPanel/>
                    </Panel>

                    <!-- ══════ TERA RAIDS view ══════ -->
                    <!-- Raids: see Views/Panels/RaidsPanel.axaml -->
                    <Panel IsVisible="{Binding IsRaidsView}">
                        <panels:RaidsPanel/>
                    </Panel>

                    <!-- ══════ GAME DATA view: daycare, gift album, per-generation structures ══════ -->
                    <!-- Daycare, gift album, Hall of Fame, mail and per-generation structures. See Views/Panels/GameDataPanel.axaml -->
                    <Panel IsVisible="{Binding IsGameDataView}">
                        <panels:GameDataPanel/>
                    </Panel>

                    <!-- ══════ TOOLS view: batch editor + box report ══════ -->
                    <!-- Batch edit, team analysis, breeding, integrity audit and box report.
                         See Views/Panels/ToolsPanel.axaml -->
                    <Panel IsVisible="{Binding IsToolsView}">
                        <panels:ToolsPanel/>
                    </Panel>

                    <!-- ══════ POKÉDEX view ══════ -->
                    <!-- Pokedex seen and caught editing. See Views/Panels/PokedexPanel.axaml -->
                    <Panel IsVisible="{Binding IsDexView}">
                        <panels:PokedexPanel/>
                    </Panel>

                    <!-- ══════ SAVE view: trainer identity + bag, side by side ══════ -->
                    <!-- Trainer identity, bag, appearance, badges and records.
                         See Views/Panels/TrainerPanel.axaml -->
                    <Panel IsVisible="{Binding IsSaveView}">
                        <panels:TrainerPanel/>
                    </Panel>

                    </Panel>

                </Grid>
            </DockPanel>

                    <!-- ══════ INSPECTOR — styled to match the sidebar ══════ -->
                    <Border Grid.Column="2" Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                    <!-- Breathing room at the top of the inspector column. -->
                    <Border DockPanel.Dock="Top" Height="18" Background="Transparent"/>
                    <Panel Margin="14,8,14,14">
                        <!-- Database mode: browser on top, live preview + add below -->
                        <Grid RowDefinitions="*,Auto" RowSpacing="8" IsVisible="{Binding IsDatabaseView}">
                            <Panel Grid.Row="0">
                    <!-- ══════ Add Pokémon view ══════ -->
                    <Border IsVisible="{Binding IsAddView}">
                        <DockPanel DataContext="{Binding AddDb}" x:DataType="vm:AddPokemonViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2"
                                        FontSize="{StaticResource FontBody}"
                                        Background="Transparent"
                                        ToolTip.Tip="Close the encounter database"
                                        Click="OnCloseDatabaseClicked"/>
                                <TextBlock Text="Add Pokémon from Encounter Database"
                                           FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="fieldLabel" Text="Species"/>
                                    <!-- Type-ahead beats scrolling 1000+ entries -->
                                    <AutoCompleteBox HorizontalAlignment="Stretch"
                                                     ItemsSource="{Binding SpeciesOptions}"
                                                     SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
                                                     FilterMode="Contains"
                                                     MinimumPrefixLength="1"
                                                     MaxDropDownHeight="320"
                                                     PlaceholderText="Start typing a species name…">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SpeciesChoice">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Source="{Binding Sprite}" Width="34" Height="28"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontBody}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding MakeShiny, Mode=TwoWay}" Content="Make Shiny ★ (if possible)"/>
                                <TextBlock Classes="fieldLabel" Text="Legal encounters — pick one to preview"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="{StaticResource FontBody}"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <ListBox Margin="0,4,0,0" ItemsSource="{Binding EncounterDescriptions}"
                                     SelectedIndex="{Binding SelectedEncounterIndex, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <!-- ══════ Mystery Gifts view: sprite tile grid ══════ -->
                    <Border IsVisible="{Binding IsGiftsView}">
                        <DockPanel DataContext="{Binding GiftDb}" x:DataType="vm:GiftsViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Mystery Gift Database"
                                           FontSize="{StaticResource FontTitle}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2"
                                        FontSize="{StaticResource FontBody}"
                                        Background="Transparent" Margin="8,0,0,0"
                                        ToolTip.Tip="Close the gift database"
                                        Click="OnCloseDatabaseClicked"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" FontSize="{StaticResource FontBody}"
                                           Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Filters -->
                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                         PlaceholderText="Search species, event, or game…"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" FontSize="{StaticResource FontBody}"
                                              ItemsSource="{Binding GenerationChoices}"
                                              SelectedIndex="{Binding SelectedGenerationIndex, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="{StaticResource FontBody}"
                                              ItemsSource="{Binding GameChoices}"
                                              SelectedIndex="{Binding SelectedGameIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding ShinyOnly, Mode=TwoWay}"
                                              Content="Shiny only" FontSize="{StaticResource FontBody}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EggsOnly, Mode=TwoWay}"
                                              Content="Eggs only" FontSize="{StaticResource FontBody}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding AddableOnly, Mode=TwoWay}" FontSize="{StaticResource FontBody}"
                                              Content="Only gifts this save accepts"/>
                                    <Button Grid.Column="1" Content="Clear" FontSize="{StaticResource FontBody}" Padding="10,3"
                                            Command="{Binding ClearFiltersCommand}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="{StaticResource FontBody}"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button DockPanel.Dock="Bottom" Content="{Binding LoadMoreLabel}"
                                    IsVisible="{Binding HasMore}" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding LoadNextPageCommand}"/>

                            <ListBox Classes="plain" ItemsSource="{Binding Tiles}"
                                     SelectedItem="{Binding SelectedTile, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GiftTileViewModel">
                                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10"
                                              Opacity="{Binding TileOpacity}" Margin="0,3"
                                              ToolTip.Tip="{Binding ToolTipText}">
                                            <Panel Grid.Column="0" Width="42" Height="36">
                                                <Image Source="{Binding Sprite}" Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                <Image Source="{Binding ShinyOverlay}" Width="14" Height="14"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Opacity="0.85"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding SpeciesName}"
                                                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding LevelText}"
                                                               FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CardTitle}"
                                                           FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}"
                                                           FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                           TextAlignment="Right"/>
                                                <TextBlock Text="{Binding OriginText}"
                                                           FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                           TextAlignment="Right" Opacity="0.75"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>


                            </Panel>

                        <!-- Preview of the selected database entry, before it is added -->
                        <Border Grid.Row="1" Classes="card" Padding="16">
                            <StackPanel DataContext="{Binding Preview}" x:DataType="vm:PokemonPreviewViewModel"
                                        Spacing="12">
                                <TextBlock Text="Select an entry to preview it here" FontSize="{StaticResource FontBody}" Classes="secondary"
                                           HorizontalAlignment="Center" IsVisible="{Binding !HasPokemon}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>

                                <!-- Blocked: explain why nothing can be added -->
                                <Border CornerRadius="8" Padding="10,8" IsVisible="{Binding IsBlocked}"
                                        Background="{DynamicResource IllegalBgBrush}">
                                    <TextBlock Text="{Binding BlockedReason}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource IllegalFgBrush}"/>
                                </Border>

                                <StackPanel IsVisible="{Binding HasPokemon}" Spacing="12">

                                    <!-- Identity: artwork, name, types, legality, held item -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Image Grid.Column="0" Source="{Binding Artwork}" Width="96" Height="96"
                                               VerticalAlignment="Top"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{Binding BallSprite}" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SpeciesName}" FontSize="{StaticResource FontHeading}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LevelBadge}" FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                           VerticalAlignment="Center"/>
                                                <Image Source="{Binding ShinyIcon}" Width="17" Height="17"
                                                       IsVisible="{Binding IsShiny}" VerticalAlignment="Center"
                                                       ToolTip.Tip="Shiny"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{Binding Type1Icon}" Width="22" Height="22"
                                                       IsVisible="{Binding HasType1Icon}" ToolTip.Tip="{Binding Type1Name}"/>
                                                <Border Classes="chip" Padding="7,2" Background="{Binding Type1Brush}"
                                                        IsVisible="{Binding !HasType1Icon}">
                                                    <TextBlock Text="{Binding Type1Name}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <Image Source="{Binding Type2Icon}" Width="22" Height="22"
                                                       IsVisible="{Binding HasType2Icon}" ToolTip.Tip="{Binding Type2Name}"/>
                                                <Border Classes="chip" Padding="7,2" Background="{DynamicResource LegalBgBrush}"
                                                        IsVisible="{Binding IsLegal}" VerticalAlignment="Center">
                                                    <TextBlock Text="✓ Legal" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource LegalFgBrush}"/>
                                                </Border>
                                                <Border Classes="chip" Padding="7,2" Background="{DynamicResource IllegalBgBrush}"
                                                        IsVisible="{Binding !IsLegal}" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding LegalityReport}">
                                                    <TextBlock Text="✕ Issues" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource IllegalFgBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding NatureText, StringFormat='{}{0} nature'}"
                                                           FontSize="{StaticResource FontBody}" Classes="secondary"/>
                                                <TextBlock Text="{Binding AbilityText}" FontSize="{StaticResource FontBody}" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ItemText}" FontSize="{StaticResource FontBody}" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OriginText}" FontSize="{StaticResource FontBody}" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Moves beside stats, same visual language as the inspector tabs -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="MOVES" FontSize="{StaticResource FontMicro}" FontWeight="Bold" Classes="secondary"/>
                                            <ItemsControl ItemsSource="{Binding Moves}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MoveChoice">
                                                        <Grid ColumnDefinitions="20,20,*" ColumnSpacing="6" Margin="0,0,0,5">
                                                            <Image Grid.Column="0" Source="{Binding TypeIcon}" Width="18" Height="18"
                                                                   IsVisible="{Binding HasTypeIcon}" VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding TypeName}"/>
                                                            <ctrl:MoveCategoryIcon Grid.Column="1" Category="{Binding CategoryKind}"
                                                                                   Width="18" Height="18"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontBody}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding StatLine}" FontSize="{StaticResource FontMicro}" Classes="secondary"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No moves set" FontSize="{StaticResource FontBody}" Classes="secondary"
                                                       IsVisible="{Binding !HasMoves}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="STATS" FontSize="{StaticResource FontMicro}" FontWeight="Bold" Classes="secondary"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatTotal, StringFormat='TOT {0}'}"
                                                           FontSize="{StaticResource FontMicro}" FontWeight="Bold" Classes="secondary"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Stats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewStatRow">
                                                        <!-- Value sits after the bar so a wide bar can never paint over it. -->
                                                        <Grid ColumnDefinitions="44,*,32" ColumnSpacing="6" Margin="0,0,0,5">
                                                            <Grid Grid.Column="0" ColumnDefinitions="32,*" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{StaticResource FontMicro}"
                                                                           FontWeight="Bold" Foreground="{Binding LabelBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding NatureBadge}" FontSize="{StaticResource FontMicro}"
                                                                           IsVisible="{Binding HasNatureBadge}"
                                                                           Foreground="{Binding LabelBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <ProgressBar Grid.Column="1" Classes="statbar"
                                                                         Value="{Binding BarPercent}"
                                                                         Foreground="{Binding BarBrush}"
                                                                         VerticalAlignment="Center"
                                                                         ToolTip.Tip="{Binding Tooltip}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="{StaticResource FontBody}"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextAlignment="Right" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TargetSlotText}"
                                        Classes="accent" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding HasPokemon}"
                                        Click="OnAddPreviewClicked"/>
                            </StackPanel>
                        </Border>

                        </Grid>

                        <Border IsVisible="{Binding IsBoxesView}">
                            <StackPanel VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !Detail.HasPokemon}">
                                <ctrl:PokeBallIcon Width="42" Height="42" HorizontalAlignment="Center"
                                           IconBrush="{DynamicResource TextSecondaryBrush}"/>

                                <!-- Nothing selected -->
                                <TextBlock Text="Select a Pokémon" FontSize="{StaticResource FontBody}" Classes="secondary"
                                           HorizontalAlignment="Center" IsVisible="{Binding !CanUseDatabases}"/>

                                <!-- An empty slot is selected: offer to fill it -->
                                <StackPanel Spacing="12" IsVisible="{Binding CanUseDatabases}">
                                    <TextBlock Text="{Binding TargetSlotText}" FontSize="{StaticResource FontHeading}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="This slot is empty — fill it from a database, or drop a .pk file onto it."
                                               FontSize="{StaticResource FontBody}" Classes="secondary" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Content="Add Pokémon from Database" Classes="accent"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetViewCommand}" CommandParameter="add"/>
                                    <Button Content="Mystery Gift Database"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetViewCommand}" CommandParameter="gifts"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Panel IsVisible="{Binding IsBoxesView}">
                        <!-- The Pokémon inspector. See Views/Panels/InspectorPanel.axaml -->
                        <panels:InspectorPanel DataContext="{Binding Detail}"/>
                        </Panel>
                    </Panel>
                    </DockPanel>

                    </Border>
        </Grid>

            <!-- ══════ Revert confirmation ══════ -->
            <Border IsVisible="{Binding IsRevertPromptOpen}" Background="{DynamicResource ScrimBrush}">
                <Border Classes="card" Width="440" Padding="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Start over from the saved file?"
                                   FontSize="{StaticResource FontHeading}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RevertSummary}"
                                   FontSize="{StaticResource FontBody}"
                                   Foreground="{DynamicResource IllegalFgBrush}"/>
                        <TextBlock FontSize="{StaticResource FontBody}" Classes="secondary"
                                   TextWrapping="Wrap"
                                   Text="The file on disk is re-read as it stands. Nothing is written, so the file itself cannot be harmed by this — but edits made since opening it are gone."/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelRevertCommand}"/>
                            <Button Content="Revert" Classes="accent" Command="{Binding RevertCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ══════ Review before export ══════ -->
            <Border IsVisible="{Binding Review.IsOpen}" Background="{DynamicResource ScrimBrush}">
                <Border Classes="card" Width="620" MaxHeight="560" Padding="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel DataContext="{Binding Review}" x:DataType="vm:ExportReviewViewModel">
                        <TextBlock DockPanel.Dock="Top" Text="About to write"
                                   FontSize="{StaticResource FontHeading}" FontWeight="Bold"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="0,6,0,0"
                                   FontSize="{StaticResource FontBody}" Classes="secondary"
                                   TextWrapping="Wrap"/>
                        <TextBlock DockPanel.Dock="Top" Text="Comparing with the file on disk…"
                                   Margin="0,8,0,0" IsVisible="{Binding IsBusy}"
                                   FontSize="{StaticResource FontBody}" Classes="secondary"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Cancel" Command="{Binding CloseCommand}"/>
                            <Button Content="Export…" Classes="accent"
                                    IsEnabled="{Binding HasChanges}"
                                    Command="{Binding ExportCommand}"/>
                        </StackPanel>

                        <ScrollViewer Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChangeGroupViewModel">
                                        <StackPanel Spacing="4" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0"/>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChangeRowViewModel">
                                                        <Grid ColumnDefinitions="Auto,190,*" ColumnSpacing="8"
                                                              Margin="0,0,0,3">
                                                            <Image Grid.Column="0" Source="{Binding Sprite}"
                                                                   Width="30" Height="26"
                                                                   IsVisible="{Binding HasSprite}"
                                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Where}"
                                                                       FontSize="{StaticResource FontBody}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                                       FontSize="{StaticResource FontBody}"
                                                                       Classes="secondary"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ══════ Command palette ══════ -->
            <Border IsVisible="{Binding Palette.IsOpen}" Background="{DynamicResource ScrimBrush}">
                <Border Classes="card" Width="560" Padding="0" Margin="0,90,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <DockPanel DataContext="{Binding Palette}" x:DataType="vm:CommandPaletteViewModel">
                        <TextBox DockPanel.Dock="Top" x:Name="PaletteBox" Margin="14,14,14,10"
                                 Text="{Binding Query, Mode=TwoWay}"
                                 FontSize="{StaticResource FontHeading}"
                                 PlaceholderText="Go to…  try a pane, an action, or a box"/>
                        <TextBlock DockPanel.Dock="Bottom" Margin="14,8,14,12"
                                   FontSize="{StaticResource FontMicro}" Classes="secondary"
                                   Text="↑ ↓ to move · return to go · esc to close"/>
                        <ListBox Classes="plain" MaxHeight="360" Margin="6,0,6,0"
                                 ItemsSource="{Binding Results}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 DoubleTapped="OnPaletteActivate">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteEntry">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                   FontSize="{StaticResource FontBody}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Group}"
                                                   FontSize="{StaticResource FontMicro}"
                                                   Classes="secondary"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ══════ Close confirmation ══════ -->
            <Border IsVisible="{Binding IsClosePromptOpen}" Background="{DynamicResource ScrimBrush}">
                <Border Classes="card" Width="440" Padding="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Export before closing?"
                                   FontSize="{StaticResource FontHeading}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SaveState.CountText}"
                                   FontSize="{StaticResource FontBody}"
                                   Foreground="{DynamicResource IllegalFgBrush}"/>
                        <TextBlock FontSize="{StaticResource FontBody}" Classes="secondary"
                                   TextWrapping="Wrap"
                                   Text="Edits are made to a copy of the save in memory. Closing now discards them — the file on disk is untouched."/>
                        <TextBlock Text="{Binding ClosePromptNote}"
                                   IsVisible="{Binding HasUnappliedDetail}"
                                   FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource IllegalFgBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelCloseCommand}"/>
                            <Button Content="Discard and Close" Click="OnCloseDiscardClicked"/>
                            <Button Content="Export…" Classes="accent" Click="OnCloseExportClicked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

        <!-- Drag ghost: follows the pointer while moving a Pokémon between slots -->
        <Canvas IsHitTestVisible="False">
            <Image x:Name="DragGhost" Width="68" Height="56" Opacity="0.85" IsVisible="False"
                   RenderOptions.BitmapInterpolationMode="None"/>
        </Canvas>
    </Panel>
</Window>
