<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        xmlns:core="using:PKHeX.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PKHeX.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1360" Height="860"
        MinWidth="1120" MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="46"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent, None"
        Background="Transparent"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="Open Save File…" Gesture="Cmd+O" Click="OnOpenClicked"/>
                    <NativeMenuItem Header="Export Save As…" Gesture="Cmd+S" Click="OnExportClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Import Showdown Set from Clipboard" Gesture="Cmd+Shift+I" Click="OnShowdownImportClicked"/>
                    <NativeMenuItem Header="Copy Showdown Set to Clipboard" Gesture="Cmd+Shift+E" Click="OnShowdownExportClicked"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Trainer">
                <NativeMenu>
                    <NativeMenuItem Header="Trainer Info…" Gesture="Cmd+T" Click="OnTrainerClicked"/>
                    <NativeMenuItem Header="Bag / Items…" Gesture="Cmd+B" Click="OnBagClicked"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Tools">
                <NativeMenu>
                    <NativeMenuItem Header="Add Pokémon from Database…" Gesture="Cmd+D" Click="OnAddPokemonClicked"/>
                    <NativeMenuItem Header="Mystery Gift Database…" Gesture="Cmd+G" Click="OnGiftsClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Export Box to Folder…" Click="OnDumpBoxClicked"/>
                    <NativeMenuItem Header="Import Folder into Box…" Click="OnLoadFolderClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Sort Current Box by Species" Click="OnSortBoxClicked"/>
                    <NativeMenuItem Header="Clear Current Box…" Click="OnClearBoxClicked"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="Cmd+OemOpenBrackets" Command="{Binding PreviousBoxCommand}"/>
        <KeyBinding Gesture="Cmd+OemCloseBrackets" Command="{Binding NextBoxCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:SlotViewModel">
            <Border Classes="slot" Classes.selected="{Binding IsSelected}"
                    Classes.dragover="{Binding IsDragOver}"
                    Classes.multi="{Binding IsMultiSelected}"
                    Width="94" Height="82"
                    PointerPressed="OnSlotPressed"
                    PointerMoved="OnSlotPointerMoved"
                    PointerReleased="OnSlotPointerReleased"
                    DragDrop.AllowDrop="True"
                    ToolTip.Tip="{Binding ToolTipText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="OnSlotCopyClicked"/>
                        <MenuItem Header="Paste" Click="OnSlotPasteClicked"/>
                        <MenuItem Header="Delete" Click="OnSlotDeleteClicked"/>
                        <Separator/>
                        <MenuItem Header="Import from File…" Click="OnSlotImportClicked"/>
                        <MenuItem Header="Export to File…" Click="OnSlotExportClicked"/>
                        <Separator/>
                        <MenuItem Header="Copy Showdown Set" Click="OnSlotShowdownClicked"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Panel>
                    <Image Source="{Binding Sprite}" Width="68" Height="56" Margin="0,2,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <Image Source="{Binding ShinyOverlay}" Width="20" Height="20" Margin="13,4,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0.8"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <Image Source="{Binding BallSprite}" Width="18" Height="18"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                    <TextBlock Text="{Binding LevelText}" FontSize="10" Classes="secondary"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5"/>
                </Panel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Frosted backdrop -->
    <Panel Background="{DynamicResource WindowBackdropBrush}">
        <Grid ColumnDefinitions="238,*">

            <!-- ═══════════ SIDEBAR (full height, translucent) ═══════════ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Traffic-light region / drag strip -->
                    <Border DockPanel.Dock="Top" Height="46" Background="Transparent"
                            PointerPressed="OnHeaderPressed"/>

                    <StackPanel DockPanel.Dock="Top" Margin="14,2,14,10" Spacing="10">
                        <!-- Trainer profile card -->
                        <Border Classes="card" Padding="14,12" IsVisible="{Binding HasSave}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding TrainerName}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GameName}" FontSize="12" Classes="secondary"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding GenerationText}" FontSize="10" Classes="secondary"/>
                                    </Border>
                                    <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding PlayTime}" FontSize="10" Classes="secondary"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding TrainerIds}" FontSize="10" Classes="secondary" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Navigation -->
                        <StackPanel Spacing="2" IsVisible="{Binding HasSave}">
                            <TextBlock Classes="sectionTitle" Text="SAVE" Margin="6,4,0,4"/>
                            <Button Classes="nav" Classes.selected="{Binding IsSaveView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="save"
                                    Content="👤  Trainer &amp; Bag"/>
                            <Button Classes="nav" Classes.selected="{Binding IsDexView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="dex"
                                    Content="📖  Pokédex"/>
                            <Button Classes="nav" Classes.selected="{Binding IsToolsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="tools"
                                    Content="🛠  Tools"/>
                            <Button Classes="nav" Classes.selected="{Binding IsFlagsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="flags"
                                    Content="🚩  Flags &amp; Blocks"/>

                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasSave}" Spacing="6">
                            <TextBlock Classes="sectionTitle" Text="FIND" Margin="6,4,0,0"/>
                            <TextBox Text="{Binding BoxSearchText, Mode=TwoWay}" FontSize="12"
                                     Watermark="Species, nickname, OT, shiny…"/>
                            <TextBlock Text="{Binding SearchSummary}" FontSize="10" Classes="secondary"
                                       Margin="4,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Classes="sectionTitle" Text="BOXES" IsVisible="{Binding HasSave}" Margin="6,6,0,0"/>
                    </StackPanel>

                    <!-- Search results replace the box list while searching -->
                    <ListBox DockPanel.Dock="Top" MaxHeight="260" Margin="10,0,10,10"
                             IsVisible="{Binding HasSearchResults}"
                             ItemsSource="{Binding SearchResults}"
                             SelectionChanged="OnSearchHitSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchHitViewModel">
                                <Grid ColumnDefinitions="40,*" ColumnSpacing="6">
                                    <Image Grid.Column="0" Source="{Binding Sprite}" Width="38" Height="32"
                                           RenderOptions.BitmapInterpolationMode="None"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Species}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Location}" FontSize="10" Classes="secondary"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Classes="secondary"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Box list. Tapped (not SelectionChanged) drives the view switch so
                         clicking the already-selected box still returns to the grid. -->
                    <ListBox Margin="10,0,10,10"
                             Opacity="{Binding BoxListOpacity}"
                             ItemsSource="{Binding BoxNames}"
                             SelectedIndex="{Binding CurrentBox, Mode=TwoWay}"
                             Tapped="OnBoxListTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Drop a dragged Pokémon here to move it to this box -->
                                <TextBlock Text="{Binding}" FontSize="13" Background="Transparent"
                                           PointerEntered="OnBoxNamePointerEntered"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══════════ MAIN AREA ═══════════ -->
            <DockPanel Grid.Column="1">

                <!-- Header / drag strip with toolbar -->
                <Border DockPanel.Dock="Top" Height="46" Background="Transparent"
                        PointerPressed="OnHeaderPressed">
                    <DockPanel Margin="18,0,14,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Open" FontSize="12" Padding="12,4" Click="OnOpenButtonClicked"/>
                            <Button Content="Export" FontSize="12" Padding="12,4" Click="OnExportButtonClicked"
                                    IsEnabled="{Binding HasSave}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="PKHeX" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Classes="secondary"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Update banner -->
                <Border DockPanel.Dock="Top" Margin="18,0,18,10" Padding="14,8" CornerRadius="10"
                        IsVisible="{Binding ShowUpdateBanner}"
                        Background="{DynamicResource BannerBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" FontSize="12"
                                Background="Transparent" Foreground="White"
                                Command="{Binding DismissUpdateBannerCommand}"/>
                        <TextBlock Text="{Binding UpdateBannerText}" FontSize="12" Foreground="White"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding InspectorWidth}"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══════ CENTER: switched by sidebar navigation ══════ -->
                    <Panel Grid.Column="0">

                    <!-- Boxes view -->
                    <ScrollViewer IsVisible="{Binding ShowBoxes}" Padding="18,0,10,14">
                        <StackPanel>
                            <!-- Empty state -->
                            <StackPanel IsVisible="{Binding !HasSave}" HorizontalAlignment="Center"
                                        Spacing="10" Margin="0,170,0,0">
                                <TextBlock Text="◓" FontSize="52" HorizontalAlignment="Center" Opacity="0.35"/>
                                <TextBlock Text="PKHeX for Mac" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open a decrypted save file (⌘O) or drop one anywhere in this window"
                                           FontSize="13" Classes="secondary" HorizontalAlignment="Center"/>
                                <Button Content="Open Save File…" Classes="accent" HorizontalAlignment="Center"
                                        Margin="0,12,0,0" Click="OnOpenButtonClicked"/>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasSave}" Spacing="14">
                                <!-- Party -->
                                <!-- Party sits in a card with the same padding and a 6-column grid,
                                     so its slots line up with the box grid below. -->
                                <StackPanel IsVisible="{Binding HasParty}" Spacing="6">
                                    <TextBlock Classes="sectionTitle" Text="PARTY" Margin="4,0,0,0"/>
                                    <Border Classes="card" Padding="12">
                                        <ItemsControl ItemsSource="{Binding PartySlots}" HorizontalAlignment="Center"
                                                      ItemTemplate="{StaticResource SlotTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <!-- Multi-selection actions -->
                                <Border Classes="card" Padding="10" IsVisible="{Binding HasMultiSelection}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12">
                                            <Run Text="{Binding MultiSelectCount}"/><Run Text=" selected"/>
                                        </TextBlock>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Export selected…" FontSize="11" Padding="8,3"
                                                    Click="OnDumpSelectionClicked"/>
                                            <Button Content="Delete" FontSize="11" Padding="8,3"
                                                    Command="{Binding DeleteSelectedCommand}"/>
                                            <Button Content="Clear selection" FontSize="11" Padding="8,3"
                                                    Command="{Binding ClearMultiSelectionCommand}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Box card -->
                                <Border Classes="card" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Grid.Column="0" Content="‹" FontSize="15" Padding="10,2"
                                                    Command="{Binding PreviousBoxCommand}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentBoxName}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="›" FontSize="15" Padding="10,2"
                                                    Command="{Binding NextBoxCommand}"/>
                                            <Button Grid.Column="1" Content="Select all" FontSize="10" Padding="8,2"
                                                    HorizontalAlignment="Right"
                                                    ToolTip.Tip="Select every Pokémon in this box (⇧-click or ⌘-click slots to adjust)"
                                                    Command="{Binding SelectWholeBoxCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding BoxSlots}" HorizontalAlignment="Center"
                                                      ItemTemplate="{StaticResource SlotTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════ FLAGS & BLOCKS view ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsFlagsView}" Margin="18,0,18,14">
                        <TabControl Padding="0,10,0,0">

                            <!-- Gen 2-5 style flat event flag array -->
                            <TabItem Header="Event Flags">
                                <DockPanel DataContext="{Binding EventFlags}" x:DataType="vm:EventFlagsViewModel"
                                           Margin="2,8,2,2">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="12"
                                               Classes="secondary" Margin="0,0,0,10"/>

                                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                                            Padding="14" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding UnsupportedNote}" FontSize="13" TextWrapping="Wrap"
                                                   Classes="secondary"/>
                                    </Border>

                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                                          Margin="0,0,0,12" IsVisible="{Binding SupportsFlags}">
                                        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                                 Watermark="Search by flag number…"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SetOnly, Mode=TwoWay}"
                                                  Content="Set only" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Clear visible" FontSize="12"
                                                Command="{Binding ClearVisibleCommand}"/>
                                    </Grid>

                                    <ListBox Classes="plain" ItemsSource="{Binding Flags}"
                                             IsVisible="{Binding SupportsFlags}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EventFlagRowViewModel">
                                                <CheckBox Content="{Binding Label}" FontSize="11" Width="130"
                                                          IsChecked="{Binding Value, Mode=TwoWay}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>

                            <!-- Gen 8/9 SCBlock structure -->
                            <TabItem Header="Save Blocks">
                                <DockPanel DataContext="{Binding SaveBlocks}" x:DataType="vm:SaveBlocksViewModel"
                                           Margin="2,8,2,2">
                                    <Border DockPanel.Dock="Top" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                            Background="{DynamicResource IllegalBgBrush}"
                                            IsVisible="{Binding IsSupported}">
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource IllegalFgBrush}"
                                                   Text="Raw save data — nothing here is validated. These blocks replaced event flags in Gen 8/9; changing one can corrupt progress or trip anti-cheat. Your save is backed up automatically on export, but only edit blocks you understand."/>
                                    </Border>

                                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                                            Padding="14" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Classes="secondary"
                                                   Text="This save format does not use SCBlocks. Generations 8 and 9 (Sword/Shield, BDSP, Legends, Scarlet/Violet) do."/>
                                    </Border>

                                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10"
                                                IsVisible="{Binding IsSupported}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                                     Watermark="Search block name or hex key (e.g. KCurrentBox, WEVT_)…"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding NamedOnly, Mode=TwoWay}"
                                                      Content="Known names only" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding EditableOnly, Mode=TwoWay}"
                                                      Content="Editable only" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Reset" FontSize="12"
                                                    Command="{Binding ClearFiltersCommand}"/>
                                        </Grid>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontSize="11"
                                                       Classes="secondary"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CapNotice}" FontSize="11"
                                                       Classes="secondary" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <ListBox Classes="plain" ItemsSource="{Binding Rows}" IsVisible="{Binding IsSupported}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScBlockRowViewModel">
                                                <Grid ColumnDefinitions="*,86,72,150" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Error}" FontSize="10"
                                                                   Foreground="{DynamicResource IllegalFgBrush}"
                                                                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding KeyText}" FontSize="10"
                                                               FontFamily="Menlo, monospace" Classes="secondary"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center"/>

                                                    <CheckBox Grid.Column="3" Content="Set" FontSize="11"
                                                              IsVisible="{Binding IsBoolean}"
                                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
                                                    <TextBox Grid.Column="3" FontSize="11" Height="24" Padding="6,2"
                                                             IsVisible="{Binding IsScalar}"
                                                             Text="{Binding TextValue, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding OpaqueText}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsOpaque}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- ══════ TOOLS view: batch editor + box report ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsToolsView}" Margin="18,0,18,14">
                        <TabControl DataContext="{Binding Tools}" x:DataType="vm:ToolsViewModel" Padding="0,10,0,0">

                            <TabItem Header="Batch Edit">
                                <DockPanel Margin="2,8,2,2">
                                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                                        <TextBlock Text="Apply property changes to many Pokémon at once."
                                                   FontSize="13" Classes="secondary"/>
                                        <Grid ColumnDefinitions="200,Auto,*" ColumnSpacing="10">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ScopeChoices}"
                                                      SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}"/>
                                            <Button Grid.Column="1" Content="Run" Classes="accent"
                                                    Command="{Binding RunBatchCommand}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding BatchResult}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>

                                    <Grid ColumnDefinitions="*,320" ColumnSpacing="12" Margin="0,10,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding Instructions, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Menlo, monospace" FontSize="12"
                                                 VerticalContentAlignment="Top"
                                                 Watermark=".Nature=Adamant"/>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="12"
                                                Background="{DynamicResource SurfaceMutedBrush}">
                                            <TextBlock Text="{Binding BatchHelp}" FontSize="11"
                                                       FontFamily="Menlo, monospace" Classes="secondary"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Box Report">
                                <DockPanel Margin="2,8,2,2">
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                                          Margin="0,0,0,10">
                                        <TextBox Grid.Column="0" Text="{Binding ReportSearch, Mode=TwoWay}"
                                                 Watermark="Search species, nickname, OT, nature, ability…"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IllegalOnly, Mode=TwoWay}"
                                                  Content="Issues only" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Copy as TSV" FontSize="12"
                                                Click="OnCopyReportClicked"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReportSummary}" FontSize="12"
                                               Classes="secondary" Margin="0,8,0,0"/>

                                    <!-- Header row -->
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="44,110,120,120,46,90,140,120,64,58"
                                          ColumnSpacing="8" Margin="6,0,6,6">
                                        <TextBlock Grid.Column="1" Text="Species" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="2" Text="Nickname" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="3" Text="Box · slot" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="4" Text="Lv" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="5" Text="Nature" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="6" Text="Ability" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="7" Text="IVs" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="8" Text="Shiny" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="9" Text="Legal" FontSize="10" Classes="secondary"/>
                                    </Grid>

                                    <ListBox ItemsSource="{Binding ReportRows}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReportRowViewModel">
                                                <Grid ColumnDefinitions="44,110,120,120,46,90,140,120,64,58"
                                                      ColumnSpacing="8">
                                                    <Image Grid.Column="0" Source="{Binding Sprite}" Width="40" Height="34"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Species}" FontSize="12"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Nickname}" FontSize="12"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" FontSize="11" Classes="secondary"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding BoxName}"/><Run Text=" · "/><Run Text="{Binding SlotText}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4" Text="{Binding Level}" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Nature}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Ability}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding Ivs}" FontSize="11"
                                                               FontFamily="Menlo, monospace" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="★" FontSize="12" Foreground="Gold"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsShiny}"/>
                                                    <TextBlock Grid.Column="9" Text="✓" FontSize="12"
                                                               Foreground="{DynamicResource LegalFgBrush}"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsLegal}"/>
                                                    <TextBlock Grid.Column="9" Text="✕" FontSize="12"
                                                               Foreground="{DynamicResource IllegalFgBrush}"
                                                               VerticalAlignment="Center" IsVisible="{Binding !IsLegal}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- ══════ POKÉDEX view ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsDexView}" Margin="18,0,18,14">
                        <DockPanel DataContext="{Binding Dex}" x:DataType="vm:PokedexViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Pokédex" FontSize="17" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12"
                                           Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                       Text="This save format does not expose an editable Pokédex."
                                       Classes="fieldLabel"/>

                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" Margin="0,0,0,12" IsVisible="{Binding IsSupported}">
                                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Search by name or number…"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding MissingOnly, Mode=TwoWay}"
                                          Content="Missing only" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding ShinyToo, Mode=TwoWay}"
                                          Content="Include shiny" VerticalAlignment="Center"
                                          ToolTip.Tip="Also register the shiny form when marking an entry caught"/>
                                <Button Grid.Column="3" Content="Register owned" FontSize="12"
                                        ToolTip.Tip="Mark every species currently in your boxes and party as caught"
                                        Command="{Binding RegisterOwnedCommand}"/>
                                <Button Grid.Column="4" Content="Complete dex" FontSize="12"
                                        Command="{Binding CompleteDexCommand}"/>
                                <Button Grid.Column="5" Content="Clear all" FontSize="12"
                                        Command="{Binding ClearDexCommand}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,420" ColumnSpacing="14" IsVisible="{Binding IsSupported}">
                            <!-- ListBox virtualizes; rows stay a fixed height so scrolling is stable -->
                            <ListBox Grid.Column="0" ItemsSource="{Binding Rows}"
                                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DexRowViewModel">
                                        <Grid ColumnDefinitions="62,44,*,70,50,80" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontSize="11"
                                                       Classes="secondary" VerticalAlignment="Center"
                                                       FontFamily="Menlo, monospace"/>
                                            <Image Grid.Column="1" Source="{Binding Sprite}" Width="40" Height="34"
                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Seen" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center" IsVisible="{Binding Seen}"/>
                                            <CheckBox Grid.Column="4" Content="★" FontSize="12"
                                                      ToolTip.Tip="Shiny registered"
                                                      IsVisible="{Binding SupportsDetail}"
                                                      IsChecked="{Binding ShinySeen, Mode=TwoWay}"/>
                                            <CheckBox Grid.Column="5" Content="Caught" FontSize="12"
                                                      IsChecked="{Binding Caught, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Detail pane: fixed position, so selecting never disturbs the list -->
                            <Border Grid.Column="1" Classes="card" Padding="14" VerticalAlignment="Stretch">
                                <Panel>
                                    <!-- '!' does not null-check an object binding; use the converter -->
                                    <StackPanel VerticalAlignment="Center" Spacing="8"
                                                IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="📖" FontSize="30" HorizontalAlignment="Center" Opacity="0.3"/>
                                        <TextBlock Text="Select a species to see everything the dex records for it"
                                                   FontSize="12" Classes="secondary" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ScrollViewer IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel DataContext="{Binding SelectedRow}" x:DataType="vm:DexRowViewModel"
                                                    Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Image Source="{Binding Sprite}" Width="56" Height="48"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding NumberText}" FontSize="11"
                                                               Classes="secondary" FontFamily="Menlo, monospace"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="{Binding DetailNote}" FontSize="10" Classes="secondary"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="sectionTitle" Text="FORMS" Margin="0"/>
                                                <ItemsControl ItemsSource="{Binding Forms}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DexFormRowViewModel">
                                                            <Grid ColumnDefinitions="*,74,92" ColumnSpacing="8" Margin="0,1">
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <CheckBox Grid.Column="1" Content="Seen" FontSize="11"
                                                                          IsChecked="{Binding Seen, Mode=TwoWay}"/>
                                                                <CheckBox Grid.Column="2" Content="Obtained" FontSize="11"
                                                                          IsChecked="{Binding Obtained, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="sectionTitle" Text="GENDERS SEEN" Margin="0"/>
                                                <ItemsControl ItemsSource="{Binding Genders}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="14"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DexFlagViewModel">
                                                            <CheckBox Content="{Binding Label}" FontSize="11"
                                                                      IsChecked="{Binding Value, Mode=TwoWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="4" IsVisible="{Binding HasLanguages}">
                                                <TextBlock Classes="sectionTitle" Text="LANGUAGES OBTAINED" Margin="0"/>
                                                <ItemsControl ItemsSource="{Binding Languages}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DexFlagViewModel">
                                                            <CheckBox Content="{Binding Label}" FontSize="11"
                                                                      Margin="0,0,14,2"
                                                                      IsChecked="{Binding Value, Mode=TwoWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ══════ SAVE view: trainer identity + bag, side by side ══════ -->
                    <DockPanel IsVisible="{Binding IsSaveView}" Margin="18,0,18,14">

                    <!-- Action bar, docked so it can never overlap the cards -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Revert" Click="OnSaveRevertClicked"/>
                        <Button Content="Apply" Classes="accent" Click="OnSaveApplyClicked"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="380,*" ColumnSpacing="14">

                        <!-- Trainer identity -->
                        <Border Grid.Column="0" Classes="card" VerticalAlignment="Stretch">
                            <DockPanel DataContext="{Binding Trainer}" x:DataType="vm:TrainerEditorViewModel">
                                <TextBlock DockPanel.Dock="Top" Text="Trainer" FontSize="17" FontWeight="Bold"
                                           Margin="0,0,0,12"/>
                                <ScrollViewer>
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Trainer Name"/>
                                            <TextBox Text="{Binding OtName, Mode=TwoWay}" MaxLength="{Binding MaxOtLength}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Gender"/>
                                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding GenderIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="♂ Male"/>
                                                <ComboBoxItem Content="♀ Female"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Classes="fieldLabel" Text="TID"/>
                                                <NumericUpDown Value="{Binding Tid, Mode=TwoWay}" Minimum="0"
                                                               Maximum="{Binding MaxTid}" FormatString="0" Increment="1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="fieldLabel" Text="SID"/>
                                                <NumericUpDown Value="{Binding Sid, Mode=TwoWay}" Minimum="0"
                                                               Maximum="{Binding MaxSid}" FormatString="0" Increment="1"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Money"/>
                                            <NumericUpDown Value="{Binding Money, Mode=TwoWay}" Minimum="0"
                                                           Maximum="9999999" FormatString="0" Increment="1000"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Play Time  (h : m : s)"/>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                <NumericUpDown Grid.Column="0" Value="{Binding Hours, Mode=TwoWay}" Minimum="0" Maximum="9999" FormatString="0" Increment="1"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding Minutes, Mode=TwoWay}" Minimum="0" Maximum="59" FormatString="0" Increment="1"/>
                                                <NumericUpDown Grid.Column="2" Value="{Binding Seconds, Mode=TwoWay}" Minimum="0" Maximum="59" FormatString="0" Increment="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Bag -->
                        <Border Grid.Column="1" Classes="card">
                            <DockPanel DataContext="{Binding Bag}" x:DataType="vm:BagViewModel">
                                <TextBlock DockPanel.Dock="Top" Text="Bag" FontSize="17" FontWeight="Bold"
                                           Margin="0,0,0,12"/>
                                <TextBlock DockPanel.Dock="Top" Classes="fieldLabel" IsVisible="{Binding !HasPouches}"
                                           Text="This save format does not expose an editable inventory."/>

                                <!-- Item picker for the selected slot -->
                                <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="10" Margin="0,10,0,0"
                                        IsVisible="{Binding HasPouches}"
                                        Background="{DynamicResource SurfaceMutedBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding PouchSummary}" FontSize="11" Classes="secondary"/>
                                        <Grid ColumnDefinitions="Auto,116,Auto,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="Give all @" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center"/>
                                            <!-- Wide enough that the spinner buttons don't crush the text field -->
                                            <NumericUpDown Grid.Column="1" MinWidth="112"
                                                           Value="{Binding GiveAllCount, Mode=TwoWay}"
                                                           Minimum="1" Maximum="{Binding MaxCount}" FormatString="0"
                                                           Increment="1" FontSize="11"
                                                           HorizontalContentAlignment="Right"/>
                                            <Button Grid.Column="2" Content="Give all" FontSize="11" Padding="8,3"
                                                    Command="{Binding GiveAllItemsCommand}"/>
                                            <Button Grid.Column="3" Content="Sort A–Z" FontSize="11" Padding="8,3"
                                                    Command="{Binding SortByNameCommand}"/>
                                            <Button Grid.Column="4" Content="Empty pouch" FontSize="11" Padding="8,3"
                                                    Command="{Binding ClearPouchCommand}"/>
                                        </Grid>
                                        <Separator/>
                                        <TextBlock Classes="fieldLabel" Text="Change selected slot to"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ItemPickerChoices}"
                                                      SelectedValue="{Binding PickerValue, Mode=TwoWay}"
                                                      SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                      DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                            <Button Grid.Column="1" Content="Set" Command="{Binding SetSelectedItemCommand}"/>
                                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSelectedItemCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="170,*" ColumnSpacing="12" IsVisible="{Binding HasPouches}">
                                    <ListBox Grid.Column="0" ItemsSource="{Binding PouchNames}"
                                             SelectedIndex="{Binding SelectedPouchIndex, Mode=TwoWay}"/>
                                    <ListBox Grid.Column="1" ItemsSource="{Binding Rows}"
                                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BagItemRowViewModel">
                                                <Grid ColumnDefinitions="26,*,136" ColumnSpacing="8">
                                                    <Image Grid.Column="0" Source="{Binding Sprite}" Width="24" Height="24"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="13"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <NumericUpDown Grid.Column="2" Value="{Binding Count, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="{Binding MaxCount}" FormatString="0"
                                                                   Increment="1" FontSize="12" HorizontalContentAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    </DockPanel>

                    </Panel>

                    <!-- ══════ INSPECTOR ══════ -->
                    <Panel Grid.Column="1" Margin="0,0,18,14">
                        <!-- Database mode: browser on top, live preview + add below -->
                        <Grid RowDefinitions="*,Auto" RowSpacing="8" IsVisible="{Binding IsDatabaseView}">
                            <Panel Grid.Row="0">
                    <!-- ══════ Add Pokémon view ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsAddView}">
                        <DockPanel DataContext="{Binding AddDb}" x:DataType="vm:AddPokemonViewModel">
                            <TextBlock DockPanel.Dock="Top" Text="Add Pokémon from Encounter Database"
                                       FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="fieldLabel" Text="Species"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesChoices}"
                                              SelectedValue="{Binding SpeciesValue, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding MakeShiny, Mode=TwoWay}" Content="Make Shiny ★ (if possible)"/>
                                <TextBlock Classes="fieldLabel" Text="Legal encounters — pick one to preview"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="12"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <ListBox Margin="0,4,0,0" ItemsSource="{Binding EncounterDescriptions}"
                                     SelectedIndex="{Binding SelectedEncounterIndex, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <!-- ══════ Mystery Gifts view: sprite tile grid ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsGiftsView}">
                        <DockPanel DataContext="{Binding GiftDb}" x:DataType="vm:GiftsViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Mystery Gift Database"
                                           FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" FontSize="11"
                                           Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Filters -->
                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Search species, event, or game…"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" FontSize="12"
                                              ItemsSource="{Binding GenerationChoices}"
                                              SelectedIndex="{Binding SelectedGenerationIndex, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12"
                                              ItemsSource="{Binding GameChoices}"
                                              SelectedIndex="{Binding SelectedGameIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding ShinyOnly, Mode=TwoWay}"
                                              Content="Shiny only" FontSize="12"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EggsOnly, Mode=TwoWay}"
                                              Content="Eggs only" FontSize="12"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding AddableOnly, Mode=TwoWay}" FontSize="12"
                                              Content="Only gifts this save accepts"/>
                                    <Button Grid.Column="1" Content="Clear" FontSize="11" Padding="10,3"
                                            Command="{Binding ClearFiltersCommand}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="12"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button DockPanel.Dock="Bottom" Content="{Binding LoadMoreLabel}"
                                    IsVisible="{Binding HasMore}" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding LoadNextPageCommand}"/>

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GiftTileViewModel">
                                            <Button Classes="giftTile" Classes.selected="{Binding IsSelected}"
                                                    Opacity="{Binding TileOpacity}"
                                                    Command="{Binding $parent[ItemsControl].((vm:GiftsViewModel)DataContext).SelectTileCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                <StackPanel Width="86" Spacing="1">
                                                    <Panel Height="52">
                                                        <Image Source="{Binding Sprite}" Width="60" Height="50"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                        <Image Source="{Binding ShinyOverlay}" Width="18" Height="18"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Margin="14,2,0,0" Opacity="0.85"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                    </Panel>
                                                    <TextBlock Text="{Binding SpeciesName}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="10" Classes="secondary"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OriginText}" FontSize="9" Classes="secondary"
                                                               HorizontalAlignment="Center" Opacity="0.75"/>
                                                    <TextBlock Text="{Binding CardTitle}" FontSize="9" Classes="secondary"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="84"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>


                            </Panel>

                        <!-- Compact preview of the selected database entry -->
                        <Border Grid.Row="1" Classes="card" Padding="12">
                            <StackPanel DataContext="{Binding Preview}" x:DataType="vm:PokemonPreviewViewModel"
                                        Spacing="8">
                                <TextBlock Text="Select an entry to preview it here" FontSize="12" Classes="secondary"
                                           HorizontalAlignment="Center" IsVisible="{Binding !HasPokemon}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>

                                <!-- Blocked: explain why nothing can be added -->
                                <Border CornerRadius="8" Padding="10,8" IsVisible="{Binding IsBlocked}"
                                        Background="{DynamicResource IllegalBgBrush}">
                                    <TextBlock Text="{Binding BlockedReason}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource IllegalFgBrush}"/>
                                </Border>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasPokemon}">
                                    <Image Grid.Column="0" Source="{Binding Artwork}" Width="84" Height="84"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Image Source="{Binding BallSprite}" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SpeciesName}" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding LevelBadge}" FontSize="10" Classes="secondary"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Classes="chip" Padding="7,2" Background="{Binding Type1Brush}">
                                                <TextBlock Text="{Binding Type1Name}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <Border Classes="chip" Padding="7,2" Background="{Binding Type2Brush}"
                                                    IsVisible="{Binding HasType2}">
                                                <TextBlock Text="{Binding Type2Name}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <Border Classes="chip" Padding="7,2" Background="{DynamicResource SurfaceMutedBrush}"
                                                    IsVisible="{Binding IsShiny}">
                                                <TextBlock Text="★ Shiny" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Classes="chip" Padding="7,2" Background="{DynamicResource LegalBgBrush}"
                                                    IsVisible="{Binding IsLegal}">
                                                <TextBlock Text="✓ Legal" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource LegalFgBrush}"/>
                                            </Border>
                                            <Border Classes="chip" Padding="7,2" Background="{DynamicResource IllegalBgBrush}"
                                                    IsVisible="{Binding !IsLegal}">
                                                <TextBlock Text="✕ Issues" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource IllegalFgBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TargetSlotText}"
                                        Classes="accent" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding HasPokemon}"
                                        Click="OnAddPreviewClicked"/>
                            </StackPanel>
                        </Border>

                        </Grid>

                        <Border Classes="card" IsVisible="{Binding IsBoxesView}">
                            <StackPanel VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !Detail.HasPokemon}">
                                <TextBlock Text="◓" FontSize="34" HorizontalAlignment="Center" Opacity="0.25"/>

                                <!-- Nothing selected -->
                                <TextBlock Text="Select a Pokémon" FontSize="13" Classes="secondary"
                                           HorizontalAlignment="Center" IsVisible="{Binding !CanUseDatabases}"/>

                                <!-- An empty slot is selected: offer to fill it -->
                                <StackPanel Spacing="10" IsVisible="{Binding CanUseDatabases}">
                                    <TextBlock Text="{Binding TargetSlotText}" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="This slot is empty — fill it from a database, or drop a .pk file onto it."
                                               FontSize="11" Classes="secondary" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Content="✚   Add Pokémon from Database" Classes="accent"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetViewCommand}" CommandParameter="add"/>
                                    <Button Content="🎁   Mystery Gift Database"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetViewCommand}" CommandParameter="gifts"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Panel IsVisible="{Binding IsBoxesView}">
                        <Border Classes="card" Padding="0"
                                DataContext="{Binding Detail}"
                                x:DataType="vm:PokemonDetailViewModel"
                                IsVisible="{Binding HasPokemon}">
                            <DockPanel Margin="14">
                                <!-- Hero -->
                                <StackPanel DockPanel.Dock="Top" Spacing="8">
                                    <Image Source="{Binding Artwork}" Height="150"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Image Source="{Binding BallSprite}" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeciesName}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelBadge}" FontSize="10" Classes="secondary"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Border Classes="chip" Background="{Binding Type1Brush}">
                                            <TextBlock Text="{Binding Type1Name}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <Border Classes="chip" Background="{Binding Type2Brush}" IsVisible="{Binding HasType2}">
                                            <TextBlock Text="{Binding Type2Name}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}" IsVisible="{Binding IsShiny}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Image Source="{Binding ShinyIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Shiny" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="chip" Background="{DynamicResource LegalBgBrush}" IsVisible="{Binding IsLegal}">
                                            <TextBlock Text="✓ Legal" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LegalFgBrush}"/>
                                        </Border>
                                        <Border Classes="chip" Background="{DynamicResource IllegalBgBrush}" IsVisible="{Binding !IsLegal}">
                                            <TextBlock Text="✕ Issues" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource IllegalFgBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource IllegalBgBrush}"
                                            IsVisible="{Binding !IsLegal}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding LegalityReport}" FontSize="10" TextWrapping="Wrap"
                                                       MaxHeight="72" Foreground="{DynamicResource IllegalFgBrush}"/>
                                            <Button Content="Fix moves &amp; relearn" FontSize="11" Padding="10,3"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="Apply a legal moveset and the encounter's relearn moves. Met data is left alone — use Suggest on the Met tab for that."
                                                    Command="{Binding SuggestAllCommand}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding SuggestionResult}" FontSize="10" Classes="secondary"
                                               TextWrapping="Wrap" IsVisible="{Binding SuggestionResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Apply -->
                                <Button DockPanel.Dock="Bottom" Content="Apply Changes" Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding IsDirty}" Classes="accent"
                                        Click="OnApplyClicked"/>

                                <!-- Tabs -->
                                <TabControl Margin="0,6,0,0" Padding="0,6,0,0">
                                    <TabItem Header="Main">
                                        <ScrollViewer>
                                            <StackPanel Spacing="9" Margin="2,6,6,2">
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Species"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesChoices}"
                                                              SelectedValue="{Binding SpeciesValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding HasForms}">
                                                    <TextBlock Classes="fieldLabel" Text="Form"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FormChoices}"
                                                              SelectedIndex="{Binding FormIndex, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Nickname"/>
                                                    <TextBox Text="{Binding Nickname, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Level"/>
                                                        <NumericUpDown Value="{Binding Level, Mode=TwoWay}" Minimum="1" Maximum="100"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="fieldLabel" Text="Friendship"/>
                                                        <NumericUpDown Value="{Binding Friendship, Mode=TwoWay}" Minimum="0" Maximum="255"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Gender"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GenderChoices}"
                                                                  SelectedIndex="{Binding GenderIndex, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanEditGender}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                        <CheckBox IsChecked="{Binding IsShiny, Mode=TwoWay}" Content="Shiny ★"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Nature"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}"
                                                              SelectedValue="{Binding NatureValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:NatureChoice}">
                                                        <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NatureChoice">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" MinWidth="76"/>
                                                                <TextBlock Text="{Binding UpLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.UpBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding DownLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.DownBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding NeutralLabel}" FontSize="11" Classes="secondary"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsNeutral}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Ability"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AbilityChoices}"
                                                              SelectedIndex="{Binding AbilityIndex, Mode=TwoWay}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Held Item"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ItemChoices}"
                                                              SelectedValue="{Binding HeldItemValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Ball"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BallChoices}"
                                                              SelectedValue="{Binding BallValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Language"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageChoices}"
                                                              SelectedValue="{Binding LanguageValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding HasStatNature}">
                                                    <TextBlock Classes="fieldLabel" Text="Stat Nature (Gen 8+ split)"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}"
                                                              SelectedValue="{Binding StatNatureValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:NatureChoice}">
                                                        <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NatureChoice">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" MinWidth="76"/>
                                                                <TextBlock Text="{Binding UpLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.UpBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding DownLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.DownBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding NeutralLabel}" FontSize="11" Classes="secondary"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsNeutral}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Experience"/>
                                                    <NumericUpDown Value="{Binding Experience, Mode=TwoWay}" Minimum="0"
                                                                   Maximum="1640000" FormatString="0" Increment="1000"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding FormArgumentVisible}">
                                                    <TextBlock Classes="fieldLabel" Text="Form Argument"/>
                                                    <NumericUpDown Value="{Binding FormArgument, Mode=TwoWay}" Minimum="0"
                                                                   Maximum="4294967295" FormatString="0" Increment="1"/>
                                                </StackPanel>
                                                <Separator Margin="0,4"/>
                                                <TextBlock Classes="sectionTitle" Text="POKÉRUS"/>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Strain"/>
                                                        <NumericUpDown Value="{Binding PokerusStrain, Mode=TwoWay}" Minimum="0"
                                                                       Maximum="15" FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="fieldLabel" Text="Days left"/>
                                                        <NumericUpDown Value="{Binding PokerusDays, Mode=TwoWay}" Minimum="0"
                                                                       Maximum="4" FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <CheckBox IsChecked="{Binding IsEgg, Mode=TwoWay}" Content="Is Egg"/>
                                                    <CheckBox IsChecked="{Binding IsFavorite, Mode=TwoWay}" Content="Favorite"
                                                              IsVisible="{Binding SupportsFavorite}"/>
                                                </StackPanel>
                                                <Separator Margin="0,4"/>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="PID"/>
                                                        <TextBlock Text="{Binding PidText}" FontFamily="Menlo, monospace" FontSize="12"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Reroll" FontSize="11" Padding="8,3"
                                                            VerticalAlignment="Bottom" Command="{Binding RerollPidCommand}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Encryption Constant"/>
                                                        <TextBlock Text="{Binding EcText}" FontFamily="Menlo, monospace" FontSize="12"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Reroll" FontSize="11" Padding="8,3"
                                                            VerticalAlignment="Bottom" Command="{Binding RerollEncryptionConstantCommand}"/>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Stats">
                                        <ScrollViewer>
                                            <StackPanel Spacing="6" Margin="2,6,6,2">
                                                <!-- Nature, with the stat it raises / lowers -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="fieldLabel" Text="Nature"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}"
                                                              SelectedValue="{Binding NatureValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:NatureChoice}">
                                                        <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NatureChoice">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" MinWidth="76"/>
                                                                <TextBlock Text="{Binding UpLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.UpBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding DownLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.DownBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding NeutralLabel}" FontSize="11" Classes="secondary"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsNeutral}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding NatureEffectText}" FontSize="11" Classes="secondary"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Shared EV pool -->
                                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="EV BUDGET" Margin="0,0,0,0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding EvBudgetText}" FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </DockPanel>
                                                    <ProgressBar Classes="meter" Value="{Binding EvBudgetPercent}"
                                                                 Foreground="{DynamicResource MeterEvBrush}"
                                                                 Margin="0,0,10,0"/>
                                                    <TextBlock Text="Sliders stop at whatever the 510-point pool has left."
                                                               FontSize="10" Classes="secondary"
                                                               IsVisible="{Binding !EvOverLimit}"/>
                                                    <TextBlock Text="This spread exceeds the game's 510 EV limit and will be flagged as illegal."
                                                               FontSize="10" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource IllegalFgBrush}"
                                                               IsVisible="{Binding EvOverLimit}"/>
                                                </StackPanel>

                                                <Separator Margin="0,6"/>

                                                <!-- ProDex-style rows: label, value, magnitude bar; IV/EV inline -->
                                                <ItemsControl ItemsSource="{Binding Stats}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StatEditRowViewModel">
                                                            <Grid ColumnDefinitions="66,44,*" RowDefinitions="Auto,Auto"
                                                                  ColumnSpacing="8" RowSpacing="2" Margin="0,0,0,9">

                                                                <!-- Fixed label column so every nature arrow lines up -->
                                                                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="44,*"
                                                                      VerticalAlignment="Center">
                                                                    <TextBlock Grid.Column="0" Text="{Binding ShortLabel}"
                                                                               FontSize="12" FontWeight="Bold"
                                                                               Foreground="{Binding LabelBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding NatureBadge}" FontSize="10"
                                                                               IsVisible="{Binding HasNatureBadge}"
                                                                               Foreground="{Binding NatureBadgeBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stat}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                <ProgressBar Grid.Row="0" Grid.Column="2" Classes="statbar"
                                                                             Value="{Binding StatBarPercent}"
                                                                             Foreground="{Binding BarBrush}"
                                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <!-- IV / EV inputs, tucked under the bar -->
                                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="6" HorizontalAlignment="Left">
                                                                    <TextBlock Text="IV" FontSize="10" Classes="secondary" VerticalAlignment="Center"/>
                                                                    <TextBox Classes="statNum" Text="{Binding Iv, Mode=TwoWay}"/>
                                                                    <TextBlock Text="EV" FontSize="10" Classes="secondary"
                                                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                    <TextBox Classes="statNum" Text="{Binding Ev, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Totals: species base-stat total, and the live in-battle sum -->
                                                <Separator Margin="0,2,0,6"/>
                                                <Grid ColumnDefinitions="66,44,*" ColumnSpacing="8" Margin="0,0,0,5"
                                                      ToolTip.Tip="Base stat total — a constant for this species, the number dex apps show">
                                                    <TextBlock Grid.Column="0" Text="BST" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding BaseStatTotal}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="2" Classes="statbar"
                                                                 Value="{Binding BaseStatTotalPercent}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="66,44,*" ColumnSpacing="8" Margin="0,0,0,6"
                                                      ToolTip.Tip="Sum of this Pokémon's actual stats at its current level, IVs, EVs and nature">
                                                    <TextBlock Grid.Column="0" Text="TOT" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatTotal}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="2" Classes="statbar"
                                                                 Value="{Binding StatTotalPercent}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>

                                                                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                                    <Button Content="Max IVs" Command="{Binding MaxIVsCommand}" FontSize="12"/>
                                                    <Button Content="Clear EVs" Command="{Binding ClearEVsCommand}" FontSize="12"/>
                                                    <Button Content="Heal" Command="{Binding HealPokemonCommand}" FontSize="12"/>
                                                </StackPanel>

                                                <!-- Hyper training (bottle caps) -->
                                                <StackPanel IsVisible="{Binding SupportsHyperTraining}" Spacing="6" Margin="0,10,0,0">
                                                    <Separator/>
                                                    <TextBlock Classes="sectionTitle" Text="HYPER TRAINING"/>
                                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="2">
                                                        <CheckBox Grid.Row="0" Grid.Column="0" Content="HP" FontSize="11" IsChecked="{Binding HtHp, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="0" Grid.Column="1" Content="Atk" FontSize="11" IsChecked="{Binding HtAtk, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="0" Grid.Column="2" Content="Def" FontSize="11" IsChecked="{Binding HtDef, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="0" Content="SpA" FontSize="11" IsChecked="{Binding HtSpa, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="1" Content="SpD" FontSize="11" IsChecked="{Binding HtSpd, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="2" Content="Spe" FontSize="11" IsChecked="{Binding HtSpe, Mode=TwoWay}"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Train all" FontSize="12" Command="{Binding MaxHyperTrainingCommand}"/>
                                                        <Button Content="Clear" FontSize="12" Command="{Binding ClearHyperTrainingCommand}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Tera type (Scarlet/Violet) -->
                                                <StackPanel IsVisible="{Binding SupportsTeraType}" Spacing="8" Margin="0,10,0,0">
                                                    <Separator/>
                                                    <TextBlock Classes="sectionTitle" Text="TERA TYPE"/>
                                                    <StackPanel>
                                                        <TextBlock Classes="fieldLabel" Text="Original"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TeraTypeChoices}"
                                                                  SelectedValue="{Binding TeraTypeOriginalValue, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Classes="fieldLabel" Text="Override (Tera Shard change)"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TeraTypeOverrideChoices}"
                                                                  SelectedValue="{Binding TeraTypeOverrideValue, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Size -->
                                                <StackPanel IsVisible="{Binding SupportsScalars}" Spacing="8" Margin="0,10,0,0">
                                                    <Separator/>
                                                    <TextBlock Classes="sectionTitle" Text="SIZE"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Height"/>
                                                            <NumericUpDown Value="{Binding HeightScalar, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Weight"/>
                                                            <NumericUpDown Value="{Binding WeightScalar, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding SupportsScale}">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Scale (drives Jumbo / Mini marks)"/>
                                                            <NumericUpDown Value="{Binding Scale, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1" FontSize="12"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Random" FontSize="11" Padding="8,3"
                                                                VerticalAlignment="Bottom" Command="{Binding RandomizeScaleCommand}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SizeSummary}" FontSize="11" Classes="secondary"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Moves">
                                        <ScrollViewer>
                                            <StackPanel Spacing="8" Margin="2,6,6,2">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="MOVES" Margin="0,0,0,0"/>
                                                    <Button DockPanel.Dock="Right" Content="Suggest" FontSize="10" Padding="8,1"
                                                            HorizontalAlignment="Right"
                                                            ToolTip.Tip="Fill these four slots with a legal moveset"
                                                            Command="{Binding SuggestMovesCommand}"/>
                                                </DockPanel>
                                                <Grid ColumnDefinitions="*,64,52">
                                                    <TextBlock Grid.Column="1" Text="PP Ups" FontSize="10" Classes="secondary" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="PP" FontSize="10" Classes="secondary" HorizontalAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,64,52" ColumnSpacing="4">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move1, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <NumericUpDown Grid.Column="1" Value="{Binding PpUps1, Mode=TwoWay}" Minimum="0" Maximum="3"
                                                                   FormatString="0" Increment="1" FontSize="12" ShowButtonSpinner="False"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp1}" FontSize="11" Classes="secondary"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,64,52" ColumnSpacing="4">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move2, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <NumericUpDown Grid.Column="1" Value="{Binding PpUps2, Mode=TwoWay}" Minimum="0" Maximum="3"
                                                                   FormatString="0" Increment="1" FontSize="12" ShowButtonSpinner="False"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp2}" FontSize="11" Classes="secondary"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,64,52" ColumnSpacing="4">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move3, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <NumericUpDown Grid.Column="1" Value="{Binding PpUps3, Mode=TwoWay}" Minimum="0" Maximum="3"
                                                                   FormatString="0" Increment="1" FontSize="12" ShowButtonSpinner="False"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp3}" FontSize="11" Classes="secondary"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,64,52" ColumnSpacing="4">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move4, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <NumericUpDown Grid.Column="1" Value="{Binding PpUps4, Mode=TwoWay}" Minimum="0" Maximum="3"
                                                                   FormatString="0" Increment="1" FontSize="12" ShowButtonSpinner="False"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp4}" FontSize="11" Classes="secondary"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>

                                                <StackPanel IsVisible="{Binding HasRelearnMoves}">
                                                    <DockPanel Margin="2,10,0,6">
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="RELEARN MOVES" Margin="0"/>
                                                        <Button DockPanel.Dock="Right" Content="Suggest" FontSize="10" Padding="8,1"
                                                                HorizontalAlignment="Right"
                                                                ToolTip.Tip="Use the relearn moves this encounter provides"
                                                                Command="{Binding SuggestRelearnMovesCommand}"/>
                                                    </DockPanel>
                                                    <StackPanel Spacing="8">
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                                  SelectedValue="{Binding Relearn1, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                                  SelectedValue="{Binding Relearn2, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                                  SelectedValue="{Binding Relearn3, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                                  SelectedValue="{Binding Relearn4, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Technical Records (TM history) -->
                                                <StackPanel Spacing="6" Margin="0,12,0,0"
                                                            DataContext="{Binding TechRecords}" x:DataType="vm:TechRecordViewModel"
                                                            IsVisible="{Binding IsSupported}">
                                                    <Separator/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="TECHNICAL RECORDS" Margin="0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="10"
                                                                   Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" FontSize="12"
                                                             Watermark="Search machine moves…"/>
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding LearnedOnly, Mode=TwoWay}"
                                                                  Content="Learned only" FontSize="12"/>
                                                    </DockPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="All legal" FontSize="11" Padding="8,3"
                                                                ToolTip.Tip="Mark the records this Pokémon could legally have used"
                                                                Command="{Binding SetAllLegalCommand}"/>
                                                        <Button Content="All" FontSize="11" Padding="8,3" Command="{Binding SetAllCommand}"/>
                                                        <Button Content="None" FontSize="11" Padding="8,3" Command="{Binding ClearAllCommand}"/>
                                                    </StackPanel>
                                                    <ScrollViewer MaxHeight="260">
                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:TechRecordRowViewModel">
                                                                    <CheckBox Content="{Binding MoveName}" FontSize="12"
                                                                              IsChecked="{Binding Learned, Mode=TwoWay}"
                                                                              Margin="0,1"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Met">
                                        <ScrollViewer>
                                            <StackPanel Spacing="9" Margin="2,6,6,2">
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Origin Game"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding VersionChoices}"
                                                              SelectedValue="{Binding VersionValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>

                                                <!-- Transfer / HOME: what makes a foreign-version Pokémon legal -->
                                                <Border CornerRadius="10" Padding="10" Margin="0,2,0,2"
                                                        Background="{DynamicResource SurfaceMutedBrush}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Classes="sectionTitle" Text="TRANSFER &amp; POKÉMON HOME" Margin="0"/>
                                                        <TextBlock Text="{Binding TransferSummary}" FontSize="10"
                                                                   Classes="secondary" TextWrapping="Wrap"/>
                                                        <Button Content="Mark as traded into this save" FontSize="11"
                                                                Padding="10,3" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                ToolTip.Tip="Sets this save's trainer as the handling trainer, leaving the original trainer intact — what receiving a trade does."
                                                                Command="{Binding MarkAsTradedCommand}"/>

                                                    </StackPanel>
                                                </Border>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="fieldLabel" Text="Met Location"/>
                                                        <Button DockPanel.Dock="Right" Content="Suggest" FontSize="10" Padding="8,1"
                                                                HorizontalAlignment="Right"
                                                                ToolTip.Tip="Use the met location and level the legality engine expects"
                                                                Command="{Binding SuggestMetInfoCommand}"/>
                                                    </DockPanel>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MetLocationChoices}"
                                                              SelectedValue="{Binding MetLocationValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Met Level"/>
                                                        <NumericUpDown Value="{Binding MetLevel, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                        <CheckBox IsChecked="{Binding FatefulEncounter, Mode=TwoWay}" Content="Fateful"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Met Date"/>
                                                    <DatePicker SelectedDate="{Binding MetDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SupportsObedience}">
                                                    <TextBlock Classes="fieldLabel" Text="Obedience Level"/>
                                                    <NumericUpDown Value="{Binding ObedienceLevel, Mode=TwoWay}" Minimum="0"
                                                                   Maximum="100" FormatString="0" Increment="1"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SupportsBattleVersion}">
                                                    <TextBlock Classes="fieldLabel" Text="Battle Version (reset for ranked)"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding VersionChoices}"
                                                              SelectedValue="{Binding BattleVersionValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>

                                                <Separator Margin="0,6"/>
                                                <TextBlock Classes="sectionTitle" Text="EGG DATA"/>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Egg Met Location"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MetLocationChoices}"
                                                              SelectedValue="{Binding EggLocationValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Egg Met Date"/>
                                                    <DatePicker SelectedDate="{Binding EggMetDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>

                                                <Separator Margin="0,6"/>
                                                <TextBlock Classes="sectionTitle" Text="ORIGINAL TRAINER"/>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="OT Name"/>
                                                    <TextBox Text="{Binding OtName, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="TID"/>
                                                        <NumericUpDown Value="{Binding DisplayTid, Mode=TwoWay}" Minimum="0" Maximum="999999"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="fieldLabel" Text="SID"/>
                                                        <NumericUpDown Value="{Binding DisplaySid, Mode=TwoWay}" Minimum="0" Maximum="999999"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="OT Gender"/>
                                                    <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding OtGenderIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="♂ Male"/>
                                                        <ComboBoxItem Content="♀ Female"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- HOME identifier lives at the end: rarely edited, and it fingerprints the save -->
                                                <StackPanel IsVisible="{Binding SupportsHomeTracker}" Spacing="8">
                                                    <Separator Margin="0,6"/>
                                                    <TextBlock Classes="sectionTitle" Text="POKÉMON HOME"/>
                                                    <StackPanel DataContext="{Binding History}" x:DataType="vm:PokemonHistoryViewModel"
                                                                Spacing="6">
                                                        <CheckBox IsChecked="{Binding HideTracker, Mode=TwoWay}" FontSize="11"
                                                                  Content="Hide tracker (it identifies your save)"/>
                                                        <StackPanel IsVisible="{Binding !HideTracker}">
                                                            <TextBlock Classes="fieldLabel" Text="HOME Tracker (16 hex digits)"/>
                                                            <TextBox Text="{Binding TrackerText, Mode=TwoWay}"
                                                                     FontFamily="Menlo, monospace" MaxLength="16"
                                                                     Watermark="0123456789ABCDEF"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Generate tracker" FontSize="11" Padding="8,3"
                                                                ToolTip.Tip="Give this Pokémon a plausible tracker, as a real HOME transfer would"
                                                                Command="{Binding GenerateHomeTrackerCommand}"/>
                                                        <Button Content="Clear" FontSize="11" Padding="8,3"
                                                                Command="{Binding ClearHomeTrackerCommand}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TransferSummary}" FontSize="10"
                                                               Classes="secondary" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- ══════ Trainer &amp; History ══════ -->
                                    <TabItem Header="Trainer">
                                        <ScrollViewer>
                                            <StackPanel Spacing="9" Margin="2,6,6,2"
                                                        DataContext="{Binding History}" x:DataType="vm:PokemonHistoryViewModel">

                                                <!-- Who holds it -->
                                                <StackPanel IsVisible="{Binding SupportsHandler}" Spacing="6">
                                                    <TextBlock Classes="sectionTitle" Text="CURRENT HANDLER"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding HandlerChoices}"
                                                              SelectedIndex="{Binding CurrentHandlerIndex, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding HandlerSummary}" FontSize="11" Classes="secondary"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Handling trainer -->
                                                <StackPanel IsVisible="{Binding SupportsHandler}" Spacing="9">
                                                    <Separator Margin="0,4"/>
                                                    <TextBlock Classes="sectionTitle" Text="HANDLING TRAINER"/>
                                                    <StackPanel>
                                                        <TextBlock Classes="fieldLabel" Text="Name"/>
                                                        <TextBox Text="{Binding HtName, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Gender"/>
                                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GenderChoices}"
                                                                      SelectedIndex="{Binding HtGenderIndex, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Friendship"/>
                                                            <NumericUpDown Value="{Binding HtFriendship, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel IsVisible="{Binding SupportsHandlerLanguage}">
                                                        <TextBlock Classes="fieldLabel" Text="Language"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageChoices}"
                                                                  SelectedValue="{Binding HtLanguageValue, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Memories -->
                                                <StackPanel IsVisible="{Binding SupportsMemories}" Spacing="8">
                                                    <Separator Margin="0,4"/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="MEMORIES"/>
                                                        <Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="8,2"
                                                                HorizontalAlignment="Right" Command="{Binding ClearMemoriesCommand}"/>
                                                    </DockPanel>

                                                    <TextBlock Classes="fieldLabel" Text="Original Trainer memory"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MemoryChoices}"
                                                              SelectedValue="{Binding OtMemory, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding IntensityChoices}"
                                                                  SelectedValue="{Binding OtMemoryIntensity, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FeelingChoices}"
                                                                  SelectedValue="{Binding OtMemoryFeeling, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding OtMemoryText}" FontSize="10" Classes="secondary" TextWrapping="Wrap"/>

                                                    <TextBlock Classes="fieldLabel" Text="Handling Trainer memory" Margin="0,6,0,0"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MemoryChoices}"
                                                              SelectedValue="{Binding HtMemory, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding IntensityChoices}"
                                                                  SelectedValue="{Binding HtMemoryIntensity, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FeelingChoices}"
                                                                  SelectedValue="{Binding HtMemoryFeeling, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding HtMemoryText}" FontSize="10" Classes="secondary" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Markings -->
                                                <StackPanel IsVisible="{Binding SupportsMarkings}" Spacing="6">
                                                    <Separator Margin="0,4"/>
                                                    <TextBlock Classes="sectionTitle" Text="MARKINGS"/>
                                                    <ItemsControl ItemsSource="{Binding Markings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MarkingRowViewModel">
                                                                <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Margin="0,2">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               Classes="secondary" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12"
                                                                              ItemsSource="{Binding Choices}"
                                                                              SelectedIndex="{Binding Value, Mode=TwoWay}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Contest stats -->
                                                <StackPanel IsVisible="{Binding SupportsContest}" Spacing="6">
                                                    <Separator Margin="0,4"/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="CONTEST STATS"/>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Max" FontSize="11" Padding="8,2" Command="{Binding MaxContestCommand}"/>
                                                            <Button Content="Clear" FontSize="11" Padding="8,2" Command="{Binding ClearContestCommand}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Cool"/>
                                                            <NumericUpDown Value="{Binding ContestCool, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Beauty"/>
                                                            <NumericUpDown Value="{Binding ContestBeauty, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Cute"/>
                                                            <NumericUpDown Value="{Binding ContestCute, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Smart"/>
                                                            <NumericUpDown Value="{Binding ContestSmart, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Tough"/>
                                                            <NumericUpDown Value="{Binding ContestTough, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Sheen"/>
                                                            <NumericUpDown Value="{Binding ContestSheen, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- HOME tracker -->
                                                <StackPanel IsVisible="{Binding SupportsTracker}" Spacing="6">
                                                    <Separator Margin="0,4"/>
                                                    <TextBlock Classes="sectionTitle" Text="POKÉMON HOME"/>
                                                    <CheckBox IsChecked="{Binding HideTracker, Mode=TwoWay}"
                                                              Content="Hide tracker (it identifies your save)"/>
                                                    <StackPanel IsVisible="{Binding !HideTracker}">
                                                        <TextBlock Classes="fieldLabel" Text="HOME Tracker (16 hex digits)"/>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBox Grid.Column="0" Text="{Binding TrackerText, Mode=TwoWay}"
                                                                     FontFamily="Menlo, monospace" MaxLength="16"
                                                                     Watermark="0123456789ABCDEF"/>
                                                            <Button Grid.Column="1" Content="Zero" FontSize="11" Padding="8,3"
                                                                    Command="{Binding ClearTrackerCommand}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- ══════ Ribbons &amp; Marks ══════ -->
                                    <TabItem Header="Ribbons">
                                        <DockPanel DataContext="{Binding Ribbons}" x:DataType="vm:RibbonsViewModel"
                                                   Margin="2,6,6,2">
                                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                                <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search ribbons &amp; marks…"/>
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                                                              Content="Owned only" FontSize="12"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="11"
                                                               Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Give all legal" FontSize="12" Command="{Binding GiveAllLegalCommand}"/>
                                                    <Button Content="Remove all" FontSize="12" Command="{Binding RemoveAllCommand}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding SupportsAffixed}" Margin="0,8,0,0">
                                                <TextBlock Classes="fieldLabel" Text="Affixed ribbon (shown in-game)"/>
                                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AffixedChoices}"
                                                          SelectedValue="{Binding AffixedValue, Mode=TwoWay}"
                                                          SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                          DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                            </StackPanel>

                                            <ScrollViewer Margin="0,8,0,0">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RibbonRowViewModel">
                                                            <Grid ColumnDefinitions="*,76" ColumnSpacing="6" Margin="0,1">
                                                                <CheckBox Grid.Column="0" FontSize="12"
                                                                          Content="{Binding DisplayName}"
                                                                          IsChecked="{Binding HasRibbon, Mode=TwoWay}"
                                                                          IsVisible="{Binding IsFlag}"/>
                                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                                           Text="{Binding DisplayName}"
                                                                           IsVisible="{Binding IsCounter}"/>
                                                                <NumericUpDown Grid.Column="1" FontSize="12" ShowButtonSpinner="False"
                                                                               Value="{Binding Count, Mode=TwoWay}" Minimum="0"
                                                                               Maximum="{Binding MaxCount}" FormatString="0"
                                                                               IsVisible="{Binding IsCounter}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Border>
                        </Panel>
                    </Panel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Drag ghost: follows the pointer while moving a Pokémon between slots -->
        <Canvas IsHitTestVisible="False">
            <Image x:Name="DragGhost" Width="68" Height="56" Opacity="0.85" IsVisible="False"
                   RenderOptions.BitmapInterpolationMode="None"/>
        </Canvas>
    </Panel>
</Window>
