<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="PKHeX.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1240" Height="800"
        MinWidth="980" MinHeight="640">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="Open Save File…" Gesture="Cmd+O" Click="OnOpenClicked"/>
                    <NativeMenuItem Header="Export Save As…" Gesture="Cmd+S" Click="OnExportClicked"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="Cmd+OemOpenBrackets" Command="{Binding PreviousBoxCommand}"/>
        <KeyBinding Gesture="Cmd+OemCloseBrackets" Command="{Binding NextBoxCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Storage slot cell -->
        <Style Selector="Border.slot">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style Selector="Border.slot:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Border.slot.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="14,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.75"/>
        </Border>

        <Grid ColumnDefinitions="230,*,330">

            <!-- ============ SIDEBAR ============ -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <DockPanel Margin="12">
                    <!-- Trainer card -->
                    <Border DockPanel.Dock="Top" CornerRadius="12" Padding="12" Margin="0,0,0,12"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                            IsVisible="{Binding HasSave}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding TrainerName}" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GameName}" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{Binding GenerationText}" FontSize="11" Opacity="0.55"/>
                            <TextBlock Text="{Binding TrainerIds}" FontSize="11" Opacity="0.55"/>
                            <TextBlock Text="{Binding PlayTime}" FontSize="11" Opacity="0.55"/>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="BOXES"
                               IsVisible="{Binding HasSave}"/>

                    <!-- Box list -->
                    <ListBox ItemsSource="{Binding BoxNames}"
                             SelectedIndex="{Binding CurrentBox, Mode=TwoWay}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ CENTER: PARTY + BOX GRID ============ -->
            <DockPanel Grid.Column="1" Margin="16,12">

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !HasSave}" VerticalAlignment="Center" HorizontalAlignment="Center"
                            DockPanel.Dock="Top" Spacing="10" Margin="0,180,0,0">
                    <TextBlock Text="PKHeX for Mac" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Open a decrypted save file to begin — ⌘O" FontSize="14" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                    <Button Content="Open Save File…" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Click="OnOpenButtonClicked"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding HasSave}" DockPanel.Dock="Top">
                    <!-- Party -->
                    <StackPanel IsVisible="{Binding HasParty}">
                        <TextBlock Classes="sectionTitle" Text="PARTY"/>
                        <ItemsControl ItemsSource="{Binding PartySlots}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SlotViewModel">
                                    <Border Classes="slot" Classes.selected="{Binding IsSelected}"
                                            Width="84" Height="72"
                                            PointerPressed="OnSlotPressed"
                                            ToolTip.Tip="{Binding ToolTipText}">
                                        <Panel>
                                            <Image Source="{Binding Sprite}" Width="68" Height="56"
                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                            <Image Source="{Binding BallSprite}" Width="20" Height="20"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"/>
                                            <TextBlock Text="★" FontSize="11" Foreground="Gold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Margin="0,3,6,0" IsVisible="{Binding IsShiny}"/>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,12" Opacity="0.25"/>
                    </StackPanel>

                    <!-- Box header -->
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="‹" FontSize="16" Padding="10,2"
                                Command="{Binding PreviousBoxCommand}"/>
                        <Button DockPanel.Dock="Right" Content="›" FontSize="16" Padding="10,2"
                                Command="{Binding NextBoxCommand}"/>
                        <TextBlock Text="{Binding CurrentBoxName}"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Box grid -->
                    <ItemsControl ItemsSource="{Binding BoxSlots}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotViewModel">
                                <Border Classes="slot" Classes.selected="{Binding IsSelected}"
                                        Width="96" Height="80"
                                        PointerPressed="OnSlotPressed"
                                        ToolTip.Tip="{Binding ToolTipText}">
                                    <Panel>
                                        <Image Source="{Binding Sprite}" Width="68" Height="56"
                                               RenderOptions.BitmapInterpolationMode="None"/>
                                        <Image Source="{Binding BallSprite}" Width="20" Height="20"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"/>
                                        <TextBlock Text="★" FontSize="11" Foreground="Gold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,4,7,0" IsVisible="{Binding IsShiny}"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>

            <!-- ============ DETAIL PANE ============ -->
            <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Panel>
                    <TextBlock Text="Select a Pokémon" Opacity="0.4" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !Detail.HasPokemon}"/>

                    <ScrollViewer IsVisible="{Binding Detail.HasPokemon}">
                        <StackPanel Margin="16" Spacing="12" DataContext="{Binding Detail}">

                            <!-- Artwork + name -->
                            <Border CornerRadius="14" Padding="10"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                <StackPanel Spacing="6">
                                    <Image Source="{Binding Artwork}" Height="140"/>
                                    <DockPanel HorizontalAlignment="Center">
                                        <Image Source="{Binding BallSprite}" Width="22" Height="22" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SpeciesName}" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding GenderSymbol}" FontSize="16" Margin="6,0,0,0" Opacity="0.7"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding TypeText}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Legality -->
                            <Border CornerRadius="10" Padding="10"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="●" Foreground="LimeGreen" IsVisible="{Binding IsLegal}"/>
                                        <TextBlock Text="●" Foreground="OrangeRed" IsVisible="{Binding !IsLegal}"/>
                                        <TextBlock Text="Legal" FontWeight="SemiBold" IsVisible="{Binding IsLegal}"/>
                                        <TextBlock Text="Legality issues" FontWeight="SemiBold" IsVisible="{Binding !IsLegal}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LegalityReport}" FontSize="11" Opacity="0.65"
                                               TextWrapping="Wrap" IsVisible="{Binding !IsLegal}"/>
                                </StackPanel>
                            </Border>

                            <!-- Editable fields -->
                            <StackPanel Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="fieldLabel" Text="Nickname"/>
                                    <TextBox Text="{Binding Nickname, Mode=TwoWay}"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fieldLabel" Text="Level"/>
                                        <NumericUpDown Value="{Binding Level, Mode=TwoWay}" Minimum="1" Maximum="100"
                                                       FormatString="0" Increment="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <CheckBox IsChecked="{Binding IsShiny, Mode=TwoWay}" Content="Shiny ★"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Info rows -->
                            <Border CornerRadius="10" Padding="10"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                <StackPanel Spacing="5">
                                    <DockPanel>
                                        <TextBlock Classes="fieldLabel" Text="Nature" Width="80"/>
                                        <TextBlock Text="{Binding NatureName}" FontSize="12"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Classes="fieldLabel" Text="Ability" Width="80"/>
                                        <TextBlock Text="{Binding AbilityName}" FontSize="12"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Classes="fieldLabel" Text="Held Item" Width="80"/>
                                        <TextBlock Text="{Binding HeldItemName}" FontSize="12"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Classes="fieldLabel" Text="OT" Width="80"/>
                                        <TextBlock Text="{Binding OtName}" FontSize="12"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Classes="fieldLabel" Text="TID / SID" Width="80"/>
                                        <TextBlock Text="{Binding TidText}" FontSize="12"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Classes="fieldLabel" Text="PID" Width="80"/>
                                        <TextBlock Text="{Binding PidText}" FontSize="12" FontFamily="Menlo, monospace"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Moves -->
                            <StackPanel>
                                <TextBlock Classes="sectionTitle" Text="MOVES"/>
                                <ItemsControl ItemsSource="{Binding MoveNames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,2"
                                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                                <TextBlock Text="{Binding}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Stats -->
                            <StackPanel>
                                <TextBlock Classes="sectionTitle" Text="STATS  (IV / EV / TOTAL)"/>
                                <ItemsControl ItemsSource="{Binding Stats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatRowViewModel">
                                            <Grid ColumnDefinitions="70,40,40,40" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Opacity="0.6"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IV}" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding EV}" FontSize="12"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Stat}" FontSize="12" FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Apply -->
                            <Button Content="Apply Changes"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="{Binding IsDirty}"
                                    Classes="accent"
                                    Click="OnApplyClicked"/>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
