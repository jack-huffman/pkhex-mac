<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        xmlns:core="using:PKHeX.Core"
        xmlns:ctrl="using:PKHeX.Mac.Controls"
        xmlns:svc="using:PKHeX.Mac.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PKHeX.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1360" Height="860"
        MinWidth="1120" MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="46"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent, None"
        Background="Transparent"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="Open Save File…" Gesture="Cmd+O" Click="OnOpenClicked"/>
                    <NativeMenuItem Header="Find Saves on This Mac…" Gesture="Cmd+F" Click="OnFindSavesClicked"/>
                    <NativeMenuItem Header="Export Save As…" Gesture="Cmd+S" Click="OnExportClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Import Showdown Set from Clipboard" Gesture="Cmd+Shift+I" Click="OnShowdownImportClicked"/>
                    <NativeMenuItem Header="Copy Showdown Set to Clipboard" Gesture="Cmd+Shift+E" Click="OnShowdownExportClicked"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Trainer">
                <NativeMenu>
                    <NativeMenuItem Header="Trainer Info…" Gesture="Cmd+T" Click="OnTrainerClicked"/>
                    <NativeMenuItem Header="Bag / Items…" Gesture="Cmd+B" Click="OnBagClicked"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Tools">
                <NativeMenu>
                    <NativeMenuItem Header="Add Pokémon from Database…" Gesture="Cmd+D" Click="OnAddPokemonClicked"/>
                    <NativeMenuItem Header="Mystery Gift Database…" Gesture="Cmd+G" Click="OnGiftsClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Export Box to Folder…" Click="OnDumpBoxClicked"/>
                    <NativeMenuItem Header="Import Folder into Box…" Click="OnLoadFolderClicked"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Sort Current Box by Species" Click="OnSortBoxClicked"/>
                    <NativeMenuItem Header="Clear Current Box…" Click="OnClearBoxClicked"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="Cmd+OemOpenBrackets" Command="{Binding PreviousBoxCommand}"/>
        <KeyBinding Gesture="Cmd+OemCloseBrackets" Command="{Binding NextBoxCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:SlotViewModel">
            <Border Classes="slot" Classes.selected="{Binding IsSelected}"
                    Classes.dragover="{Binding IsDragOver}"
                    Width="94" Height="82"
                    PointerPressed="OnSlotPressed"
                    PointerMoved="OnSlotPointerMoved"
                    PointerReleased="OnSlotPointerReleased"
                    DragDrop.AllowDrop="True"
                    ToolTip.Tip="{Binding ToolTipText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="OnSlotCopyClicked"/>
                        <MenuItem Header="Paste" Click="OnSlotPasteClicked"/>
                        <MenuItem Header="Delete" Click="OnSlotDeleteClicked"/>
                        <Separator/>
                        <MenuItem Header="Import from File…" Click="OnSlotImportClicked"/>
                        <MenuItem Header="Export to File…" Click="OnSlotExportClicked"/>
                        <Separator/>
                        <MenuItem Header="Copy Showdown Set" Click="OnSlotShowdownClicked"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Panel>
                    <Image Source="{Binding Sprite}" Width="68" Height="56" Margin="0,2,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <Image Source="{Binding ShinyOverlay}" Width="20" Height="20" Margin="13,4,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0.8"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <Image Source="{Binding BallSprite}" Width="18" Height="18"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                    <TextBlock Text="{Binding LevelText}" FontSize="10" Classes="secondary"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5"/>
                </Panel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Frosted backdrop -->
    <Panel Background="{DynamicResource WindowBackdropBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
                <!-- Collapses to 0 for the full-width views -->
                <ColumnDefinition Width="{Binding InspectorWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ SIDEBAR (full height, translucent) ═══════════ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Traffic-light region / drag strip -->
                    <Border DockPanel.Dock="Top" Height="46" Background="Transparent"
                            PointerPressed="OnHeaderPressed"/>

                    <StackPanel DockPanel.Dock="Top" Margin="14,2,14,10" Spacing="10">
                        <!-- Trainer profile card -->
                        <Border Classes="card" Padding="14,12" IsVisible="{Binding HasSave}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding TrainerName}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GameName}" FontSize="12" Classes="secondary"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding GenerationText}" FontSize="10" Classes="secondary"/>
                                    </Border>
                                    <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding PlayTime}" FontSize="10" Classes="secondary"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding TrainerIds}" FontSize="10" Classes="secondary" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Navigation -->
                        <StackPanel Spacing="2" IsVisible="{Binding HasSave}">
                            <TextBlock Classes="sectionTitle" Text="SAVE" Margin="6,4,0,4"/>
                            <Button Classes="nav" Classes.selected="{Binding IsSaveView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="save"
                                    Content="Trainer &amp; Bag"/>
                            <Button Classes="nav" Classes.selected="{Binding IsDexView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="dex"
                                    Content="Pokédex"/>
                            <Button Classes="nav" Classes.selected="{Binding IsSearchView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="search"
                                    Content="Search"/>
                            <Button Classes="nav" Classes.selected="{Binding IsToolsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="tools"
                                    Content="Tools"/>
                            <Button Classes="nav" Classes.selected="{Binding IsFlagsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="flags"
                                    Content="Flags &amp; Blocks"/>
                            <Button Classes="nav" Classes.selected="{Binding IsRaidsView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="raids"
                                    Content="Raids"/>
                            <Button Classes="nav" Classes.selected="{Binding IsGameDataView}"
                                    Command="{Binding SetViewCommand}" CommandParameter="gamedata"
                                    Content="Game Data"/>

                        </StackPanel>

                        <TextBlock Classes="sectionTitle" Text="BOXES" IsVisible="{Binding HasSave}" Margin="6,6,0,0"/>
                    </StackPanel>

                    <!-- Box list. Tapped (not SelectionChanged) drives the view switch so
                         clicking the already-selected box still returns to the grid. -->
                    <ListBox Margin="10,0,10,10"
                             Opacity="{Binding BoxListOpacity}"
                             ItemsSource="{Binding BoxNames}"
                             SelectedIndex="{Binding CurrentBox, Mode=TwoWay}"
                             Tapped="OnBoxListTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Drop a dragged Pokémon here to move it to this box -->
                                <TextBlock Text="{Binding}" FontSize="13" Background="Transparent"
                                           PointerEntered="OnBoxNamePointerEntered"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══════════ MAIN AREA ═══════════ -->
            <DockPanel Grid.Column="1">


                <!-- Update banner -->
                <Border DockPanel.Dock="Top" Margin="18,0,18,10" Padding="14,8" CornerRadius="10"
                        IsVisible="{Binding ShowUpdateBanner}"
                        Background="{DynamicResource BannerBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" FontSize="12"
                                Background="Transparent" Foreground="White"
                                Command="{Binding DismissUpdateBannerCommand}"/>
                        <TextBlock Text="{Binding UpdateBannerText}" FontSize="12" Foreground="White"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Status line: quiet, out of the way, but edits still report here -->
                <Border DockPanel.Dock="Bottom" Padding="18,5" Background="Transparent">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Classes="secondary"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Grid>
                    <!-- ══════ CENTER: switched by sidebar navigation ══════ -->
                    <Panel>

                    <!-- Boxes view -->
                    <ScrollViewer IsVisible="{Binding ShowBoxes}" Padding="18,14,10,14">
                        <StackPanel>
                            <!-- Empty state -->
                            <StackPanel IsVisible="{Binding !HasSave}" HorizontalAlignment="Center"
                                        Spacing="10" Margin="0,170,0,0">
                                <ctrl:PokeBallIcon Width="58" Height="58" HorizontalAlignment="Center"
                                                   IconBrush="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="PKHeX for Mac" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open a decrypted save file (⌘O) or drop one anywhere in this window"
                                           FontSize="13" Classes="secondary" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                            Margin="0,12,0,0">
                                    <Button Content="Find My Saves" Classes="accent" Click="OnFindSavesButtonClicked"/>
                                    <Button Content="Open Save File…" Click="OnOpenButtonClicked"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasSave}" Spacing="14">
                                <!-- Party -->
                                <!-- Party sits in a card with the same padding and a 6-column grid,
                                     so its slots line up with the box grid below. -->
                                <StackPanel IsVisible="{Binding HasParty}" Spacing="6">
                                    <TextBlock Classes="sectionTitle" Text="PARTY" Margin="4,0,0,0"/>
                                    <Border Classes="card" Padding="12">
                                        <ItemsControl ItemsSource="{Binding PartySlots}" HorizontalAlignment="Center"
                                                      ItemTemplate="{StaticResource SlotTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <!-- Box card -->
                                <Border Classes="card" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Grid.Column="0" Content="‹" FontSize="15" Padding="10,2"
                                                    Command="{Binding PreviousBoxCommand}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentBoxName}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="›" FontSize="15" Padding="10,2"
                                                    Command="{Binding NextBoxCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding BoxSlots}" HorizontalAlignment="Center"
                                                      ItemTemplate="{StaticResource SlotTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════ FLAGS & BLOCKS view ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsFlagsView}" Margin="18,14,18,14">
                        <TabControl Padding="0,10,0,0">

                            <!-- Gen 2-5 style flat event flag array -->
                            <TabItem Header="Event Flags">
                                <DockPanel DataContext="{Binding EventFlags}" x:DataType="vm:EventFlagsViewModel"
                                           Margin="2,8,2,2">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="12"
                                               Classes="secondary" Margin="0,0,0,10"/>

                                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                                            Padding="14" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock Text="{Binding UnsupportedNote}" FontSize="13" TextWrapping="Wrap"
                                                   Classes="secondary"/>
                                    </Border>

                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                                          Margin="0,0,0,12" IsVisible="{Binding SupportsFlags}">
                                        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                                 Watermark="Search by flag number…"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SetOnly, Mode=TwoWay}"
                                                  Content="Set only" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Clear visible" FontSize="12"
                                                Command="{Binding ClearVisibleCommand}"/>
                                    </Grid>

                                    <ListBox Classes="plain" ItemsSource="{Binding Flags}"
                                             IsVisible="{Binding SupportsFlags}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EventFlagRowViewModel">
                                                <CheckBox Content="{Binding Label}" FontSize="11" Width="130"
                                                          IsChecked="{Binding Value, Mode=TwoWay}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>

                            <!-- Gen 8/9 SCBlock structure -->
                            <TabItem Header="Save Blocks">
                                <DockPanel DataContext="{Binding SaveBlocks}" x:DataType="vm:SaveBlocksViewModel"
                                           Margin="2,8,2,2">
                                    <Border DockPanel.Dock="Top" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                            Background="{DynamicResource IllegalBgBrush}"
                                            IsVisible="{Binding IsSupported}">
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource IllegalFgBrush}"
                                                   Text="Raw save data — nothing here is validated. These blocks replaced event flags in Gen 8/9; changing one can corrupt progress or trip anti-cheat. Your save is backed up automatically on export, but only edit blocks you understand."/>
                                    </Border>

                                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                                            Padding="14" Background="{DynamicResource SurfaceMutedBrush}">
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Classes="secondary"
                                                   Text="This save format does not use SCBlocks. Generations 8 and 9 (Sword/Shield, BDSP, Legends, Scarlet/Violet) do."/>
                                    </Border>

                                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10"
                                                IsVisible="{Binding IsSupported}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                                     Watermark="Search block name or hex key (e.g. KCurrentBox, WEVT_)…"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding NamedOnly, Mode=TwoWay}"
                                                      Content="Known names only" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding EditableOnly, Mode=TwoWay}"
                                                      Content="Editable only" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Reset" FontSize="12"
                                                    Command="{Binding ClearFiltersCommand}"/>
                                        </Grid>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontSize="11"
                                                       Classes="secondary"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CapNotice}" FontSize="11"
                                                       Classes="secondary" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="10" Margin="0,10,0,0"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            IsVisible="{Binding IsSupported}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="fieldLabel" Text="Back up or restore the selected block"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Export block…" FontSize="11" Padding="8,3"
                                                        Click="OnExportBlockClicked"/>
                                                <Button Content="Import block…" FontSize="11" Padding="8,3"
                                                        Click="OnImportBlockClicked"/>
                                                <TextBlock Text="{Binding SelectedName}" FontSize="10"
                                                           Classes="secondary" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding IoResult}" FontSize="10" Classes="secondary"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <ListBox Classes="plain" ItemsSource="{Binding Rows}" IsVisible="{Binding IsSupported}"
                                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScBlockRowViewModel">
                                                <Grid ColumnDefinitions="*,86,72,150" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Error}" FontSize="10"
                                                                   Foreground="{DynamicResource IllegalFgBrush}"
                                                                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding KeyText}" FontSize="10"
                                                               FontFamily="Menlo, monospace" Classes="secondary"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center"/>

                                                    <CheckBox Grid.Column="3" Content="Set" FontSize="11"
                                                              IsVisible="{Binding IsBoolean}"
                                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
                                                    <TextBox Grid.Column="3" FontSize="11" Height="24" Padding="6,2"
                                                             IsVisible="{Binding IsScalar}"
                                                             Text="{Binding TextValue, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding OpaqueText}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsOpaque}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- ══════ SEARCH view: this save, or a folder of Pokémon files ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsSearchView}" Margin="18,14,18,14">
                        <DockPanel DataContext="{Binding Search}" x:DataType="vm:SearchViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="17" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12"
                                           Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="240,*,Auto" ColumnSpacing="10">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SourceChoices}"
                                              SelectedIndex="{Binding SourceIndex, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FolderPath, Mode=TwoWay}"
                                             IsVisible="{Binding IsFolderSource}"
                                             Watermark="Folder containing .pk files (searched recursively)"/>
                                    <Button Grid.Column="2" Content="Choose folder…" FontSize="12"
                                            IsVisible="{Binding IsFolderSource}"
                                            Click="OnChooseSearchFolderClicked"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Text, Mode=TwoWay}"
                                             Watermark="Species, nickname or OT"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SpeciesChoices}"
                                              SelectedValue="{Binding SpeciesValue, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding NatureChoices}"
                                              SelectedValue="{Binding NatureValue, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MoveChoices}"
                                              SelectedValue="{Binding MoveValue, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>

                                    <ComboBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding BallChoices}"
                                              SelectedValue="{Binding BallValue, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="Lv" FontSize="11" Classes="secondary" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding MinLevel, Mode=TwoWay}" Minimum="1" Maximum="100"
                                                       FormatString="0" Increment="1" FontSize="11" ShowButtonSpinner="False"/>
                                        <TextBlock Grid.Column="2" Text="to" FontSize="11" Classes="secondary" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="3" Value="{Binding MaxLevel, Mode=TwoWay}" Minimum="1" Maximum="100"
                                                       FormatString="0" Increment="1" FontSize="11" ShowButtonSpinner="False"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="Min IV total" FontSize="11" Classes="secondary" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding MinIvTotal, Mode=TwoWay}" Minimum="0" Maximum="186"
                                                       FormatString="0" Increment="6" FontSize="11" ShowButtonSpinner="False"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                        <ComboBox HorizontalAlignment="Stretch" Width="86" FontSize="11"
                                                  ItemsSource="{Binding TriStateChoices}"
                                                  SelectedIndex="{Binding ShinyIndex, Mode=TwoWay}"
                                                  ToolTip.Tip="Shiny"/>
                                        <ComboBox HorizontalAlignment="Stretch" Width="86" FontSize="11"
                                                  ItemsSource="{Binding TriStateChoices}"
                                                  SelectedIndex="{Binding LegalIndex, Mode=TwoWay}"
                                                  ToolTip.Tip="Legal"/>
                                        <ComboBox HorizontalAlignment="Stretch" Width="76" FontSize="11"
                                                  ItemsSource="{Binding TriStateChoices}"
                                                  SelectedIndex="{Binding EggIndex, Mode=TwoWay}"
                                                  ToolTip.Tip="Egg"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Search" Classes="accent" Command="{Binding SearchCommand}"/>
                                    <Button Content="Reset filters" FontSize="12" Command="{Binding ResetCommand}"/>
                                    <TextBlock Text="Shiny · Legal · Egg filters are the three dropdowns above right."
                                               FontSize="10" Classes="secondary" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <ListBox Classes="plain" ItemsSource="{Binding Results}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SearchResultViewModel">
                                        <Grid ColumnDefinitions="46,150,*,190,60,110" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding Sprite}" Width="42" Height="36"
                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Species}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Nickname}" FontSize="10" Classes="secondary"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                                       Classes="secondary" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Location}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FullPath}"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="★" FontSize="12" Foreground="Gold"
                                                           IsVisible="{Binding IsShiny}"/>
                                                <TextBlock Text="✓" FontSize="12" IsVisible="{Binding IsLegal}"
                                                           Foreground="{DynamicResource LegalFgBrush}"/>
                                                <TextBlock Text="✕" FontSize="12" IsVisible="{Binding !IsLegal}"
                                                           Foreground="{DynamicResource IllegalFgBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="5" Content="Reveal" FontSize="11" Padding="8,2"
                                                    IsVisible="{Binding !IsFromFile}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToSearchResultCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="5" Content="Add to box" FontSize="11" Padding="8,2"
                                                    IsVisible="{Binding IsFromFile}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImportSearchResultCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- ══════ TERA RAIDS view ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsRaidsView}" Margin="18,14,18,14">
                        <DockPanel DataContext="{Binding Raids}" x:DataType="vm:RaidsViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Raids" FontSize="17"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12"
                                           Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                                    Padding="14" Background="{DynamicResource SurfaceMutedBrush}">
                                <TextBlock FontSize="13" TextWrapping="Wrap" Classes="secondary"
                                           Text="Raid data only exists in Sword/Shield and Scarlet/Violet."/>
                            </Border>

                            <TabControl IsVisible="{Binding IsSupported}" Padding="0,6,0,0">

                                <!-- ── Sword/Shield Max Raid nests ── -->
                                <TabItem Header="Max Raid Dens" IsVisible="{Binding IsSwsh}">
                                    <DockPanel Margin="2,8,2,2">
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="240,*" ColumnSpacing="12"
                                              Margin="0,0,0,10">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NestRegions}"
                                                      SelectedItem="{Binding SelectedNestRegion, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="1" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Text="Each den stores a 64-bit seed, a star tier and flags for rare, event and wishing-piece raids."/>
                                        </Grid>

                                        <Panel>
                                            <TextBlock IsVisible="{Binding !HasNests}" FontSize="13" Classes="secondary"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Text="This save has no raid nest blocks."/>
                                            <ContentControl Content="{Binding SelectedNestRegion}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:NestRegionViewModel">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Summary}" FontSize="11" Classes="secondary"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <CheckBox Content="Active only" FontSize="12"
                                                                              IsChecked="{Binding ActiveOnly, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"/>
                                                                    <CheckBox Content="as rare" FontSize="12"
                                                                              IsChecked="{Binding MakeRare, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              ToolTip.Tip="Applies to the Activate all action."/>
                                                                    <CheckBox Content="as event" FontSize="12"
                                                                              IsChecked="{Binding MakeEvent, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              ToolTip.Tip="Applies to the Activate all action."/>
                                                                    <Button Content="Activate all" FontSize="12"
                                                                            Command="{Binding ActivateAllCommand}"
                                                                            ToolTip.Tip="Turns on every den with a random tier and encounter roll. Skips the Watchtower, which the game handles specially."/>
                                                                    <Button Content="Deactivate all" FontSize="12"
                                                                            Command="{Binding DeactivateAllCommand}"/>
                                                                    <Button Content="Reset watts" FontSize="12"
                                                                            Command="{Binding ResetWattsCommand}"
                                                                            ToolTip.Tip="Clears the collected flag so every active den pays watts again."/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <ListBox Classes="plain" ItemsSource="{Binding Dens}"
                                                                     SelectedItem="{Binding SelectedDen, Mode=TwoWay}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:NestRowViewModel">
                                                                        <Grid ColumnDefinitions="130,58,70,74,110,160,86"
                                                                              ColumnSpacing="8">
                                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <CheckBox Grid.Column="1" Content="Up" FontSize="11"
                                                                                      IsChecked="{Binding Active, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"/>
                                                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                                                                                      FontSize="11"
                                                                                      ItemsSource="{Binding StarChoices}"
                                                                                      SelectedIndex="{Binding StarIndex, Mode=TwoWay}"/>
                                                                            <CheckBox Grid.Column="3" Content="Rare" FontSize="11"
                                                                                      IsChecked="{Binding IsRare, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"/>
                                                                            <CheckBox Grid.Column="4" Content="Wishing" FontSize="11"
                                                                                      IsChecked="{Binding IsWishingPiece, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"/>
                                                                            <TextBox Grid.Column="5" Text="{Binding SeedText, Mode=TwoWay}"
                                                                                     FontSize="11" FontFamily="Menlo, monospace"
                                                                                     ToolTip.Tip="Raid seed (64-bit hex)"/>
                                                                            <CheckBox Grid.Column="6" Content="Watts" FontSize="11"
                                                                                      IsChecked="{Binding WattsHarvested, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"
                                                                                      ToolTip.Tip="Watts already collected from this den."/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </Panel>
                                    </DockPanel>
                                </TabItem>

                                <!-- ── Live raid crystals, per region ── -->
                                <TabItem Header="Active Dens" IsVisible="{Binding IsSv}">
                                    <DockPanel Margin="2,8,2,2">
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="240,*" ColumnSpacing="12"
                                              Margin="0,0,0,10">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding Regions}"
                                                      SelectedItem="{Binding SelectedRegion, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="1" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Text="Each crystal has its own 32-bit seed and tier. The region seeds below drive today's and tomorrow's line-up."/>
                                        </Grid>

                                        <Panel>
                                            <TextBlock IsVisible="{Binding !HasRegions}" FontSize="13" Classes="secondary"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Text="This save has no raid crystal blocks — they appear once the game has generated its first daily raids."/>
                                            <ContentControl Content="{Binding SelectedRegion}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:RaidRegionViewModel">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Summary}" FontSize="11" Classes="secondary"/>
                                                                <Grid ColumnDefinitions="Auto,170,Auto,170" ColumnSpacing="8"
                                                                      IsVisible="{Binding HasSeeds}">
                                                                    <TextBlock Grid.Column="0" Text="Today" FontSize="11"
                                                                               Classes="secondary" VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding CurrentSeedText, Mode=TwoWay}"
                                                                             FontSize="11" FontFamily="Menlo, monospace"/>
                                                                    <TextBlock Grid.Column="2" Text="Tomorrow" FontSize="11"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               Margin="8,0,0,0"/>
                                                                    <TextBox Grid.Column="3" Text="{Binding TomorrowSeedText, Mode=TwoWay}"
                                                                             FontSize="11" FontFamily="Menlo, monospace"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding SeedError}" FontSize="11"
                                                                           Foreground="{DynamicResource IllegalFgBrush}"
                                                                           IsVisible="{Binding SeedError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <CheckBox Content="Placed dens only" FontSize="12"
                                                                              IsChecked="{Binding ActiveOnly, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"/>
                                                                    <Button Content="Copy selected den to all" FontSize="12"
                                                                            Command="{Binding PropagateSelectedCommand}"
                                                                            ToolTip.Tip="Writes the selected den's tier and seed onto every placed den in this region."/>
                                                                    <Button Content="Enable all placed" FontSize="12"
                                                                            Command="{Binding EnableAllPlacedCommand}"/>
                                                                    <Button Content="Unclaim all LP" FontSize="12"
                                                                            Command="{Binding UnclaimAllPointsCommand}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <ListBox Classes="plain" ItemsSource="{Binding Dens}"
                                                                     SelectedItem="{Binding SelectedDen, Mode=TwoWay}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:DenRowViewModel">
                                                                        <Grid ColumnDefinitions="62,180,64,190,120,Auto" ColumnSpacing="10">
                                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding PlaceText}" FontSize="11"
                                                                                       Classes="secondary" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <CheckBox Grid.Column="2" Content="Up" FontSize="11"
                                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"
                                                                                      ToolTip.Tip="Is the raid crystal currently active?"/>
                                                                            <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                                                                      FontSize="11"
                                                                                      ItemsSource="{Binding ContentChoices}"
                                                                                      SelectedIndex="{Binding ContentIndex, Mode=TwoWay}"/>
                                                                            <TextBox Grid.Column="4" Text="{Binding SeedText, Mode=TwoWay}"
                                                                                     FontSize="11" FontFamily="Menlo, monospace"
                                                                                     ToolTip.Tip="Raid seed (32-bit hex)"/>
                                                                            <CheckBox Grid.Column="5" Content="LP taken" FontSize="11"
                                                                                      IsChecked="{Binding ClaimedLeaguePoints, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </Panel>
                                    </DockPanel>
                                </TabItem>

                                <!-- ── Seven-star event capture records ── -->
                                <TabItem Header="Event Records" IsVisible="{Binding IsSv}">
                                    <DockPanel Margin="2,8,2,2">
                                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding EmptyNote}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource IllegalFgBrush}"
                                                       IsVisible="{Binding EmptyNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                                       Text="Clearing a capture flag lets that event raid be caught again. Defeated marks it as beaten without granting a catch."/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CheckBox IsChecked="{Binding UsedOnly, Mode=TwoWay}" Content="Used slots only"
                                                          VerticalAlignment="Center"/>
                                                <Button Content="Allow re-catch on all" FontSize="12"
                                                        Command="{Binding AllowRecatchAllCommand}"/>
                                                <Button Content="Mark all defeated" FontSize="12"
                                                        Command="{Binding MarkAllDefeatedCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ListBox Classes="plain" ItemsSource="{Binding Rows}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RaidRowViewModel">
                                                    <Grid ColumnDefinitions="*,120,120" ColumnSpacing="10">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                   FontFamily="Menlo, monospace" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" Content="Captured" FontSize="12"
                                                                  IsChecked="{Binding Captured, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Column="2" Content="Defeated" FontSize="12"
                                                                  IsChecked="{Binding Defeated, Mode=TwoWay}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>

                                <!-- ── Tier unlocks and win tallies ── -->
                                <TabItem Header="Progression" IsVisible="{Binding IsSv}">
                                    <ScrollViewer Margin="2,8,2,2">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <TextBlock Classes="sectionTitle" Text="TIERS UNLOCKED" Margin="0"/>
                                                <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                                           Text="A tier must be unlocked before the game will generate raids of that difficulty."/>
                                                <ItemsControl ItemsSource="{Binding Unlocks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RaidFlagViewModel">
                                                            <CheckBox Content="{Binding Label}" FontSize="12"
                                                                      IsChecked="{Binding Value, Mode=TwoWay}" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Classes="sectionTitle" Text="RAIDS WON" Margin="0"/>
                                                <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                                           Text="Win counts the game uses to decide when to raise the raid difficulty."/>
                                                <ItemsControl ItemsSource="{Binding Counters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RaidCounterViewModel">
                                                            <Grid ColumnDefinitions="*,150" ColumnSpacing="8" Margin="0,2">
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                           VerticalAlignment="Center"/>
                                                                <!-- Wide enough that the spinner buttons don't crush the text field -->
                                                                <NumericUpDown Grid.Column="1" MinWidth="140"
                                                                               Value="{Binding Value, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="99999" FormatString="0"
                                                                               Increment="1" FontSize="12"
                                                                               HorizontalContentAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>

                    <!-- ══════ GAME DATA view: daycare, gift album, per-generation structures ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsGameDataView}" Margin="18,14,18,14">
                        <TabControl Padding="0,6,0,0">

                            <!-- ── Daycare ── -->
                            <TabItem Header="Daycare">
                            <DockPanel DataContext="{Binding Daycare}" x:DataType="vm:DaycareViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="This save has no daycare that PKHeX can read. Gen 1 through 7 and BDSP do; Sword/Shield and Scarlet/Violet handle breeding without a stored daycare."/>

                                <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14"
                                            IsVisible="{Binding IsSupported}">
                                    <ComboBox HorizontalAlignment="Left" MinWidth="200"
                                              IsVisible="{Binding HasMultipleUnits}"
                                              ItemsSource="{Binding Units}"
                                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="An egg is waiting" FontSize="12"
                                                  IsVisible="{Binding HasEggState}"
                                                  IsChecked="{Binding EggAvailable, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding HasSeed}">
                                            <TextBlock Text="Egg seed" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SeedText, Mode=TwoWay}" MinWidth="180"
                                                     FontSize="11" FontFamily="Menlo, monospace"/>
                                            <TextBlock Text="{Binding SeedError}" FontSize="10"
                                                       Foreground="{DynamicResource IllegalFgBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="Transfers use whichever box slot is selected in the Boxes view — move a parent into a box to edit it with the full inspector, then board it again."/>
                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                               Foreground="{DynamicResource LegalFgBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <ContentControl Content="{Binding SelectedUnit}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="vm:DaycareUnitViewModel">
                                                <ItemsControl ItemsSource="{Binding Parents}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DaycareSlotViewModel">
                                                            <Border Classes="card" Padding="12" Margin="0,0,0,10">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                                    <Panel Grid.Column="0" Width="72" Height="60">
                                                                        <Image Source="{Binding Sprite}" Stretch="Uniform"
                                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                                    </Panel>
                                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding SpeciesName}" FontSize="15"
                                                                                       FontWeight="Bold"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                                                   Classes="secondary"/>
                                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                                            <CheckBox Content="Boarded" FontSize="11"
                                                                                      IsChecked="{Binding Occupied, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"
                                                                                      ToolTip.Tip="The game only counts a parent that is marked boarded."/>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                                        IsVisible="{Binding HasExperience}">
                                                                                <TextBlock Text="Banked EXP" FontSize="11"
                                                                                           Classes="secondary" VerticalAlignment="Center"/>
                                                                                <NumericUpDown MinWidth="130" FontSize="11"
                                                                                               Value="{Binding Experience, Mode=TwoWay}"
                                                                                               Minimum="0" Maximum="9999999"
                                                                                               FormatString="0" Increment="1"
                                                                                               HorizontalContentAlignment="Right"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                                                                        <Button Content="Copy to box slot" FontSize="11"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Center"
                                                                                Command="{Binding CopyToBoxCommand}"/>
                                                                        <Button Content="Board from box slot" FontSize="11"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Center"
                                                                                Command="{Binding TakeFromBoxCommand}"/>
                                                                        <Button Content="Clear" FontSize="11"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Center"
                                                                                Command="{Binding ClearSlotCommand}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Mystery Gift album ── -->
                            <TabItem Header="Gift Album">
                            <DockPanel DataContext="{Binding GiftAlbum}" x:DataType="vm:GiftAlbumViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="This save keeps no Mystery Gift album. Gen 4 through 7 and Let's Go store the wondercards themselves; Gen 8 and 9 moved to server-delivered records, so there is nothing to write. The Mystery Gifts database can still turn a gift into a Pokémon."/>

                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="Writing a card here puts the gift in the game's own delivery list, so it can be collected in-game rather than injected as a finished Pokémon. Only cards matching this game's format are offered."/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Write gift into card slot" Classes="accent" FontSize="12"
                                                Command="{Binding InjectSelectedCommand}"/>
                                        <Button Content="Clear card slot" FontSize="12"
                                                Command="{Binding ClearSelectedCommand}"/>
                                        <Button Content="Clear received flags" FontSize="12"
                                                IsVisible="{Binding HasFlags}"
                                                Command="{Binding ClearReceivedFlagsCommand}"
                                                ToolTip.Tip="Lets the game hand out gifts it thinks you already claimed."/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource LegalFgBrush}"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <Grid IsVisible="{Binding IsSupported}" ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <DockPanel Grid.Column="0">
                                        <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="CARD SLOTS IN THIS SAVE"
                                                   Margin="0,0,0,6"/>
                                        <ListBox Classes="plain" ItemsSource="{Binding Cards}"
                                                 SelectedItem="{Binding SelectedCard, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GiftCardViewModel">
                                                    <Grid ColumnDefinitions="52,34,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                                   Classes="secondary" VerticalAlignment="Center"/>
                                                        <Image Grid.Column="1" Source="{Binding Sprite}" Width="30" Height="26"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                        <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="9" Classes="secondary"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>

                                    <DockPanel Grid.Column="1">
                                        <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="GIFTS THIS GAME ACCEPTS"
                                                   Margin="0,0,0,6"/>
                                        <TextBox DockPanel.Dock="Top" Text="{Binding CandidateFilter, Mode=TwoWay}"
                                                 FontSize="12" Watermark="Search gifts…" Margin="0,0,0,6"/>
                                        <ListBox Classes="plain" ItemsSource="{Binding Candidates}"
                                                 SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GiftCandidate">
                                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="8">
                                                        <Image Grid.Column="0" Source="{Binding Sprite}" Width="30" Height="26"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Hall of Fame ── -->
                            <TabItem Header="Hall of Fame">
                            <DockPanel DataContext="{Binding HallOfFame}" x:DataType="vm:HallOfFameViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="No readable Hall of Fame record in this save. Gen 1, Gen 3 and Gen 6 keep the teams you won with; other generations store only the time of your first clear, which appears in the Extras tab as SecondsToFame."/>

                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="A record of past wins rather than live state, so it is shown as history. Entries can be cleared where the format allows it."/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox Content="Recorded entries only" FontSize="12"
                                                  IsChecked="{Binding UsedOnly, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <Button Content="Clear selected entry" FontSize="12"
                                                IsVisible="{Binding CanClear}"
                                                Command="{Binding ClearSelectedCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource LegalFgBrush}"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <ListBox Classes="plain" ItemsSource="{Binding Visible}"
                                             SelectedItem="{Binding SelectedTeam, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FameTeamViewModel">
                                                <StackPanel Spacing="4" Margin="0,3">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding Members}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FameMemberViewModel">
                                                                <StackPanel Width="104" Spacing="1" Margin="0,0,6,6">
                                                                    <Image Source="{Binding Sprite}" Width="56" Height="48"
                                                                           HorizontalAlignment="Center"
                                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                                    <TextBlock Text="{Binding SpeciesName}" FontSize="11"
                                                                               HorizontalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Nickname}" FontSize="9"
                                                                               Classes="secondary" HorizontalAlignment="Center"
                                                                               IsVisible="{Binding HasNickname}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding LevelText}" FontSize="9"
                                                                               Classes="secondary" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Mail ── -->
                            <TabItem Header="Mail">
                            <DockPanel DataContext="{Binding Mail}" x:DataType="vm:MailViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="This save keeps no mail. Gen 2 through 5 store mail in the mailbox and on party members; later generations dropped the feature."/>

                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="Mail held by a party member is stored inside that Pokémon, so editing it re-saves the party slot. Gen 4 and 5 write their messages as word codes rather than text, so only the stationery, author and pictured Pokémon are editable there."/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox Content="In-use slots only" FontSize="12"
                                                  IsChecked="{Binding UsedOnly, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <Button Content="Clear all mail" FontSize="12"
                                                Command="{Binding ClearAllCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource LegalFgBrush}"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <ItemsControl ItemsSource="{Binding Visible}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MailRowViewModel">
                                                <Border Classes="card" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel Spacing="7">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Image Grid.Column="1" Source="{Binding Sprite}" Width="34" Height="28"
                                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SpeciesName}" FontSize="11"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="10"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="4" Content="Clear" FontSize="11"
                                                                    Command="{Binding ClearCommand}"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,150,Auto,100,Auto,100" ColumnSpacing="8">
                                                            <TextBlock Grid.Column="0" Text="From" FontSize="11"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="1" Text="{Binding AuthorName, Mode=TwoWay}"
                                                                     FontSize="11"/>
                                                            <TextBlock Grid.Column="2" Text="TID" FontSize="11"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="3" Text="{Binding AuthorTid, Mode=TwoWay}"
                                                                     FontSize="11"/>
                                                            <TextBlock Grid.Column="4" Text="SID" FontSize="11"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="5" Text="{Binding AuthorSid, Mode=TwoWay}"
                                                                     FontSize="11"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,100,Auto,100,*" ColumnSpacing="8">
                                                            <TextBlock Grid.Column="0" Text="Pictured species" FontSize="11"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="1" Text="{Binding AppearSpecies, Mode=TwoWay}"
                                                                     FontSize="11"/>
                                                            <TextBlock Grid.Column="2" Text="Stationery" FontSize="11"
                                                                       Classes="secondary" VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="3" Text="{Binding MailType, Mode=TwoWay}"
                                                                     FontSize="11"/>
                                                        </Grid>
                                                        <StackPanel Spacing="3" IsVisible="{Binding SupportsText}">
                                                            <TextBlock Text="Message" FontSize="11" Classes="secondary"/>
                                                            <TextBox Text="{Binding MessageText, Mode=TwoWay}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Generic per-generation structures ── -->
                            <TabItem Header="Extras">
                            <DockPanel DataContext="{Binding Extras}" x:DataType="vm:GameExtrasViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="No editable structures were found in this save."/>
                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="The game-specific structures that have no dedicated screen here — things like the Key System, Entralink pass powers, Global Link, Battle Subway, game settings and daily counters. Values are written straight through with no validation, so treat this as a power tool."/>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                                 FontSize="12" Watermark="Search structures and fields…"/>
                                        <CheckBox Grid.Column="1" Content="With a value" FontSize="12"
                                                  IsChecked="{Binding NonZeroOnly, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Reset" FontSize="12"
                                                Command="{Binding ClearFiltersCommand}"/>
                                    </Grid>
                                </StackPanel>

                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExtrasGroupViewModel">
                                                <StackPanel Spacing="5" Margin="0,0,0,16">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding TypeName}" FontSize="10" Classes="secondary"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Visible}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ExtrasFieldViewModel">
                                                                <Grid ColumnDefinitions="230,190,*" ColumnSpacing="10"
                                                                      Margin="0,0,0,3">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <CheckBox Grid.Column="1" IsVisible="{Binding IsBoolean}"
                                                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="1" IsVisible="{Binding IsEnumeration}"
                                                                              HorizontalAlignment="Stretch" FontSize="11"
                                                                              ItemsSource="{Binding EnumNames}"
                                                                              SelectedIndex="{Binding EnumIndex, Mode=TwoWay}"/>
                                                                    <TextBox Grid.Column="1" IsVisible="{Binding IsInteger}"
                                                                             Text="{Binding TextValue, Mode=TwoWay}"
                                                                             FontSize="11" FontFamily="Menlo, monospace"/>
                                                                    <TextBox Grid.Column="1" IsVisible="{Binding IsText}"
                                                                             Text="{Binding TextValue, Mode=TwoWay}"
                                                                             FontSize="11"/>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding TypeName}" FontSize="9"
                                                                                   Classes="secondary"/>
                                                                        <TextBlock Text="{Binding Error}" FontSize="10"
                                                                                   Foreground="{DynamicResource IllegalFgBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- ══════ TOOLS view: batch editor + box report ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsToolsView}" Margin="18,14,18,14">
                        <TabControl DataContext="{Binding Tools}" x:DataType="vm:ToolsViewModel" Padding="0,10,0,0">

                            <TabItem Header="Batch Edit">
                                <DockPanel Margin="2,8,2,2">
                                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                                        <TextBlock Text="Apply property changes to many Pokémon at once."
                                                   FontSize="13" Classes="secondary"/>
                                        <Grid ColumnDefinitions="200,Auto,*" ColumnSpacing="10">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ScopeChoices}"
                                                      SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}"/>
                                            <Button Grid.Column="1" Content="Run" Classes="accent"
                                                    Command="{Binding RunBatchCommand}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding BatchResult}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>

                                    <Grid ColumnDefinitions="*,320" ColumnSpacing="12" Margin="0,10,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding Instructions, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Menlo, monospace" FontSize="12"
                                                 VerticalContentAlignment="Top"
                                                 Watermark=".Nature=Adamant"/>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="12"
                                                Background="{DynamicResource SurfaceMutedBrush}">
                                            <TextBlock Text="{Binding BatchHelp}" FontSize="11"
                                                       FontFamily="Menlo, monospace" Classes="secondary"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Team Analysis">
                            <DockPanel DataContext="{Binding Team}" x:DataType="vm:TeamAnalysisViewModel"
                                       Margin="2,8,2,2">
                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="180,Auto,*" ColumnSpacing="10">
                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ScopeChoices}"
                                                  SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}"/>
                                        <Button Grid.Column="1" Content="Refresh" FontSize="12"
                                                Command="{Binding RefreshCommand}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Text="{Binding EraNote}" FontSize="10" Classes="secondary"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="10" Classes="secondary" TextWrapping="Wrap"
                                               Text="Immunity and damage-reducing abilities are applied. Held items, terrain and move-specific exceptions are not."/>
                                </StackPanel>

                                <ScrollViewer>
                                    <StackPanel Spacing="16">

                                        <!-- What to fix first -->
                                        <StackPanel Spacing="5" IsVisible="{Binding HasFindings}">
                                            <TextBlock Classes="sectionTitle" Text="WHAT TO FIX FIRST" Margin="0"/>
                                            <ItemsControl ItemsSource="{Binding Findings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                                   Margin="0,1"
                                                                   Foreground="{DynamicResource IllegalFgBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- The team -->
                                        <StackPanel Spacing="5" IsVisible="{Binding HasMembers}">
                                            <TextBlock Classes="sectionTitle" Text="THE TEAM" Margin="0"/>
                                            <ItemsControl ItemsSource="{Binding Members}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TeamMemberViewModel">
                                                        <Border Classes="card" Padding="10" Margin="0,0,8,8" Width="250">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <Image Grid.Column="0" Source="{Binding Sprite}"
                                                                       Width="56" Height="48" VerticalAlignment="Top"
                                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding SpeciesName}" FontSize="13"
                                                                                   FontWeight="Bold"/>
                                                                        <TextBlock Text="{Binding LevelText}" FontSize="10"
                                                                                   Classes="secondary" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Image Source="{Binding Type1Icon}" Width="18" Height="18"
                                                                               IsVisible="{Binding HasType1Icon}"
                                                                               ToolTip.Tip="{Binding Type1Name}"/>
                                                                        <Image Source="{Binding Type2Icon}" Width="18" Height="18"
                                                                               IsVisible="{Binding HasType2Icon}"
                                                                               ToolTip.Tip="{Binding Type2Name}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <TextBlock Text="{Binding AbilityName}" FontSize="10"
                                                                                   Classes="secondary"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="★" FontSize="9"
                                                                                   IsVisible="{Binding AbilityMatters}"
                                                                                   Foreground="{DynamicResource LegalFgBrush}"
                                                                                   ToolTip.Tip="This ability changes incoming damage and is included in the analysis."
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding WeakTo, StringFormat='weak to {0}'}"
                                                                               FontSize="9" Classes="secondary"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Defensive grid: members down, attacking types across.
                                             Every strip is an ItemsControl over a fixed 40px cell so the
                                             header, body and totals stay aligned without a real Grid. -->
                                        <StackPanel Spacing="5" IsVisible="{Binding HasMembers}">
                                            <TextBlock Classes="sectionTitle" Text="TAKING HITS" Margin="0"/>
                                            <TextBlock FontSize="10" Classes="secondary" TextWrapping="Wrap"
                                                       Text="Incoming damage per member. Blank means normal damage; a red type name means two or more are weak to it and nothing resists it."/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <StackPanel Spacing="0">

                                                    <!-- Header -->
                                                    <Grid ColumnDefinitions="176,Auto" Margin="0,0,0,4">
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:MatrixColumnViewModel">
                                                                    <Border Width="40" Padding="0,2"
                                                                            ToolTip.Tip="{Binding Tooltip}">
                                                                        <StackPanel Spacing="1">
                                                                            <Image Source="{Binding TypeIcon}"
                                                                                   Width="20" Height="20"
                                                                                   IsVisible="{Binding HasIcon}"
                                                                                   HorizontalAlignment="Center"/>
                                                                            <Ellipse Width="4" Height="4"
                                                                                     HorizontalAlignment="Center"
                                                                                     Fill="{Binding HeaderBrush}"
                                                                                     IsVisible="{Binding IsSharedWeakness}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <!-- One row per member -->
                                                    <ItemsControl ItemsSource="{Binding Members}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TeamMemberViewModel">
                                                                <Grid ColumnDefinitions="176,Auto" Margin="0,0,0,2">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                                Spacing="6" VerticalAlignment="Center">
                                                                        <Image Source="{Binding Sprite}" Width="34" Height="28"
                                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                                        <TextBlock Text="{Binding SpeciesName}" FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:MatrixCellViewModel">
                                                                                <Border Width="40" Height="28" Margin="0,0,1,0"
                                                                                        CornerRadius="4"
                                                                                        Background="{Binding Background}"
                                                                                        ToolTip.Tip="{Binding Tooltip}">
                                                                                    <TextBlock Text="{Binding Text}" FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{Binding Foreground}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Separator Margin="0,4"/>

                                                    <!-- Totals -->
                                                    <Grid ColumnDefinitions="176,Auto">
                                                        <TextBlock Grid.Column="0" Text="weak" FontSize="10"
                                                                   Classes="secondary" VerticalAlignment="Center"/>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:MatrixColumnViewModel">
                                                                    <TextBlock Width="40" Text="{Binding WeakText}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{Binding WeakBrush}"
                                                                               TextAlignment="Center"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="176,Auto" Margin="0,2,0,0">
                                                        <TextBlock Grid.Column="0" Text="resist or immune" FontSize="10"
                                                                   Classes="secondary" VerticalAlignment="Center"/>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:MatrixColumnViewModel">
                                                                    <TextBlock Width="40" Text="{Binding ResistText}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{Binding ResistBrush}"
                                                                               TextAlignment="Center"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <!-- Offensive coverage -->
                                        <StackPanel Spacing="5" IsVisible="{Binding CoverageAvailable}">
                                            <TextBlock Classes="sectionTitle" Text="DEALING DAMAGE — GAPS FIRST" Margin="0"/>
                                            <TextBlock FontSize="10" Classes="secondary" TextWrapping="Wrap"
                                                       Text="The best multiplier any damaging move on the team reaches against each type."/>
                                            <ItemsControl ItemsSource="{Binding Coverage}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CoverageRowViewModel">
                                                        <Grid ColumnDefinitions="24,80,70,*,110" ColumnSpacing="8"
                                                              Margin="0,0,0,4">
                                                            <Image Grid.Column="0" Source="{Binding TypeIcon}"
                                                                   Width="18" Height="18"
                                                                   IsVisible="{Binding HasIcon}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="12"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding BestText}" FontSize="11"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Foreground="{Binding VerdictBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="10"
                                                                       Classes="secondary" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Verdict}" FontSize="10"
                                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{Binding VerdictBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <TabItem Header="Breeding">
                            <DockPanel DataContext="{Binding Breeding}" x:DataType="vm:BreedingViewModel"
                                       Margin="2,8,2,2">
                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="320,Auto,*" ColumnSpacing="10">
                                        <AutoCompleteBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                         ItemsSource="{Binding SpeciesOptions}"
                                                         SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
                                                         FilterMode="Contains" MinimumPrefixLength="1"
                                                         MaxDropDownHeight="320"
                                                         Watermark="Which Pokémon are you breeding?">
                                            <AutoCompleteBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpeciesChoice">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{Binding Sprite}" Width="34" Height="28"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button Grid.Column="1" Content="Clear" FontSize="12"
                                                Command="{Binding ClearCommand}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding InheritanceNote}" FontSize="10"
                                                   Classes="secondary" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Grid>

                                    <Border Classes="card" Padding="12" IsVisible="{Binding HasSpecies}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Image Grid.Column="0" Source="{Binding Sprite}" Width="62" Height="52"
                                                   VerticalAlignment="Top"
                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding GenderText}" FontSize="11" Classes="secondary"/>
                                                <TextBlock Text="{Binding HatchText}" FontSize="11" Classes="secondary"
                                                           IsVisible="{Binding HatchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBlock Text="{Binding BlockedReason}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource IllegalFgBrush}"
                                                           IsVisible="{Binding IsBlocked}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock FontSize="12" Classes="secondary" TextWrapping="Wrap"
                                               IsVisible="{Binding !HasSpecies}"
                                               Text="Pick a species to see its egg groups, the egg moves it can be bred with in this game, and which partners can actually pass each one. Egg move lists differ a lot between games, so this always uses the open save's own data."/>
                                </StackPanel>

                                <Grid IsVisible="{Binding HasEggMoves}" ColumnDefinitions="320,*" ColumnSpacing="14">
                                    <DockPanel Grid.Column="0">
                                        <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="EGG MOVES"
                                                   Margin="0,0,0,6"/>
                                        <ListBox Classes="plain" ItemsSource="{Binding EggMoves}"
                                                 SelectedItem="{Binding SelectedEggMove, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EggMoveViewModel">
                                                    <Grid ColumnDefinitions="22,22,*" ColumnSpacing="6" Margin="0,2">
                                                        <Image Grid.Column="0" Source="{Binding TypeIcon}"
                                                               Width="18" Height="18"
                                                               IsVisible="{Binding HasTypeIcon}"
                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                        <ctrl:MoveCategoryIcon Grid.Column="1"
                                                                               Category="{Binding CategoryKind}"
                                                                               Width="18" Height="18"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="9"
                                                                       Classes="secondary"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>

                                    <DockPanel Grid.Column="1">
                                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
                                            <TextBlock Classes="sectionTitle" Text="WHO CAN PASS IT" Margin="0"/>
                                            <TextBlock Text="{Binding PartnerSummary}" FontSize="11"
                                                       Classes="secondary" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ListBox Classes="plain" ItemsSource="{Binding Partners}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PartnerViewModel">
                                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                        <Image Grid.Column="0" Source="{Binding Sprite}"
                                                               Width="34" Height="28"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding How}" FontSize="10"
                                                                   Classes="secondary" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                            </TabItem>

                            <TabItem Header="Box Report">
                                <DockPanel Margin="2,8,2,2">
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                                          Margin="0,0,0,10">
                                        <TextBox Grid.Column="0" Text="{Binding ReportSearch, Mode=TwoWay}"
                                                 Watermark="Search species, nickname, OT, nature, ability…"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IllegalOnly, Mode=TwoWay}"
                                                  Content="Issues only" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Copy as TSV" FontSize="12"
                                                Click="OnCopyReportClicked"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReportSummary}" FontSize="12"
                                               Classes="secondary" Margin="0,8,0,0"/>

                                    <!-- Header row -->
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="44,110,120,120,46,90,140,120,64,58"
                                          ColumnSpacing="8" Margin="6,0,6,6">
                                        <TextBlock Grid.Column="1" Text="Species" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="2" Text="Nickname" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="3" Text="Box · slot" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="4" Text="Lv" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="5" Text="Nature" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="6" Text="Ability" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="7" Text="IVs" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="8" Text="Shiny" FontSize="10" Classes="secondary"/>
                                        <TextBlock Grid.Column="9" Text="Legal" FontSize="10" Classes="secondary"/>
                                    </Grid>

                                    <ListBox ItemsSource="{Binding ReportRows}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReportRowViewModel">
                                                <Grid ColumnDefinitions="44,110,120,120,46,90,140,120,64,58"
                                                      ColumnSpacing="8">
                                                    <Image Grid.Column="0" Source="{Binding Sprite}" Width="40" Height="34"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Species}" FontSize="12"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Nickname}" FontSize="12"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" FontSize="11" Classes="secondary"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding BoxName}"/><Run Text=" · "/><Run Text="{Binding SlotText}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4" Text="{Binding Level}" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Nature}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Ability}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding Ivs}" FontSize="11"
                                                               FontFamily="Menlo, monospace" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="★" FontSize="12" Foreground="Gold"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsShiny}"/>
                                                    <TextBlock Grid.Column="9" Text="✓" FontSize="12"
                                                               Foreground="{DynamicResource LegalFgBrush}"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsLegal}"/>
                                                    <TextBlock Grid.Column="9" Text="✕" FontSize="12"
                                                               Foreground="{DynamicResource IllegalFgBrush}"
                                                               VerticalAlignment="Center" IsVisible="{Binding !IsLegal}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- ══════ POKÉDEX view ══════ -->
                    <Border Classes="card" IsVisible="{Binding IsDexView}" Margin="18,14,18,14">
                        <DockPanel DataContext="{Binding Dex}" x:DataType="vm:PokedexViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Pokédex" FontSize="17" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12"
                                           Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                       Text="This save format does not expose an editable Pokédex."
                                       Classes="fieldLabel"/>

                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" Margin="0,0,0,12" IsVisible="{Binding IsSupported}">
                                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Search by name or number…"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding MissingOnly, Mode=TwoWay}"
                                          Content="Missing only" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding ShinyToo, Mode=TwoWay}"
                                          Content="Include shiny" VerticalAlignment="Center"
                                          ToolTip.Tip="Also register the shiny form when marking an entry caught"/>
                                <Button Grid.Column="3" Content="Register owned" FontSize="12"
                                        ToolTip.Tip="Mark every species currently in your boxes and party as caught"
                                        Command="{Binding RegisterOwnedCommand}"/>
                                <Button Grid.Column="4" Content="Complete dex" FontSize="12"
                                        Command="{Binding CompleteDexCommand}"/>
                                <Button Grid.Column="5" Content="Clear all" FontSize="12"
                                        Command="{Binding ClearDexCommand}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,420" ColumnSpacing="14" IsVisible="{Binding IsSupported}">
                            <!-- ListBox virtualizes; rows stay a fixed height so scrolling is stable -->
                            <ListBox Grid.Column="0" ItemsSource="{Binding Rows}"
                                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DexRowViewModel">
                                        <Grid ColumnDefinitions="62,44,*,70,50,80" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontSize="11"
                                                       Classes="secondary" VerticalAlignment="Center"
                                                       FontFamily="Menlo, monospace"/>
                                            <Image Grid.Column="1" Source="{Binding Sprite}" Width="40" Height="34"
                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Seen" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center" IsVisible="{Binding Seen}"/>
                                            <CheckBox Grid.Column="4" Content="★" FontSize="12"
                                                      ToolTip.Tip="Shiny registered"
                                                      IsVisible="{Binding SupportsDetail}"
                                                      IsChecked="{Binding ShinySeen, Mode=TwoWay}"/>
                                            <CheckBox Grid.Column="5" Content="Caught" FontSize="12"
                                                      IsChecked="{Binding Caught, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Detail pane: fixed position, so selecting never disturbs the list -->
                            <Border Grid.Column="1" Classes="card" Padding="14" VerticalAlignment="Stretch">
                                <Panel>
                                    <!-- '!' does not null-check an object binding; use the converter -->
                                    <StackPanel VerticalAlignment="Center" Spacing="8"
                                                IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNull}}">
                                        <ctrl:PokeBallIcon Width="36" Height="36" HorizontalAlignment="Center"
                                                   IconBrush="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Select a species to see everything the dex records for it"
                                                   FontSize="12" Classes="secondary" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ScrollViewer IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel DataContext="{Binding SelectedRow}" x:DataType="vm:DexRowViewModel"
                                                    Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Image Source="{Binding Sprite}" Width="56" Height="48"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding NumberText}" FontSize="11"
                                                               Classes="secondary" FontFamily="Menlo, monospace"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="{Binding DetailNote}" FontSize="10" Classes="secondary"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="sectionTitle" Text="FORMS" Margin="0"/>
                                                <ItemsControl ItemsSource="{Binding Forms}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DexFormRowViewModel">
                                                            <Grid ColumnDefinitions="*,74,92" ColumnSpacing="8" Margin="0,1">
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <CheckBox Grid.Column="1" Content="Seen" FontSize="11"
                                                                          IsChecked="{Binding Seen, Mode=TwoWay}"/>
                                                                <CheckBox Grid.Column="2" Content="Obtained" FontSize="11"
                                                                          IsChecked="{Binding Obtained, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="sectionTitle" Text="GENDERS SEEN" Margin="0"/>
                                                <ItemsControl ItemsSource="{Binding Genders}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="14"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DexFlagViewModel">
                                                            <CheckBox Content="{Binding Label}" FontSize="11"
                                                                      IsChecked="{Binding Value, Mode=TwoWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="4" IsVisible="{Binding HasLanguages}">
                                                <TextBlock Classes="sectionTitle" Text="LANGUAGES OBTAINED" Margin="0"/>
                                                <ItemsControl ItemsSource="{Binding Languages}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DexFlagViewModel">
                                                            <CheckBox Content="{Binding Label}" FontSize="11"
                                                                      Margin="0,0,14,2"
                                                                      IsChecked="{Binding Value, Mode=TwoWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ══════ SAVE view: trainer identity + bag, side by side ══════ -->
                    <DockPanel IsVisible="{Binding IsSaveView}" Margin="18,14,18,14">

                    <!-- Action bar, docked so it can never overlap the cards -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Revert" Click="OnSaveRevertClicked"/>
                        <Button Content="Apply" Classes="accent" Click="OnSaveApplyClicked"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="380,*" ColumnSpacing="14">

                        <!-- Trainer identity -->
                        <Border Grid.Column="0" Classes="card" VerticalAlignment="Stretch">
                            <DockPanel DataContext="{Binding Trainer}" x:DataType="vm:TrainerEditorViewModel">
                                <TextBlock DockPanel.Dock="Top" Text="Trainer" FontSize="17" FontWeight="Bold"
                                           Margin="0,0,0,12"/>
                                <ScrollViewer>
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Trainer Name"/>
                                            <TextBox Text="{Binding OtName, Mode=TwoWay}" MaxLength="{Binding MaxOtLength}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Gender"/>
                                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding GenderIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="♂ Male"/>
                                                <ComboBoxItem Content="♀ Female"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Classes="fieldLabel" Text="TID"/>
                                                <NumericUpDown Value="{Binding Tid, Mode=TwoWay}" Minimum="0"
                                                               Maximum="{Binding MaxTid}" FormatString="0" Increment="1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="fieldLabel" Text="SID"/>
                                                <NumericUpDown Value="{Binding Sid, Mode=TwoWay}" Minimum="0"
                                                               Maximum="{Binding MaxSid}" FormatString="0" Increment="1"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Money"/>
                                            <NumericUpDown Value="{Binding Money, Mode=TwoWay}" Minimum="0"
                                                           Maximum="9999999" FormatString="0" Increment="1000"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsScarletViolet}">
                                            <TextBlock Classes="fieldLabel" Text="League Points"/>
                                            <NumericUpDown Value="{Binding LeaguePoints, Mode=TwoWay}" Minimum="0"
                                                           Maximum="9999999" FormatString="0" Increment="1000"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsScarletViolet}">
                                            <TextBlock Classes="fieldLabel" Text="Blueberry Points (BP)"/>
                                            <NumericUpDown Value="{Binding BlueberryPoints, Mode=TwoWay}" Minimum="0"
                                                           Maximum="9999999" FormatString="0" Increment="100"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="fieldLabel" Text="Play Time  (h : m : s)"/>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                <NumericUpDown Grid.Column="0" Value="{Binding Hours, Mode=TwoWay}" Minimum="0" Maximum="9999" FormatString="0" Increment="1"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding Minutes, Mode=TwoWay}" Minimum="0" Maximum="59" FormatString="0" Increment="1"/>
                                                <NumericUpDown Grid.Column="2" Value="{Binding Seconds, Mode=TwoWay}" Minimum="0" Maximum="59" FormatString="0" Increment="1"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsScarletViolet}" Spacing="6" Margin="0,6,0,0">
                                            <Separator/>
                                            <TextBlock Classes="sectionTitle" Text="PROGRESSION SHORTCUTS"/>
                                            <Button Content="Unlock all TM recipes" FontSize="11" Padding="8,3"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding UnlockAllTmRecipesCommand}"/>
                                            <Button Content="Unlock Blueberry coaches" FontSize="11" Padding="8,3"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding UnlockAllCoachesCommand}"/>
                                            <Button Content="Collect all Ogre Clan stakes" FontSize="11" Padding="8,3"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding CollectAllStakesCommand}"/>
                                            <Button Content="Activate Snacksworth legendaries" FontSize="11" Padding="8,3"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding ActivateSnacksworthLegendariesCommand}"/>
                                            <TextBlock Text="{Binding UnlockResult}" FontSize="10" Classes="secondary"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Bag and the trainer's look share the right column -->
                        <Border Grid.Column="1" Classes="card">
                            <TabControl Padding="0,4,0,0">
                            <TabItem Header="Bag">
                            <DockPanel DataContext="{Binding Bag}" x:DataType="vm:BagViewModel" Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" Classes="fieldLabel" IsVisible="{Binding !HasPouches}"
                                           Text="This save format does not expose an editable inventory."/>

                                <!-- Item picker for the selected slot -->
                                <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="10" Margin="0,10,0,0"
                                        IsVisible="{Binding HasPouches}"
                                        Background="{DynamicResource SurfaceMutedBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding PouchSummary}" FontSize="11" Classes="secondary"/>
                                        <Grid ColumnDefinitions="Auto,116,Auto,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0" Text="Give all @" FontSize="11" Classes="secondary"
                                                       VerticalAlignment="Center"/>
                                            <!-- Wide enough that the spinner buttons don't crush the text field -->
                                            <NumericUpDown Grid.Column="1" MinWidth="112"
                                                           Value="{Binding GiveAllCount, Mode=TwoWay}"
                                                           Minimum="1" Maximum="{Binding MaxCount}" FormatString="0"
                                                           Increment="1" FontSize="11"
                                                           HorizontalContentAlignment="Right"/>
                                            <Button Grid.Column="2" Content="Give all" FontSize="11" Padding="8,3"
                                                    Command="{Binding GiveAllItemsCommand}"/>
                                            <Button Grid.Column="3" Content="Sort A–Z" FontSize="11" Padding="8,3"
                                                    Command="{Binding SortByNameCommand}"/>
                                            <Button Grid.Column="4" Content="Empty pouch" FontSize="11" Padding="8,3"
                                                    Command="{Binding ClearPouchCommand}"/>
                                        </Grid>
                                        <Separator/>
                                        <TextBlock Classes="fieldLabel" Text="Change selected slot to"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ItemPickerChoices}"
                                                      SelectedValue="{Binding PickerValue, Mode=TwoWay}"
                                                      SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                      DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                            <Button Grid.Column="1" Content="Set" Command="{Binding SetSelectedItemCommand}"/>
                                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSelectedItemCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="170,*" ColumnSpacing="12" IsVisible="{Binding HasPouches}">
                                    <ListBox Grid.Column="0" ItemsSource="{Binding PouchNames}"
                                             SelectedIndex="{Binding SelectedPouchIndex, Mode=TwoWay}"/>
                                    <ListBox Grid.Column="1" ItemsSource="{Binding Rows}"
                                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BagItemRowViewModel">
                                                <Grid ColumnDefinitions="26,*,136" ColumnSpacing="8">
                                                    <Image Grid.Column="0" Source="{Binding Sprite}" Width="24" Height="24"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="13"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <NumericUpDown Grid.Column="2" Value="{Binding Count, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="{Binding MaxCount}" FormatString="0"
                                                                   Increment="1" FontSize="12" HorizontalContentAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Trainer look: throw style, outfit, appearance, club perks ── -->
                            <TabItem Header="Appearance &amp; Style">
                            <DockPanel DataContext="{Binding Style}" x:DataType="vm:TrainerStyleViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="Only Scarlet/Violet and Legends Z-A store the player's outfit and appearance in an editable form."/>

                                <StackPanel DockPanel.Dock="Top" Spacing="9" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Classes="secondary"/>

                                    <Grid ColumnDefinitions="Auto,200,Auto" ColumnSpacing="10"
                                          IsVisible="{Binding HasThrowStyle}">
                                        <TextBlock Grid.Column="0" Text="Ball throw style" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ThrowStyleChoices}"
                                                  SelectedIndex="{Binding ThrowStyleIndex, Mode=TwoWay}"/>
                                        <Button Grid.Column="2" Content="Unlock all styles" FontSize="12"
                                                Command="{Binding UnlockThrowStylesCommand}"
                                                ToolTip.Tip="Sets the three club-room style flags and marks the support board entries bought."/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Unlock all fashion" FontSize="12"
                                                Command="{Binding UnlockFashionCommand}"
                                                ToolTip.Tip="Adds every clothing item for this trainer's gender to the wardrobe."/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                               Foreground="{DynamicResource LegalFgBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <StackPanel Spacing="16">

                                        <StackPanel Spacing="5">
                                            <TextBlock Classes="sectionTitle" Text="WORN OUTFIT" Margin="0"/>
                                            <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                                       Text="Each slot holds an opaque 64-bit item id. No name table for these exists anywhere in PKHeX, so they read as hex — zero means nothing equipped."/>
                                            <ItemsControl ItemsSource="{Binding Outfit}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StyleFieldViewModel">
                                                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="1" Text="{Binding HexText, Mode=TwoWay}"
                                                                     FontSize="11" FontFamily="{Binding FieldFont}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="10"
                                                                       Foreground="{DynamicResource IllegalFgBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Spacing="5">
                                            <TextBlock Classes="sectionTitle" Text="FACIAL APPEARANCE" Margin="0"/>
                                            <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                                       Text="These are option indexes from the character creator, counting from zero. Nudge one up or down to move through the choices."/>
                                            <ItemsControl ItemsSource="{Binding Appearance}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StyleFieldViewModel">
                                                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="1" Text="{Binding HexText, Mode=TwoWay}"
                                                                     FontSize="11" FontFamily="{Binding FieldFont}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="10"
                                                                       Foreground="{DynamicResource IllegalFgBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Gym / Titan / Team Star clears ── -->
                            <TabItem Header="Gyms">
                            <DockPanel DataContext="{Binding Trainer}" x:DataType="vm:TrainerEditorViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasBadges}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="This save format does not record gym clears in an editable form."/>
                                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12"
                                            IsVisible="{Binding HasBadges}">
                                    <TextBlock Text="{Binding BadgeSummary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="Scarlet and Violet store the order each was cleared in rather than a plain badge flag, so the number beside each row is its position in your run. Ticking one assigns the next free position."/>
                                </StackPanel>
                                <ScrollViewer IsVisible="{Binding HasBadges}">
                                    <ItemsControl ItemsSource="{Binding Badges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BadgeRowViewModel">
                                                <Grid ColumnDefinitions="80,*,44" ColumnSpacing="8" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Group}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="1" Content="{Binding Label}" FontSize="12"
                                                              IsChecked="{Binding Cleared, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding OrderText}" FontSize="11"
                                                               Classes="secondary" VerticalAlignment="Center"
                                                               TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Blueberry Academy: club perks and quest tallies ── -->
                            <TabItem Header="Blueberry Perks">
                            <DockPanel DataContext="{Binding Blueberry}" x:DataType="vm:BlueberryViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="The Blueberry Academy club room only exists in Scarlet and Violet with the Indigo Disk DLC."/>
                                <StackPanel DockPanel.Dock="Top" Spacing="9" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="Auto,120,Auto,120" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="BBQs solo" FontSize="11"
                                                   Classes="secondary" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" MinWidth="112" FontSize="11"
                                                       Value="{Binding QuestsSolo, Mode=TwoWay}"
                                                       Minimum="0" Maximum="9999999" FormatString="0"
                                                       Increment="1" HorizontalContentAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="in a group" FontSize="11"
                                                   Classes="secondary" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <NumericUpDown Grid.Column="3" MinWidth="112" FontSize="11"
                                                       Value="{Binding QuestsGroup, Mode=TwoWay}"
                                                       Minimum="0" Maximum="9999999" FormatString="0"
                                                       Increment="1" HorizontalContentAlignment="Right"/>
                                    </Grid>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="Everything the clubs can sell you, bought with Blueberry Points. The three baseball-club rows are what make the extra ball-throwing styles selectable; art and music club rows unlock room décor and albums."/>
                                    <Button Content="Buy all club perks" FontSize="12" HorizontalAlignment="Left"
                                            Command="{Binding BuyAllPerksCommand}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                               Foreground="{DynamicResource LegalFgBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <ItemsControl ItemsSource="{Binding Purchases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StyleToggleViewModel">
                                                <CheckBox Content="{Binding Label}" FontSize="12" Margin="0,1"
                                                          IsChecked="{Binding Value, Mode=TwoWay}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>

                            <!-- ── Lifetime trainer stat records ── -->
                            <TabItem Header="Records">
                            <DockPanel DataContext="{Binding Records}" x:DataType="vm:TrainerRecordsViewModel"
                                       Margin="2,8,2,2">
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                                           FontSize="13" Classes="secondary" TextWrapping="Wrap"
                                           Text="This save format does not keep lifetime stat records. Gen 6, Gen 7, BDSP and Sword/Shield do; Scarlet and Violet scattered the equivalents across individual save blocks instead — see Save Blocks."/>
                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsSupported}">
                                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                               Text="Each record has its own ceiling and the game clamps to it, so a value that refuses to grow has hit its max."/>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                                 FontSize="12" Watermark="Search records…"/>
                                        <CheckBox Grid.Column="1" Content="With a value" FontSize="12"
                                                  IsChecked="{Binding NonZeroOnly, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Clear all" FontSize="12"
                                                Command="{Binding ClearAllCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <ScrollViewer IsVisible="{Binding IsSupported}">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecordRowViewModel">
                                                <Grid ColumnDefinitions="*,150,86" ColumnSpacing="8" Margin="0,2">
                                                    <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding IdText}" FontSize="9" Classes="secondary"/>
                                                    </StackPanel>
                                                    <NumericUpDown Grid.Column="1" MinWidth="140" FontSize="11"
                                                                   Value="{Binding Value, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="999999999" FormatString="0"
                                                                   Increment="1" HorizontalContentAlignment="Right"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding MaxText}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                    </DockPanel>

                    </Panel>

                </Grid>
            </DockPanel>

                    <!-- ══════ INSPECTOR — styled to match the sidebar ══════ -->
                    <Border Grid.Column="2" Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                    <!-- Slim drag handle. The traffic lights sit over the sidebar, so this
                         column needs no full title-bar strip — just enough to grab. -->
                    <Border DockPanel.Dock="Top" Height="18" Background="Transparent"
                            PointerPressed="OnHeaderPressed"/>
                    <Panel Margin="14,8,14,14">
                        <!-- Database mode: browser on top, live preview + add below -->
                        <Grid RowDefinitions="*,Auto" RowSpacing="8" IsVisible="{Binding IsDatabaseView}">
                            <Panel Grid.Row="0">
                    <!-- ══════ Add Pokémon view ══════ -->
                    <Border IsVisible="{Binding IsAddView}">
                        <DockPanel DataContext="{Binding AddDb}" x:DataType="vm:AddPokemonViewModel">
                            <TextBlock DockPanel.Dock="Top" Text="Add Pokémon from Encounter Database"
                                       FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="fieldLabel" Text="Species"/>
                                    <!-- Type-ahead beats scrolling 1000+ entries -->
                                    <AutoCompleteBox HorizontalAlignment="Stretch"
                                                     ItemsSource="{Binding SpeciesOptions}"
                                                     SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
                                                     FilterMode="Contains"
                                                     MinimumPrefixLength="1"
                                                     MaxDropDownHeight="320"
                                                     Watermark="Start typing a species name…">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SpeciesChoice">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Source="{Binding Sprite}" Width="34" Height="28"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding MakeShiny, Mode=TwoWay}" Content="Make Shiny ★ (if possible)"/>
                                <TextBlock Classes="fieldLabel" Text="Legal encounters — pick one to preview"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="12"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <ListBox Margin="0,4,0,0" ItemsSource="{Binding EncounterDescriptions}"
                                     SelectedIndex="{Binding SelectedEncounterIndex, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <!-- ══════ Mystery Gifts view: sprite tile grid ══════ -->
                    <Border IsVisible="{Binding IsGiftsView}">
                        <DockPanel DataContext="{Binding GiftDb}" x:DataType="vm:GiftsViewModel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Mystery Gift Database"
                                           FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" FontSize="11"
                                           Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Filters -->
                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Search species, event, or game…"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" FontSize="12"
                                              ItemsSource="{Binding GenerationChoices}"
                                              SelectedIndex="{Binding SelectedGenerationIndex, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12"
                                              ItemsSource="{Binding GameChoices}"
                                              SelectedIndex="{Binding SelectedGameIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding ShinyOnly, Mode=TwoWay}"
                                              Content="Shiny only" FontSize="12"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EggsOnly, Mode=TwoWay}"
                                              Content="Eggs only" FontSize="12"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding AddableOnly, Mode=TwoWay}" FontSize="12"
                                              Content="Only gifts this save accepts"/>
                                    <Button Grid.Column="1" Content="Clear" FontSize="11" Padding="10,3"
                                            Command="{Binding ClearFiltersCommand}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="12"
                                       Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button DockPanel.Dock="Bottom" Content="{Binding LoadMoreLabel}"
                                    IsVisible="{Binding HasMore}" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding LoadNextPageCommand}"/>

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GiftTileViewModel">
                                            <Button Classes="giftTile" Classes.selected="{Binding IsSelected}"
                                                    Opacity="{Binding TileOpacity}"
                                                    Command="{Binding $parent[ItemsControl].((vm:GiftsViewModel)DataContext).SelectTileCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                <StackPanel Width="86" Spacing="1">
                                                    <Panel Height="52">
                                                        <Image Source="{Binding Sprite}" Width="60" Height="50"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                        <Image Source="{Binding ShinyOverlay}" Width="18" Height="18"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Margin="14,2,0,0" Opacity="0.85"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                    </Panel>
                                                    <TextBlock Text="{Binding SpeciesName}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="10" Classes="secondary"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OriginText}" FontSize="9" Classes="secondary"
                                                               HorizontalAlignment="Center" Opacity="0.75"/>
                                                    <TextBlock Text="{Binding CardTitle}" FontSize="9" Classes="secondary"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="84"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>


                            </Panel>

                        <!-- Preview of the selected database entry, before it is added -->
                        <Border Grid.Row="1" Classes="card" Padding="14">
                            <StackPanel DataContext="{Binding Preview}" x:DataType="vm:PokemonPreviewViewModel"
                                        Spacing="10">
                                <TextBlock Text="Select an entry to preview it here" FontSize="12" Classes="secondary"
                                           HorizontalAlignment="Center" IsVisible="{Binding !HasPokemon}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>

                                <!-- Blocked: explain why nothing can be added -->
                                <Border CornerRadius="8" Padding="10,8" IsVisible="{Binding IsBlocked}"
                                        Background="{DynamicResource IllegalBgBrush}">
                                    <TextBlock Text="{Binding BlockedReason}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource IllegalFgBrush}"/>
                                </Border>

                                <StackPanel IsVisible="{Binding HasPokemon}" Spacing="12">

                                    <!-- Identity: artwork, name, types, legality, held item -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Image Grid.Column="0" Source="{Binding Artwork}" Width="96" Height="96"
                                               VerticalAlignment="Top"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{Binding BallSprite}" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SpeciesName}" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LevelBadge}" FontSize="10" Classes="secondary"
                                                           VerticalAlignment="Center"/>
                                                <Image Source="{Binding ShinyIcon}" Width="17" Height="17"
                                                       IsVisible="{Binding IsShiny}" VerticalAlignment="Center"
                                                       ToolTip.Tip="Shiny"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Source="{Binding Type1Icon}" Width="22" Height="22"
                                                       IsVisible="{Binding HasType1Icon}" ToolTip.Tip="{Binding Type1Name}"/>
                                                <Border Classes="chip" Padding="7,2" Background="{Binding Type1Brush}"
                                                        IsVisible="{Binding !HasType1Icon}">
                                                    <TextBlock Text="{Binding Type1Name}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <Image Source="{Binding Type2Icon}" Width="22" Height="22"
                                                       IsVisible="{Binding HasType2Icon}" ToolTip.Tip="{Binding Type2Name}"/>
                                                <Border Classes="chip" Padding="7,2" Background="{DynamicResource LegalBgBrush}"
                                                        IsVisible="{Binding IsLegal}" VerticalAlignment="Center">
                                                    <TextBlock Text="✓ Legal" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource LegalFgBrush}"/>
                                                </Border>
                                                <Border Classes="chip" Padding="7,2" Background="{DynamicResource IllegalBgBrush}"
                                                        IsVisible="{Binding !IsLegal}" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding LegalityReport}">
                                                    <TextBlock Text="✕ Issues" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource IllegalFgBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding NatureText, StringFormat='{}{0} nature'}"
                                                           FontSize="11" Classes="secondary"/>
                                                <TextBlock Text="{Binding AbilityText}" FontSize="11" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ItemText}" FontSize="11" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OriginText}" FontSize="11" Classes="secondary"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Moves beside stats, same visual language as the inspector tabs -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="MOVES" FontSize="9" FontWeight="Bold" Classes="secondary"/>
                                            <ItemsControl ItemsSource="{Binding Moves}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MoveChoice">
                                                        <Grid ColumnDefinitions="20,20,*" ColumnSpacing="5" Margin="0,0,0,5">
                                                            <Image Grid.Column="0" Source="{Binding TypeIcon}" Width="18" Height="18"
                                                                   IsVisible="{Binding HasTypeIcon}" VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding TypeName}"/>
                                                            <ctrl:MoveCategoryIcon Grid.Column="1" Category="{Binding CategoryKind}"
                                                                                   Width="18" Height="18"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding StatLine}" FontSize="9" Classes="secondary"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No moves set" FontSize="11" Classes="secondary"
                                                       IsVisible="{Binding !HasMoves}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="STATS" FontSize="9" FontWeight="Bold" Classes="secondary"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatTotal, StringFormat='TOT {0}'}"
                                                           FontSize="9" FontWeight="Bold" Classes="secondary"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Stats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewStatRow">
                                                        <!-- Value sits after the bar so a wide bar can never paint over it. -->
                                                        <Grid ColumnDefinitions="44,*,32" ColumnSpacing="6" Margin="0,0,0,5">
                                                            <Grid Grid.Column="0" ColumnDefinitions="32,*" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10"
                                                                           FontWeight="Bold" Foreground="{Binding LabelBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding NatureBadge}" FontSize="8"
                                                                           IsVisible="{Binding HasNatureBadge}"
                                                                           Foreground="{Binding LabelBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <ProgressBar Grid.Column="1" Classes="statbar"
                                                                         Value="{Binding BarPercent}"
                                                                         Foreground="{Binding BarBrush}"
                                                                         VerticalAlignment="Center"
                                                                         ToolTip.Tip="{Binding Tooltip}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextAlignment="Right" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TargetSlotText}"
                                        Classes="accent" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding HasPokemon}"
                                        Click="OnAddPreviewClicked"/>
                            </StackPanel>
                        </Border>

                        </Grid>

                        <Border IsVisible="{Binding IsBoxesView}">
                            <StackPanel VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !Detail.HasPokemon}">
                                <ctrl:PokeBallIcon Width="42" Height="42" HorizontalAlignment="Center"
                                           IconBrush="{DynamicResource TextSecondaryBrush}"/>

                                <!-- Nothing selected -->
                                <TextBlock Text="Select a Pokémon" FontSize="13" Classes="secondary"
                                           HorizontalAlignment="Center" IsVisible="{Binding !CanUseDatabases}"/>

                                <!-- An empty slot is selected: offer to fill it -->
                                <StackPanel Spacing="10" IsVisible="{Binding CanUseDatabases}">
                                    <TextBlock Text="{Binding TargetSlotText}" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="This slot is empty — fill it from a database, or drop a .pk file onto it."
                                               FontSize="11" Classes="secondary" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Content="Add Pokémon from Database" Classes="accent"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetViewCommand}" CommandParameter="add"/>
                                    <Button Content="Mystery Gift Database"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetViewCommand}" CommandParameter="gifts"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Panel IsVisible="{Binding IsBoxesView}">
                        <Border Padding="0"
                                DataContext="{Binding Detail}"
                                x:DataType="vm:PokemonDetailViewModel"
                                IsVisible="{Binding HasPokemon}">
                            <DockPanel Margin="14">
                                <!-- Hero -->
                                <StackPanel DockPanel.Dock="Top" Spacing="8">
                                    <Image Source="{Binding Artwork}" Height="150"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SpeciesName}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Classes="chip" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelBadge}" FontSize="10" Classes="secondary"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <!-- The type symbols are self-explanatory, so no labels -->
                                        <Image Source="{Binding Type1Icon}" Width="26" Height="26"
                                               IsVisible="{Binding HasType1Icon}"
                                               ToolTip.Tip="{Binding Type1Name}"/>
                                        <Border Classes="chip" Background="{Binding Type1Brush}" Padding="7,2"
                                                IsVisible="{Binding !HasType1Icon}">
                                            <TextBlock Text="{Binding Type1Name}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>

                                        <Image Source="{Binding Type2Icon}" Width="26" Height="26"
                                               IsVisible="{Binding HasType2Icon}"
                                               ToolTip.Tip="{Binding Type2Name}"/>

                                        <Image Source="{Binding ShinyIcon}" Width="20" Height="20"
                                               IsVisible="{Binding IsShiny}" VerticalAlignment="Center"
                                               ToolTip.Tip="Shiny"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <Border Classes="chip" Background="{DynamicResource LegalBgBrush}" IsVisible="{Binding IsLegal}">
                                            <TextBlock Text="✓ Legal" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LegalFgBrush}"/>
                                        </Border>
                                        <Border Classes="chip" Background="{DynamicResource IllegalBgBrush}" IsVisible="{Binding !IsLegal}">
                                            <TextBlock Text="✕ Issues" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource IllegalFgBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource IllegalBgBrush}"
                                            IsVisible="{Binding !IsLegal}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding LegalityReport}" FontSize="10" TextWrapping="Wrap"
                                                       MaxHeight="72" Foreground="{DynamicResource IllegalFgBrush}"/>
                                            <Button Content="Fix moves &amp; relearn" FontSize="11" Padding="10,3"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="Apply a legal moveset and the encounter's relearn moves. Met data is left alone — use Suggest on the Met tab for that."
                                                    Command="{Binding SuggestAllCommand}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding SuggestionResult}" FontSize="10" Classes="secondary"
                                               TextWrapping="Wrap" IsVisible="{Binding SuggestionResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Apply -->
                                <Button DockPanel.Dock="Bottom" Content="Apply Changes" Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding IsDirty}" Classes="accent"
                                        Click="OnApplyClicked"/>

                                <!-- Tabs -->
                                <TabControl Margin="0,6,0,0" Padding="0,6,0,0">
                                    <TabItem Header="Main">
                                        <ScrollViewer>
                                            <StackPanel Spacing="9" Margin="2,6,6,2">
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Species"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesChoices}"
                                                              SelectedValue="{Binding SpeciesValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding HasForms}">
                                                    <TextBlock Classes="fieldLabel" Text="Form"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FormChoices}"
                                                              SelectedIndex="{Binding FormIndex, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Nickname"/>
                                                    <TextBox Text="{Binding Nickname, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Level"/>
                                                        <NumericUpDown Value="{Binding Level, Mode=TwoWay}" Minimum="1" Maximum="100"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="fieldLabel" Text="Friendship"/>
                                                        <NumericUpDown Value="{Binding Friendship, Mode=TwoWay}" Minimum="0" Maximum="255"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Gender"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GenderChoices}"
                                                                  SelectedIndex="{Binding GenderIndex, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanEditGender}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                        <CheckBox IsChecked="{Binding IsShiny, Mode=TwoWay}" Content="Shiny ★"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Nature"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}"
                                                              SelectedValue="{Binding NatureValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:NatureChoice}">
                                                        <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NatureChoice">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" MinWidth="76"/>
                                                                <TextBlock Text="{Binding UpLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.UpBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding DownLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.DownBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding NeutralLabel}" FontSize="11" Classes="secondary"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsNeutral}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Ability"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AbilityChoices}"
                                                              SelectedIndex="{Binding AbilityIndex, Mode=TwoWay}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Held Item"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ItemChoices}"
                                                              SelectedValue="{Binding HeldItemValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Ball"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BallChoices}"
                                                              SelectedValue="{Binding BallValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:BallChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:BallChoice">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Image Source="{Binding Sprite}" Width="20" Height="20"
                                                                           VerticalAlignment="Center"
                                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Language"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageChoices}"
                                                              SelectedValue="{Binding LanguageValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding HasStatNature}">
                                                    <TextBlock Classes="fieldLabel" Text="Stat Nature (Gen 8+ split)"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}"
                                                              SelectedValue="{Binding StatNatureValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:NatureChoice}">
                                                        <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NatureChoice">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" MinWidth="76"/>
                                                                <TextBlock Text="{Binding UpLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.UpBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding DownLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.DownBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding NeutralLabel}" FontSize="11" Classes="secondary"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsNeutral}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Experience"/>
                                                    <NumericUpDown Value="{Binding Experience, Mode=TwoWay}" Minimum="0"
                                                                   Maximum="1640000" FormatString="0" Increment="1000"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding FormArgumentVisible}">
                                                    <TextBlock Classes="fieldLabel" Text="Form Argument"/>
                                                    <NumericUpDown Value="{Binding FormArgument, Mode=TwoWay}" Minimum="0"
                                                                   Maximum="4294967295" FormatString="0" Increment="1"/>
                                                </StackPanel>
                                                <Separator Margin="0,4"/>
                                                <TextBlock Classes="sectionTitle" Text="POKÉRUS"/>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Strain"/>
                                                        <NumericUpDown Value="{Binding PokerusStrain, Mode=TwoWay}" Minimum="0"
                                                                       Maximum="15" FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="fieldLabel" Text="Days left"/>
                                                        <NumericUpDown Value="{Binding PokerusDays, Mode=TwoWay}" Minimum="0"
                                                                       Maximum="4" FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <CheckBox IsChecked="{Binding IsEgg, Mode=TwoWay}" Content="Is Egg"/>
                                                    <CheckBox IsChecked="{Binding IsFavorite, Mode=TwoWay}" Content="Favorite"
                                                              IsVisible="{Binding SupportsFavorite}"/>
                                                </StackPanel>
                                                <Separator Margin="0,4"/>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="PID"/>
                                                        <TextBlock Text="{Binding PidText}" FontFamily="Menlo, monospace" FontSize="12"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Reroll" FontSize="11" Padding="8,3"
                                                            VerticalAlignment="Bottom" Command="{Binding RerollPidCommand}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Encryption Constant"/>
                                                        <TextBlock Text="{Binding EcText}" FontFamily="Menlo, monospace" FontSize="12"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Reroll" FontSize="11" Padding="8,3"
                                                            VerticalAlignment="Bottom" Command="{Binding RerollEncryptionConstantCommand}"/>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Stats">
                                        <ScrollViewer>
                                            <StackPanel Spacing="6" Margin="2,6,6,2">
                                                <!-- Nature, with the stat it raises / lowers -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="fieldLabel" Text="Nature"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}"
                                                              SelectedValue="{Binding NatureValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:NatureChoice}">
                                                        <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NatureChoice">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" MinWidth="76"/>
                                                                <TextBlock Text="{Binding UpLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.UpBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding DownLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{x:Static vm:NatureChoice.DownBrush}"
                                                                           VerticalAlignment="Center" IsVisible="{Binding HasModifiers}"/>
                                                                <TextBlock Text="{Binding NeutralLabel}" FontSize="11" Classes="secondary"
                                                                           VerticalAlignment="Center" IsVisible="{Binding IsNeutral}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Shared EV pool -->
                                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="EV BUDGET" Margin="0,0,0,0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding EvBudgetText}" FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </DockPanel>
                                                    <ProgressBar Classes="meter" Value="{Binding EvBudgetPercent}"
                                                                 Foreground="{DynamicResource MeterEvBrush}"
                                                                 Margin="0,0,10,0"/>
                                                    <TextBlock Text="Sliders stop at whatever the 510-point pool has left."
                                                               FontSize="10" Classes="secondary"
                                                               IsVisible="{Binding !EvOverLimit}"/>
                                                    <TextBlock Text="This spread exceeds the game's 510 EV limit and will be flagged as illegal."
                                                               FontSize="10" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource IllegalFgBrush}"
                                                               IsVisible="{Binding EvOverLimit}"/>
                                                </StackPanel>

                                                <Separator Margin="0,6"/>

                                                <!-- ProDex-style rows: label, value, magnitude bar; IV/EV inline -->
                                                <ItemsControl ItemsSource="{Binding Stats}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StatEditRowViewModel">
                                                            <Grid ColumnDefinitions="66,44,*" RowDefinitions="Auto,Auto"
                                                                  ColumnSpacing="8" RowSpacing="2" Margin="0,0,0,9">

                                                                <!-- Fixed label column so every nature arrow lines up -->
                                                                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="44,*"
                                                                      VerticalAlignment="Center">
                                                                    <TextBlock Grid.Column="0" Text="{Binding ShortLabel}"
                                                                               FontSize="12" FontWeight="Bold"
                                                                               Foreground="{Binding LabelBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding NatureBadge}" FontSize="10"
                                                                               IsVisible="{Binding HasNatureBadge}"
                                                                               Foreground="{Binding NatureBadgeBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Stat}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                <ProgressBar Grid.Row="0" Grid.Column="2" Classes="statbar"
                                                                             Value="{Binding StatBarPercent}"
                                                                             Foreground="{Binding BarBrush}"
                                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <!-- IV / EV inputs, tucked under the bar -->
                                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="6" HorizontalAlignment="Left">
                                                                    <TextBlock Text="IV" FontSize="10" Classes="secondary" VerticalAlignment="Center"/>
                                                                    <TextBox Classes="statNum" Text="{Binding Iv, Mode=TwoWay}"/>
                                                                    <TextBlock Text="EV" FontSize="10" Classes="secondary"
                                                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                    <TextBox Classes="statNum" Text="{Binding Ev, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Totals: species base-stat total, and the live in-battle sum -->
                                                <Separator Margin="0,2,0,6"/>
                                                <Grid ColumnDefinitions="66,44,*" ColumnSpacing="8" Margin="0,0,0,5"
                                                      ToolTip.Tip="Base stat total — a constant for this species, the number dex apps show">
                                                    <TextBlock Grid.Column="0" Text="BST" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding BaseStatTotal}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="2" Classes="statbar"
                                                                 Value="{Binding BaseStatTotalPercent}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="66,44,*" ColumnSpacing="8" Margin="0,0,0,6"
                                                      ToolTip.Tip="Sum of this Pokémon's actual stats at its current level, IVs, EVs and nature">
                                                    <TextBlock Grid.Column="0" Text="TOT" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatTotal}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="2" Classes="statbar"
                                                                 Value="{Binding StatTotalPercent}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>

                                                                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                                    <Button Content="Max IVs" Command="{Binding MaxIVsCommand}" FontSize="12"/>
                                                    <Button Content="Clear EVs" Command="{Binding ClearEVsCommand}" FontSize="12"/>
                                                    <Button Content="Heal" Command="{Binding HealPokemonCommand}" FontSize="12"/>
                                                </StackPanel>

                                                <!-- Hyper training (bottle caps) -->
                                                <StackPanel IsVisible="{Binding SupportsHyperTraining}" Spacing="6" Margin="0,10,0,0">
                                                    <Separator/>
                                                    <TextBlock Classes="sectionTitle" Text="HYPER TRAINING"/>
                                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="2">
                                                        <CheckBox Grid.Row="0" Grid.Column="0" Content="HP" FontSize="11" IsChecked="{Binding HtHp, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="0" Grid.Column="1" Content="Atk" FontSize="11" IsChecked="{Binding HtAtk, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="0" Grid.Column="2" Content="Def" FontSize="11" IsChecked="{Binding HtDef, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="0" Content="SpA" FontSize="11" IsChecked="{Binding HtSpa, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="1" Content="SpD" FontSize="11" IsChecked="{Binding HtSpd, Mode=TwoWay}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="2" Content="Spe" FontSize="11" IsChecked="{Binding HtSpe, Mode=TwoWay}"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Train all" FontSize="12" Command="{Binding MaxHyperTrainingCommand}"/>
                                                        <Button Content="Clear" FontSize="12" Command="{Binding ClearHyperTrainingCommand}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Tera type (Scarlet/Violet) -->
                                                <StackPanel IsVisible="{Binding SupportsTeraType}" Spacing="8" Margin="0,10,0,0">
                                                    <Separator/>
                                                    <TextBlock Classes="sectionTitle" Text="TERA TYPE"/>
                                                    <StackPanel>
                                                        <TextBlock Classes="fieldLabel" Text="Original"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TeraTypeChoices}"
                                                                  SelectedValue="{Binding TeraTypeOriginalValue, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Classes="fieldLabel" Text="Override (Tera Shard change)"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TeraTypeOverrideChoices}"
                                                                  SelectedValue="{Binding TeraTypeOverrideValue, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Size -->
                                                <StackPanel IsVisible="{Binding SupportsScalars}" Spacing="8" Margin="0,10,0,0">
                                                    <Separator/>
                                                    <TextBlock Classes="sectionTitle" Text="SIZE"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Height"/>
                                                            <NumericUpDown Value="{Binding HeightScalar, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Weight"/>
                                                            <NumericUpDown Value="{Binding WeightScalar, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding SupportsScale}">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Scale (drives Jumbo / Mini marks)"/>
                                                            <NumericUpDown Value="{Binding Scale, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1" FontSize="12"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Random" FontSize="11" Padding="8,3"
                                                                VerticalAlignment="Bottom" Command="{Binding RandomizeScaleCommand}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SizeSummary}" FontSize="11" Classes="secondary"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Moves">
                                        <ScrollViewer>
                                            <StackPanel Spacing="8" Margin="2,6,6,2">
                                                <TextBlock Classes="sectionTitle" Text="MOVES" Margin="0"/>
                                                <Grid ColumnDefinitions="*,50,40" ColumnSpacing="8" Margin="0,0,0,-2">
                                                    <TextBlock Grid.Column="1" Text="PP Ups" FontSize="9" Classes="secondary"
                                                               TextAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="PP" FontSize="9" Classes="secondary"
                                                               TextAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,50,40" ColumnSpacing="8">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move1, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" Classes="statNum" Text="{Binding PpUps1, Mode=TwoWay}"
                                                             ToolTip.Tip="PP Ups applied (0-3)"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp1}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,50,40" ColumnSpacing="8">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move2, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" Classes="statNum" Text="{Binding PpUps2, Mode=TwoWay}"
                                                             ToolTip.Tip="PP Ups applied (0-3)"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp2}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,50,40" ColumnSpacing="8">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move3, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" Classes="statNum" Text="{Binding PpUps3, Mode=TwoWay}"
                                                             ToolTip.Tip="PP Ups applied (0-3)"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp3}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,50,40" ColumnSpacing="8">
                                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Move4, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" Classes="statNum" Text="{Binding PpUps4, Mode=TwoWay}"
                                                             ToolTip.Tip="PP Ups applied (0-3)"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pp4}" FontSize="10"
                                                               Classes="secondary" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Grid>

                                                <StackPanel IsVisible="{Binding HasRelearnMoves}">
                                                    <TextBlock Classes="sectionTitle" Text="RELEARN MOVES" Margin="2,10,0,6"/>
                                                    <StackPanel Spacing="8">
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Relearn1, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Relearn2, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Relearn3, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MoveChoices}"
                                                              SelectedValue="{Binding Relearn4, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=vm:MoveChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MoveChoice">
                                                                <Grid ColumnDefinitions="*,24,24,28,28" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               MinWidth="70" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Panel Grid.Column="1" IsVisible="{Binding IsRealMove}">
                                                                        <Image Source="{Binding TypeIcon}" Width="20" Height="20"
                                                                               IsVisible="{Binding HasTypeIcon}"
                                                                               ToolTip.Tip="{Binding TypeName}"/>
                                                                        <!-- Stellar has no symbol; fall back to the colour chip -->
                                                                        <Border Classes="chip" Padding="5,2" MinHeight="17"
                                                                                Background="{Binding TypeBrush}"
                                                                                IsVisible="{Binding !HasTypeIcon}">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Panel>
                                                                    <ctrl:MoveCategoryIcon Grid.Column="2" Category="{Binding CategoryKind}"
                                                                                           Width="20" Height="20"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Base power"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding AccuracyText}" FontSize="10"
                                                                               Classes="secondary" VerticalAlignment="Center"
                                                                               TextAlignment="Center" ToolTip.Tip="Accuracy"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Technical Records (TM history) -->
                                                <StackPanel Spacing="6" Margin="0,12,0,0"
                                                            DataContext="{Binding TechRecords}" x:DataType="vm:TechRecordViewModel"
                                                            IsVisible="{Binding IsSupported}">
                                                    <Separator/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="TECHNICAL RECORDS" Margin="0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="10"
                                                                   Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" FontSize="12"
                                                             Watermark="Search machine moves…"/>
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding LearnedOnly, Mode=TwoWay}"
                                                                  Content="Learned only" FontSize="12"/>
                                                    </DockPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="All legal" FontSize="11" Padding="8,3"
                                                                ToolTip.Tip="Mark the records this Pokémon could legally have used"
                                                                Command="{Binding SetAllLegalCommand}"/>
                                                        <Button Content="All" FontSize="11" Padding="8,3" Command="{Binding SetAllCommand}"/>
                                                        <Button Content="None" FontSize="11" Padding="8,3" Command="{Binding ClearAllCommand}"/>
                                                    </StackPanel>
                                                    <ScrollViewer MaxHeight="260">
                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:TechRecordRowViewModel">
                                                                    <CheckBox Content="{Binding MoveName}" FontSize="12"
                                                                              IsChecked="{Binding Learned, Mode=TwoWay}"
                                                                              Margin="0,1"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Met">
                                        <ScrollViewer>
                                            <StackPanel Spacing="9" Margin="2,6,6,2">
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Origin Game"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding VersionChoices}"
                                                              SelectedValue="{Binding VersionValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>

                                                <!-- Transfer / HOME: what makes a foreign-version Pokémon legal -->
                                                <Border CornerRadius="10" Padding="10" Margin="0,2,0,2"
                                                        Background="{DynamicResource SurfaceMutedBrush}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Classes="sectionTitle" Text="TRANSFER &amp; POKÉMON HOME" Margin="0"/>
                                                        <TextBlock Text="{Binding TransferSummary}" FontSize="10"
                                                                   Classes="secondary" TextWrapping="Wrap"/>
                                                        <Button Content="Mark as traded into this save" FontSize="11"
                                                                Padding="10,3" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                ToolTip.Tip="Sets this save's trainer as the handling trainer, leaving the original trainer intact — what receiving a trade does."
                                                                Command="{Binding MarkAsTradedCommand}"/>

                                                    </StackPanel>
                                                </Border>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="fieldLabel" Text="Met Location"/>
                                                        <Button DockPanel.Dock="Right" Content="Suggest" FontSize="10" Padding="8,1"
                                                                HorizontalAlignment="Right"
                                                                ToolTip.Tip="Use the met location and level the legality engine expects"
                                                                Command="{Binding SuggestMetInfoCommand}"/>
                                                    </DockPanel>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MetLocationChoices}"
                                                              SelectedValue="{Binding MetLocationValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="Met Level"/>
                                                        <NumericUpDown Value="{Binding MetLevel, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                        <CheckBox IsChecked="{Binding FatefulEncounter, Mode=TwoWay}" Content="Fateful"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Met Date"/>
                                                    <DatePicker SelectedDate="{Binding MetDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SupportsObedience}">
                                                    <TextBlock Classes="fieldLabel" Text="Obedience Level"/>
                                                    <NumericUpDown Value="{Binding ObedienceLevel, Mode=TwoWay}" Minimum="0"
                                                                   Maximum="100" FormatString="0" Increment="1"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding SupportsBattleVersion}">
                                                    <TextBlock Classes="fieldLabel" Text="Battle Version (reset for ranked)"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding VersionChoices}"
                                                              SelectedValue="{Binding BattleVersionValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>

                                                <Separator Margin="0,6"/>
                                                <TextBlock Classes="sectionTitle" Text="EGG DATA"/>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Egg Met Location"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MetLocationChoices}"
                                                              SelectedValue="{Binding EggLocationValue, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="Egg Met Date"/>
                                                    <DatePicker SelectedDate="{Binding EggMetDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>

                                                <Separator Margin="0,6"/>
                                                <TextBlock Classes="sectionTitle" Text="ORIGINAL TRAINER"/>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="OT Name"/>
                                                    <TextBox Text="{Binding OtName, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Classes="fieldLabel" Text="TID"/>
                                                        <NumericUpDown Value="{Binding DisplayTid, Mode=TwoWay}" Minimum="0" Maximum="999999"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="fieldLabel" Text="SID"/>
                                                        <NumericUpDown Value="{Binding DisplaySid, Mode=TwoWay}" Minimum="0" Maximum="999999"
                                                                       FormatString="0" Increment="1"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Classes="fieldLabel" Text="OT Gender"/>
                                                    <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding OtGenderIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="♂ Male"/>
                                                        <ComboBoxItem Content="♀ Female"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- HOME identifier lives at the end: rarely edited, and it fingerprints the save -->
                                                <StackPanel IsVisible="{Binding SupportsHomeTracker}" Spacing="8">
                                                    <Separator Margin="0,6"/>
                                                    <TextBlock Classes="sectionTitle" Text="POKÉMON HOME"/>
                                                    <StackPanel DataContext="{Binding History}" x:DataType="vm:PokemonHistoryViewModel"
                                                                Spacing="6">
                                                        <CheckBox IsChecked="{Binding HideTracker, Mode=TwoWay}" FontSize="11"
                                                                  Content="Hide tracker (it identifies your save)"/>
                                                        <StackPanel IsVisible="{Binding !HideTracker}">
                                                            <TextBlock Classes="fieldLabel" Text="HOME Tracker (16 hex digits)"/>
                                                            <TextBox Text="{Binding TrackerText, Mode=TwoWay}"
                                                                     FontFamily="Menlo, monospace" MaxLength="16"
                                                                     Watermark="0123456789ABCDEF"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Generate tracker" FontSize="11" Padding="8,3"
                                                                ToolTip.Tip="Give this Pokémon a plausible tracker, as a real HOME transfer would"
                                                                Command="{Binding GenerateHomeTrackerCommand}"/>
                                                        <Button Content="Clear" FontSize="11" Padding="8,3"
                                                                Command="{Binding ClearHomeTrackerCommand}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TransferSummary}" FontSize="10"
                                                               Classes="secondary" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- ══════ Trainer &amp; History ══════ -->
                                    <TabItem Header="Trainer">
                                        <ScrollViewer>
                                            <StackPanel Spacing="9" Margin="2,6,6,2"
                                                        DataContext="{Binding History}" x:DataType="vm:PokemonHistoryViewModel">

                                                <!-- Who holds it -->
                                                <StackPanel IsVisible="{Binding SupportsHandler}" Spacing="6">
                                                    <TextBlock Classes="sectionTitle" Text="CURRENT HANDLER"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding HandlerChoices}"
                                                              SelectedIndex="{Binding CurrentHandlerIndex, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding HandlerSummary}" FontSize="11" Classes="secondary"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Handling trainer -->
                                                <StackPanel IsVisible="{Binding SupportsHandler}" Spacing="9">
                                                    <Separator Margin="0,4"/>
                                                    <TextBlock Classes="sectionTitle" Text="HANDLING TRAINER"/>
                                                    <StackPanel>
                                                        <TextBlock Classes="fieldLabel" Text="Name"/>
                                                        <TextBox Text="{Binding HtName, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Gender"/>
                                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GenderChoices}"
                                                                      SelectedIndex="{Binding HtGenderIndex, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Friendship"/>
                                                            <NumericUpDown Value="{Binding HtFriendship, Mode=TwoWay}" Minimum="0"
                                                                           Maximum="255" FormatString="0" Increment="1"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel IsVisible="{Binding SupportsHandlerLanguage}">
                                                        <TextBlock Classes="fieldLabel" Text="Language"/>
                                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageChoices}"
                                                                  SelectedValue="{Binding HtLanguageValue, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Memories -->
                                                <StackPanel IsVisible="{Binding SupportsMemories}" Spacing="8">
                                                    <Separator Margin="0,4"/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="MEMORIES"/>
                                                        <Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="8,2"
                                                                HorizontalAlignment="Right" Command="{Binding ClearMemoriesCommand}"/>
                                                    </DockPanel>

                                                    <TextBlock Classes="fieldLabel" Text="Original Trainer memory"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MemoryChoices}"
                                                              SelectedValue="{Binding OtMemory, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding IntensityChoices}"
                                                                  SelectedValue="{Binding OtMemoryIntensity, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FeelingChoices}"
                                                                  SelectedValue="{Binding OtMemoryFeeling, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding OtMemoryText}" FontSize="10" Classes="secondary" TextWrapping="Wrap"/>

                                                    <TextBlock Classes="fieldLabel" Text="Handling Trainer memory" Margin="0,6,0,0"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MemoryChoices}"
                                                              SelectedValue="{Binding HtMemory, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding IntensityChoices}"
                                                                  SelectedValue="{Binding HtMemoryIntensity, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FeelingChoices}"
                                                                  SelectedValue="{Binding HtMemoryFeeling, Mode=TwoWay}"
                                                                  SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                                  DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding HtMemoryText}" FontSize="10" Classes="secondary" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Markings -->
                                                <StackPanel IsVisible="{Binding SupportsMarkings}" Spacing="6">
                                                    <Separator Margin="0,4"/>
                                                    <TextBlock Classes="sectionTitle" Text="MARKINGS"/>
                                                    <ItemsControl ItemsSource="{Binding Markings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MarkingRowViewModel">
                                                                <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Margin="0,2">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                                               Classes="secondary" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12"
                                                                              ItemsSource="{Binding Choices}"
                                                                              SelectedIndex="{Binding Value, Mode=TwoWay}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Contest stats -->
                                                <StackPanel IsVisible="{Binding SupportsContest}" Spacing="6">
                                                    <Separator Margin="0,4"/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Classes="sectionTitle" Text="CONTEST STATS"/>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Max" FontSize="11" Padding="8,2" Command="{Binding MaxContestCommand}"/>
                                                            <Button Content="Clear" FontSize="11" Padding="8,2" Command="{Binding ClearContestCommand}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Cool"/>
                                                            <NumericUpDown Value="{Binding ContestCool, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Beauty"/>
                                                            <NumericUpDown Value="{Binding ContestBeauty, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Cute"/>
                                                            <NumericUpDown Value="{Binding ContestCute, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Smart"/>
                                                            <NumericUpDown Value="{Binding ContestSmart, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                                            <TextBlock Classes="fieldLabel" Text="Tough"/>
                                                            <NumericUpDown Value="{Binding ContestTough, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                                            <TextBlock Classes="fieldLabel" Text="Sheen"/>
                                                            <NumericUpDown Value="{Binding ContestSheen, Mode=TwoWay}" Minimum="0" Maximum="255" FormatString="0" Increment="5" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- HOME tracker -->
                                                <StackPanel IsVisible="{Binding SupportsTracker}" Spacing="6">
                                                    <Separator Margin="0,4"/>
                                                    <TextBlock Classes="sectionTitle" Text="POKÉMON HOME"/>
                                                    <CheckBox IsChecked="{Binding HideTracker, Mode=TwoWay}"
                                                              Content="Hide tracker (it identifies your save)"/>
                                                    <StackPanel IsVisible="{Binding !HideTracker}">
                                                        <TextBlock Classes="fieldLabel" Text="HOME Tracker (16 hex digits)"/>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBox Grid.Column="0" Text="{Binding TrackerText, Mode=TwoWay}"
                                                                     FontFamily="Menlo, monospace" MaxLength="16"
                                                                     Watermark="0123456789ABCDEF"/>
                                                            <Button Grid.Column="1" Content="Zero" FontSize="11" Padding="8,3"
                                                                    Command="{Binding ClearTrackerCommand}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- ══════ Ribbons &amp; Marks ══════ -->
                                    <TabItem Header="Ribbons">
                                        <DockPanel DataContext="{Binding Ribbons}" x:DataType="vm:RibbonsViewModel"
                                                   Margin="2,6,6,2">
                                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                                <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search ribbons &amp; marks…"/>
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                                                              Content="Owned only" FontSize="12"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="11"
                                                               Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Give all legal" FontSize="12" Command="{Binding GiveAllLegalCommand}"/>
                                                    <Button Content="Remove all" FontSize="12" Command="{Binding RemoveAllCommand}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding SupportsAffixed}" Margin="0,8,0,0">
                                                <TextBlock Classes="fieldLabel" Text="Affixed ribbon (shown in-game)"/>
                                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AffixedChoices}"
                                                          SelectedValue="{Binding AffixedValue, Mode=TwoWay}"
                                                          SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                                                          DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                                            </StackPanel>

                                            <ScrollViewer Margin="0,8,0,0">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RibbonRowViewModel">
                                                            <Grid ColumnDefinitions="*,76" ColumnSpacing="6" Margin="0,1">
                                                                <CheckBox Grid.Column="0" FontSize="12"
                                                                          Content="{Binding DisplayName}"
                                                                          IsChecked="{Binding HasRibbon, Mode=TwoWay}"
                                                                          IsVisible="{Binding IsFlag}"/>
                                                                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                                                           Text="{Binding DisplayName}"
                                                                           IsVisible="{Binding IsCounter}"/>
                                                                <NumericUpDown Grid.Column="1" FontSize="12" ShowButtonSpinner="False"
                                                                               Value="{Binding Count, Mode=TwoWay}" Minimum="0"
                                                                               Maximum="{Binding MaxCount}" FormatString="0"
                                                                               IsVisible="{Binding IsCounter}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Border>
                        </Panel>
                    </Panel>
                    </DockPanel>

                    </Border>
        </Grid>

            <!-- ══════ Save discovery overlay ══════ -->
            <Border IsVisible="{Binding Discovery.IsOpen}" Background="#B0000000">
                <Border Classes="card" Width="720" MaxHeight="560" Padding="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel DataContext="{Binding Discovery}" x:DataType="vm:SaveDiscoveryViewModel">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Saves on this Mac" FontSize="17"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="13" Padding="8,2"
                                    Command="{Binding CloseCommand}"/>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                            <TextBlock FontSize="11" Classes="secondary" TextWrapping="Wrap"
                                       Text="Checks inserted SD cards for the usual console backup layouts, the macOS emulator save folders, and your Downloads, Documents and Desktop."/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Scan again" FontSize="12"
                                        IsEnabled="{Binding !IsScanning}"
                                        Command="{Binding ScanCommand}"/>
                                <Button Content="Stop" FontSize="12"
                                        IsVisible="{Binding IsScanning}"
                                        Command="{Binding CancelCommand}"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" Classes="secondary"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Open Selected Save" Classes="accent"
                                    IsEnabled="{Binding HasResults}"
                                    Command="{Binding OpenSelectedCommand}"/>
                        </StackPanel>

                        <ListBox Classes="plain" ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 DoubleTapped="OnDiscoveredSaveDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:DiscoveredSave">
                                    <Grid ColumnDefinitions="66,*,Auto" ColumnSpacing="10" Margin="0,3">
                                        <Border Grid.Column="0" Classes="chip" Padding="6,2"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Game}" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" FontSize="9" Classes="secondary"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModifiedText}" FontSize="10"
                                                       Classes="secondary" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding Source}" FontSize="9"
                                                       Classes="secondary" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>

        <!-- Drag ghost: follows the pointer while moving a Pokémon between slots -->
        <Canvas IsHitTestVisible="False">
            <Image x:Name="DragGhost" Width="68" Height="56" Opacity="0.85" IsVisible="False"
                   RenderOptions.BitmapInterpolationMode="None"/>
        </Canvas>
    </Panel>
</Window>
