<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Mac.ViewModels"
        xmlns:core="using:PKHeX.Core"
        x:Class="PKHeX.Mac.Views.BagWindow"
        x:DataType="vm:BagViewModel"
        Title="Bag / Items"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <!-- Footer buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancelClicked"/>
            <Button Content="Apply" Classes="accent" Click="OnApplyClicked"/>
        </StackPanel>

        <!-- Item picker for the selected row -->
        <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="Change selected slot to:" FontSize="11" Opacity="0.55"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ItemPickerChoices}"
                              SelectedValue="{Binding PickerValue, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Value, x:DataType=core:ComboItem}"
                              DisplayMemberBinding="{Binding Text, x:DataType=core:ComboItem}"/>
                    <Button Grid.Column="1" Content="Set" Command="{Binding SetSelectedItemCommand}"/>
                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSelectedItemCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
            <!-- Pouch list -->
            <ListBox Grid.Column="0" ItemsSource="{Binding PouchNames}"
                     SelectedIndex="{Binding SelectedPouchIndex, Mode=TwoWay}"/>

            <!-- Items in pouch -->
            <ListBox Grid.Column="1" ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BagItemRowViewModel">
                        <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding ItemName}" FontSize="13" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding Count, Mode=TwoWay}"
                                           Minimum="0" Maximum="9999" FormatString="0" Increment="1" FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
