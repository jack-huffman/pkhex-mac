<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Mac.ViewModels"
             xmlns:core="using:PKHeX.Core"
             xmlns:ctrl="using:PKHeX.Mac.Controls"
             x:Class="PKHeX.Mac.Views.Panels.FlagsPanel"
             x:DataType="vm:MainWindowViewModel">

    <Border Classes="card" IsVisible="{Binding IsFlagsView}" Margin="18,14,18,14">
        <TabControl SelectedIndex="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FlagsTab, Mode=TwoWay}" Padding="0,10,0,0">

            <!-- Gen 2-5 style flat event flag array -->
            <TabItem Header="Event Flags">
                <DockPanel DataContext="{Binding EventFlags}" x:DataType="vm:EventFlagsViewModel"
                           Margin="2,8,2,2">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="{StaticResource FontBody}"
                               Classes="secondary" Margin="0,0,0,10"/>

                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                            Padding="16" Background="{DynamicResource SurfaceMutedBrush}">
                        <TextBlock Text="{Binding UnsupportedNote}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                   Classes="secondary"/>
                    </Border>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12"
                          Margin="0,0,0,12" IsVisible="{Binding SupportsFlags}">
                        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Search by flag number…"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding SetOnly, Mode=TwoWay}"
                                  Content="Set only" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Clear visible" FontSize="{StaticResource FontBody}"
                                Command="{Binding ClearVisibleCommand}"/>
                    </Grid>

                    <ListBox Classes="plain" ItemsSource="{Binding Flags}"
                             IsVisible="{Binding SupportsFlags}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventFlagRowViewModel">
                                <CheckBox Content="{Binding Label}" FontSize="{StaticResource FontBody}" Width="130"
                                          IsChecked="{Binding Value, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Gen 8/9 SCBlock structure -->
            <TabItem Header="Save Blocks">
                <DockPanel DataContext="{Binding SaveBlocks}" x:DataType="vm:SaveBlocksViewModel"
                           Margin="2,8,2,2">
                    <Border DockPanel.Dock="Top" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                            Background="{DynamicResource IllegalBgBrush}"
                            IsVisible="{Binding IsSupported}">
                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource IllegalFgBrush}"
                                   Text="Raw save data — nothing here is validated. These blocks replaced event flags in Gen 8/9; changing one can corrupt progress or trip anti-cheat. Your save is backed up automatically on export, but only edit blocks you understand."/>
                    </Border>

                    <Border DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}" CornerRadius="10"
                            Padding="16" Background="{DynamicResource SurfaceMutedBrush}">
                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Classes="secondary"
                                   Text="This save format does not use SCBlocks. Generations 8 and 9 (Sword/Shield, BDSP, Legends, Scarlet/Violet) do."/>
                    </Border>

                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10"
                                IsVisible="{Binding IsSupported}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                                     PlaceholderText="Search block name or hex key (e.g. KCurrentBox, WEVT_)…"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding NamedOnly, Mode=TwoWay}"
                                      Content="Known names only" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" IsChecked="{Binding EditableOnly, Mode=TwoWay}"
                                      Content="Editable only" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="Reset" FontSize="{StaticResource FontBody}"
                                    Command="{Binding ClearFiltersCommand}"/>
                        </Grid>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontSize="{StaticResource FontBody}"
                                       Classes="secondary"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CapNotice}" FontSize="{StaticResource FontBody}"
                                       Classes="secondary" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="12" Margin="0,10,0,0"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            IsVisible="{Binding IsSupported}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="Back up or restore the selected block"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Export block…" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Click="OnExportBlockClicked"/>
                                <Button Content="Import block…" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Click="OnImportBlockClicked"/>
                                <TextBlock Text="{Binding SelectedName}" FontSize="{StaticResource FontMicro}"
                                           Classes="secondary" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IoResult}" FontSize="{StaticResource FontMicro}" Classes="secondary"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ListBox Classes="plain" ItemsSource="{Binding Rows}" IsVisible="{Binding IsSupported}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScBlockRowViewModel">
                                <Grid ColumnDefinitions="*,86,72,150" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontBody}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Error}" Classes="error"
                                                   IsVisible="{Binding HasError}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding KeyText}" FontSize="{StaticResource FontMicro}"
                                               FontFamily="Menlo, monospace" Classes="secondary"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="{StaticResource FontMicro}"
                                               Classes="secondary" VerticalAlignment="Center"/>

                                    <CheckBox Grid.Column="3" Content="Set" FontSize="{StaticResource FontBody}"
                                              IsVisible="{Binding IsBoolean}"
                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="3" FontSize="{StaticResource FontBody}" Height="24" Padding="6,2"
                                             IsVisible="{Binding IsScalar}"
                                             Text="{Binding TextValue, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding OpaqueText}" FontSize="{StaticResource FontMicro}"
                                               Classes="secondary" VerticalAlignment="Center"
                                               IsVisible="{Binding IsOpaque}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Border>

</UserControl>
