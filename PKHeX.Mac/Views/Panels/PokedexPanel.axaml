<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Mac.ViewModels"
             xmlns:ctrl="using:PKHeX.Mac.Controls"
             x:Class="PKHeX.Mac.Views.Panels.PokedexPanel"
             x:DataType="vm:MainWindowViewModel">

    <Border Classes="card" Margin="18,14,18,14">
        <DockPanel DataContext="{Binding Dex}" x:DataType="vm:PokedexViewModel">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="Pokédex" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="{StaticResource FontBody}"
                           Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !IsSupported}"
                       Text="This save format does not expose an editable Pokédex."
                       Classes="fieldLabel"/>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" Margin="0,0,0,12" IsVisible="{Binding IsSupported}">
                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search by name or number…"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding MissingOnly, Mode=TwoWay}"
                          Content="Missing only" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding ShinyToo, Mode=TwoWay}"
                          Content="Include shiny" VerticalAlignment="Center"
                          ToolTip.Tip="Also register the shiny form when marking an entry caught"/>
                <Button Grid.Column="3" Content="Register owned" FontSize="{StaticResource FontBody}"
                        ToolTip.Tip="Mark every species currently in your boxes and party as caught"
                        Command="{Binding RegisterOwnedCommand}"/>
                <Button Grid.Column="4" Content="Complete dex" FontSize="{StaticResource FontBody}"
                        Command="{Binding CompleteDexCommand}"/>
                <Button Grid.Column="5" Content="Clear all" FontSize="{StaticResource FontBody}"
                        Command="{Binding ClearDexCommand}"/>
            </Grid>

            <Grid ColumnDefinitions="*,420" ColumnSpacing="16" IsVisible="{Binding IsSupported}">
            <!-- ListBox virtualizes; rows stay a fixed height so scrolling is stable -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DexRowViewModel">
                        <Grid ColumnDefinitions="62,44,*,70,50,80" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontSize="{StaticResource FontBody}"
                                       Classes="secondary" VerticalAlignment="Center"
                                       FontFamily="Menlo, monospace"/>
                            <Image Grid.Column="1" Source="{Binding Sprite}" Width="40" Height="34"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{StaticResource FontBody}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Seen" FontSize="{StaticResource FontBody}" Classes="secondary"
                                       VerticalAlignment="Center" IsVisible="{Binding Seen}"/>
                            <CheckBox Grid.Column="4" Content="★" FontSize="{StaticResource FontBody}"
                                      ToolTip.Tip="Shiny registered"
                                      IsVisible="{Binding SupportsDetail}"
                                      IsChecked="{Binding ShinySeen, Mode=TwoWay}"/>
                            <CheckBox Grid.Column="5" Content="Caught" FontSize="{StaticResource FontBody}"
                                      IsChecked="{Binding Caught, Mode=TwoWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail pane: fixed position, so selecting never disturbs the list -->
            <Border Grid.Column="1" Classes="card" Padding="16" VerticalAlignment="Stretch">
                <Panel>
                    <!-- '!' does not null-check an object binding; use the converter -->
                    <StackPanel VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNull}}">
                        <ctrl:PokeBallIcon Width="36" Height="36" HorizontalAlignment="Center"
                                   IconBrush="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Select a species to see everything the dex records for it"
                                   FontSize="{StaticResource FontBody}" Classes="secondary" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel DataContext="{Binding SelectedRow}" x:DataType="vm:DexRowViewModel"
                                    Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Image Source="{Binding Sprite}" Width="56" Height="48"
                                       RenderOptions.BitmapInterpolationMode="None"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontTitle}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding NumberText}" FontSize="{StaticResource FontBody}"
                                               Classes="secondary" FontFamily="Menlo, monospace"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding DetailNote}" FontSize="{StaticResource FontMicro}" Classes="secondary"
                                       TextWrapping="Wrap"/>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="FORMS" Margin="0"/>
                                <ItemsControl ItemsSource="{Binding Forms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DexFormRowViewModel">
                                            <Grid ColumnDefinitions="*,74,92" ColumnSpacing="8" Margin="0,1">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{StaticResource FontBody}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <CheckBox Grid.Column="1" Content="Seen" FontSize="{StaticResource FontBody}"
                                                          IsChecked="{Binding Seen, Mode=TwoWay}"/>
                                                <CheckBox Grid.Column="2" Content="Obtained" FontSize="{StaticResource FontBody}"
                                                          IsChecked="{Binding Obtained, Mode=TwoWay}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="GENDERS SEEN" Margin="0"/>
                                <ItemsControl ItemsSource="{Binding Genders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DexFlagViewModel">
                                            <CheckBox Content="{Binding Label}" FontSize="{StaticResource FontBody}"
                                                      IsChecked="{Binding Value, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasLanguages}">
                                <TextBlock Classes="sectionTitle" Text="LANGUAGES OBTAINED" Margin="0"/>
                                <ItemsControl ItemsSource="{Binding Languages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DexFlagViewModel">
                                            <CheckBox Content="{Binding Label}" FontSize="{StaticResource FontBody}"
                                                      Margin="0,0,14,2"
                                                      IsChecked="{Binding Value, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
