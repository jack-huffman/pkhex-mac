<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PKHeX.Mac.Controls.MoveCategoryIcon"
             Width="30" Height="19">
    <!-- The three damage-category badges, drawn as vectors so they stay sharp
         at any size and need no bundled bitmaps. -->
    <Panel>

        <!-- Physical: yellow starburst on red -->
        <Border x:Name="PhysicalIcon" IsVisible="False"
                CornerRadius="4" Background="#E4392F" BorderBrush="#9E1F17" BorderThickness="1.5">
            <Path Margin="2,1" Stretch="Uniform" Fill="#FFDE2E"
                  Data="M12,0 L14.6,7.2 L21,3.5 L17.4,9.9 L24,12 L17.4,14.1 L21,20.5 L14.6,16.8 L12,24
                        L9.4,16.8 L3,20.5 L6.6,14.1 L0,12 L6.6,9.9 L3,3.5 L9.4,7.2 Z"/>
        </Border>

        <!-- Special: concentric rings on blue -->
        <Border x:Name="SpecialIcon" IsVisible="False"
                CornerRadius="4" Background="#3A5DC4" BorderBrush="#1E3A8F" BorderThickness="1.5">
            <Panel Margin="2,1">
                <Ellipse Fill="#8FE9DC" Width="22" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Fill="#3A5DC4" Width="14" Height="7.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Fill="#8FE9DC" Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
        </Border>

        <!-- Status: pale swirl on grey -->
        <Border x:Name="StatusIcon" IsVisible="False"
                CornerRadius="4" Background="#7E7A76" BorderBrush="#565250" BorderThickness="1.5">
            <Panel Margin="2,1">
                <Ellipse Fill="#EDEDED" Width="22" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path Fill="#8A8886" Stretch="Uniform" Width="13" Height="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M20,3 C14,-1 4,0 3,4 C2,7 9,8 13,9 C16,9.7 15,11 12,11
                            C9,11 6,10 5,9 C7,12 13,13 17,12 C21,11 21,8 16,6.7
                            C12,5.7 7,5.4 8,4 C9,2.8 15,2.6 20,3 Z"/>
            </Panel>
        </Border>
    </Panel>
</UserControl>
