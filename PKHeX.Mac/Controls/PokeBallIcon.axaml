<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:PKHeX.Mac.Controls"
             x:Class="PKHeX.Mac.Controls.PokeBallIcon"
             x:Name="Root">
    <!-- Pure outline Poké Ball: shell ring, a band running from the shell into the
         centre button on both sides, and a hollow button. Everything is stroked in
         one colour with nothing filled, so it sits correctly on any background.
         The band overlaps both rings slightly, which is invisible in a single
         colour and guarantees no hairline gaps at any render size. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">

            <!-- Shell -->
            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="84" Height="84"
                     Stroke="{Binding #Root.Stroke}" StrokeThickness="7"/>

            <!-- Band, shell to button, both sides -->
            <Rectangle Canvas.Left="8" Canvas.Top="46.5" Width="32" Height="7"
                       Fill="{Binding #Root.Stroke}"/>
            <Rectangle Canvas.Left="60" Canvas.Top="46.5" Width="32" Height="7"
                       Fill="{Binding #Root.Stroke}"/>

            <!-- Button -->
            <Ellipse Canvas.Left="41.5" Canvas.Top="41.5" Width="17" Height="17"
                     Stroke="{Binding #Root.Stroke}" StrokeThickness="7"/>
        </Canvas>
    </Viewbox>
</UserControl>
